SELECT
      rd.CODE
    , rd.NAME
    , rd.EXTERNAL_CODE
    , rd.IS_ACTIVE
    , COUNT(e.OBJECT_ID) AS entry_codes_using
FROM REFERENCE_DATA AS rd
LEFT JOIN ENTRY_CODE AS e
       ON e.FRK_ENTRY_SUB_CAT = rd.CODE
      AND e.FSK_ENTRY_SUB_CAT = 166
WHERE rd.SUBCLASS = 166
GROUP BY
      rd.CODE
    , rd.NAME
    , rd.EXTERNAL_CODE
    , rd.IS_ACTIVE
ORDER BY
      rd.CODE;



