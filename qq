SELECT
    p.IDENTIFIER        AS BROK_BK,
    COALESCE(n.NAME, p.CURR_NAME) AS BROK_NAME,
    a.OBJECT_ID         AS ADDRESS_OBJECT_ID,
    a.IS_MAIN_ADDR,
    a.IS_HOME_ADDR,
    a.IS_ACTIVE,
    a.SUBCLASS          AS ADDRESS_SUBCLASS,
    a.FRK_OFFICE_TYPE,
    a.ADDRESS_IDENTIFIER,
    a.ADDR_LINE_1,
    a.ADDR_LINE_2,
    a.ADDR_LINE_3,
    a.CITY_NAME
FROM PARTY AS p
INNER JOIN BUS_PARTNER_CAT AS bpc
    ON bpc.FK_PARTNER = p.OBJECT_ID
   AND bpc.FSK_CATEGORY = 23
   AND bpc.FRK_CATEGORY IN ('B', 'BOUT')
LEFT JOIN ORGANISATION_NAME AS n
    ON n.FK_ORGANISATION = p.OBJECT_ID
INNER JOIN ADDRESS AS a
    ON a.FK_PARTY = p.OBJECT_ID
WHERE p.SUBCLASS = 4
  AND p.IDENTIFIER IN (
        SELECT p2.IDENTIFIER
        FROM PARTY AS p2
        INNER JOIN BUS_PARTNER_CAT AS bpc2
            ON bpc2.FK_PARTNER = p2.OBJECT_ID
           AND bpc2.FSK_CATEGORY = 23
           AND bpc2.FRK_CATEGORY IN ('B', 'BOUT')
        INNER JOIN ADDRESS AS a2
            ON a2.FK_PARTY = p2.OBJECT_ID
        WHERE p2.SUBCLASS = 4
        GROUP BY p2.IDENTIFIER
        HAVING COUNT(*) > 1
  )
ORDER BY p.IDENTIFIER, a.IS_HOME_ADDR DESC, a.IS_MAIN_ADDR DESC, a.OBJECT_ID;
