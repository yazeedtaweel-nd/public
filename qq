SELECT TOP (100)
    /* Policy keys */
    b.IDENTIFIER                         AS business_id,
    ip.BUS_INS_PER_ID                    AS insured_period_id,
    ip.UNDERWR_YEAR                      AS uw_year,
    ip.OBJECT_ID                         AS insured_period_oid,
    b.OBJECT_ID                          AS business_oid,

    /* Dimensions → CTRY / CRZ / PRL */
    la.ISO_ALPHA_2                       AS country_iso2,
    la.CODE                              AS country_code,
    la.NAME                              AS country_name,
    rz.CODE                              AS risk_zone_code,      -- CRZ_BK candidate
    rz.NAME                              AS risk_zone_name,
    peril_rd.CODE                        AS peril_code,          -- PRL BK candidate
    peril_rd.NAME                        AS peril_name,
    peril_rd.SUBCLASS                    AS peril_ref_subclass,  -- expect 44

    /* Currencies */
    c.FK_CURRENCY                        AS orig_ccy,            -- PAG_ORIGINAL_CCY
    b.FK_FUNCTIONAL_CCY                  AS func_ccy1,           -- base candidate
    b.FK_FUNCTIONAL_CCY2                 AS func_ccy2,           -- base candidate

    /* Amount candidates for PAG_AMOUNT_ORIGINAL */
    c.OUR_EXPOSURE                       AS our_exposure,
    c.EXPOSURE                           AS total_exposure,
    c.CEDENT_EXPOSURE                    AS cedent_exposure,
    c.OUR_GROSS_LIAB                     AS our_gross_liab,
    c.GROSS_LIABILITY                    AS gross_liability,
    d.LIMIT_AMOUNT                       AS peril_limit_amount,
    d.SUBCLASS                           AS peril_detl_subclass,

    /* PML */
    iper.PML_FACTOR                      AS pml_factor,          -- PAG_PML_PERCENT
    CASE
        WHEN c.OUR_EXPOSURE IS NOT NULL AND iper.PML_FACTOR IS NOT NULL
        THEN c.OUR_EXPOSURE * iper.PML_FACTOR / 100.0
    END                                  AS pml_amt_from_our_exp_div100,
    CASE
        WHEN c.OUR_EXPOSURE IS NOT NULL AND iper.PML_FACTOR IS NOT NULL
        THEN c.OUR_EXPOSURE * iper.PML_FACTOR
    END                                  AS pml_amt_from_our_exp_raw,

    /* Policy-level annual aggregate (DIM_POLICY.PAG_AMOUNT path) — same on every peril row if present */
    lim.AMOUNT                           AS ann_agg_limit_amount,
    lpc.FK_MAIN_CURRENCY                 AS ann_agg_main_ccy,

    /* Technical */
    c.OBJECT_ID                          AS cession_oid,
    c.SUBCLASS                           AS cession_subclass,
    iper.OBJECT_ID                       AS ins_peril_oid,
    soc.OBJECT_ID                        AS soc_oid
FROM dbo.CESSION c
INNER JOIN dbo.INS_PERIL iper
    ON iper.OBJECT_ID = c.FK_INS_PERIL
LEFT JOIN dbo.RISK_ZONE rz
    ON rz.OBJECT_ID = iper.FK_RISKZONE
LEFT JOIN dbo.LEGAL_AREA la
    ON la.OBJECT_ID = rz.FK_COUNTRY
LEFT JOIN dbo.REFERENCE_DATA peril_rd
    ON peril_rd.OBJECT_ID = iper.FRK_PERIL_TYPE   -- if this fails, try CODE+SUBCLASS join below
LEFT JOIN dbo.CESSION_PERIL_DETL d
    ON d.FK_CESSION = c.OBJECT_ID
LEFT JOIN dbo.SCOPE_OF_COVER soc
    ON soc.OBJECT_ID = c.FK_SOC
LEFT JOIN dbo.LIFE_CYCLE_PHASE lcp
    ON lcp.OBJECT_ID = soc.FK_LIFECYCLEP
LEFT JOIN dbo.INSURED_PERIOD ip
    ON ip.OBJECT_ID = lcp.FK_INS_PRD
LEFT JOIN dbo.BUSINESS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
OUTER APPLY (
    SELECT TOP (1) lpc0.*
    FROM dbo.LPC_LIM_PREM_COND lpc0
    WHERE lpc0.FK_INSURED_PERIOD = ip.OBJECT_ID
      AND lpc0.FK_ANN_AGG_LIMIT IS NOT NULL
      AND (lpc0.IS_CURRENT_OF_IP = 'Y' OR lpc0.IS_CURRENT_OF_IP IS NULL)
    ORDER BY lpc0.OBJECT_ID
) lpc
LEFT JOIN dbo.LPC_LIMIT lim
    ON lim.OBJECT_ID = lpc.FK_ANN_AGG_LIMIT
WHERE c.FK_INS_PERIL IS NOT NULL
  -- AND c.SUBCLASS = 3   -- enable after Query 0 confirms
ORDER BY b.IDENTIFIER, ip.UNDERWR_YEAR, rz.CODE, peril_rd.CODE;
