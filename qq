-- Combined query
SELECT
    'LEDGER_BALANCE_SUBCLASS' AS RESULT_TYPE,
    CAST(b.SUBCLASS AS VARCHAR(50)) AS CODE,
    NULL AS NAME,
    NULL AS EXTERNAL_CODE,
    COUNT(*) AS ROW_CNT
FROM dbo.AC_LEDGER_BALANCE AS b
WHERE b.FK_WORKSHEET IS NOT NULL
GROUP BY b.SUBCLASS

UNION ALL

SELECT
    'WORKSHEET_TYPE' AS RESULT_TYPE,
    CAST(CODE AS VARCHAR(50)) AS CODE,
    NAME,
    EXTERNAL_CODE,
    NULL AS ROW_CNT
FROM dbo.REFERENCE_DATA
WHERE SUBCLASS = 167

UNION ALL

SELECT
    'LEVEL_OF_BUSINESS_IO' AS RESULT_TYPE,
    CAST(CODE AS VARCHAR(50)) AS CODE,
    NAME,
    EXTERNAL_CODE,
    NULL AS ROW_CNT
FROM dbo.REFERENCE_DATA
WHERE SUBCLASS = 45

ORDER BY RESULT_TYPE, CODE;



