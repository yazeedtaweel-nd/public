SELECT
    distinct r.REFERENCE_ID AS CLGRP_BK,
    c.SHORT_DESCR AS CLGRP_LOSS_DETAILS,
    c.LOSS_NAME AS CLGRP_DESCRIPTION,
    c.LOSS_START_DT AS CLGRP_LOSS_DATE_FROM,
    c.LOSS_END_DT AS CLGRP_LOSS_DATE_TO,
    c.FX_DATE AS CLGRP_XL_DATE,
    CASE c.FRK_RISK_EVNT_IND
        WHEN 'E' THEN 'Y'
        WHEN 'R' THEN 'N'
    END AS CLGRP_MARKET_INDICATOR,
    CASE c.FRK_RISK_EVNT_IND
        WHEN 'E' THEN r.REFERENCE_ID
        WHEN 'R' THEN c.FRK_ADDIT_CODE
    END AS CLGRP_MARKET_CODE
FROM SICS.CLAIMS AS c
LEFT JOIN SICS.CL_HLOSS_REF AS r
    ON r.FK_PARENT = c.OBJECT_ID
WHERE c.SUBCLASS = 6
ORDER BY r.REFERENCE_ID;
