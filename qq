SELECT
    c.CLAIM_IDENTIFIER                              AS CLA_BK,
    c.LOSS_NAME                                     AS CLA_DESC,
    c.FRK_CLM_CLASSFCTN                             AS CLA_SOURCE,
    CONVERT(NVARCHAR(50),
        ISNULL(
            CASE
                WHEN ISNULL(hl.IS_MARKET_LOSS, 'N') = 'Y' THEN 'CAT'
                WHEN c.FRK_CLM_CLASSFCTN = 'ACC'          THEN 'ATT'
            END, 'ATT')
    )                                               AS CLA_TYPE,
    ISNULL(hl.CLAIM_IDENTIFIER, c.CLAIM_IDENTIFIER) AS CLGRP_BK,
    CASE WHEN c.FK_HEADLINE_LOSS IS NULL THEN 'N' ELSE 'Y' END AS IS_CLAIM_GROUP,
    ISNULL(hl.IS_MARKET_LOSS, 'N')                  AS CAT_IND,
    CONVERT(BIT, 0)                                 AS CLA_IS_MOVEMENT
FROM SICS.CLAIMS c
INNER JOIN SICS.SOC_TO_CLAIM_REL scr
    ON scr.FK_CLAIM = c.OBJECT_ID
LEFT JOIN SICS.CLAIMS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
   AND hl.SUBCLASS = 6
