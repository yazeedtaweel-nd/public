SELECT
    COALESCE(ip.I_PERIOD_FORMER_ID, ip.BUS_INS_PER_ID) AS POLICY_ID,
    cc.FRK_CLM_BAS                                     AS LOSB_BK,      -- lookup DIM_LOSS_BASIS on this
    rd.NAME                                            AS LOSB_NAME
FROM sics.BUSINESS AS b
INNER JOIN sics.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
INNER JOIN sics.BUS_STRUCT_REP AS bsr
    ON bsr.FK_INS_PERIOD = ip.OBJECT_ID
LEFT JOIN sics.CLAIM_COND AS cc
    ON cc.OBJECT_ID = bsr.FK_PC_CLAIM
LEFT JOIN sics.REFERENCE_DATA AS rd
    ON  rd.CODE     = cc.FRK_CLM_BAS
    AND rd.SUBCLASS = 95          -- or: rd.SUBCLASS = cc.FSK_CLM_BAS
;
