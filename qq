SELECT
    c.OBJECT_ID                         AS sics_object_id,      -- SICS UUID, not CTRY_SRGT
    c.ISO_ALPHA_2                       AS iso_alpha_2,         -- CTRY_COUNTRY_CODE candidate
    c.ISO_ALPHA_3                       AS iso_alpha_3,
    c.CODE                              AS country_code,        -- CTRY_COUNTRY_CODE candidate
    c.UNIQUE_CODE                       AS unique_code,
    c.ALTERNATE_ID                      AS alternate_id,
    c.SHORT_NAME                        AS short_name,
    c.NAME                              AS country_name,        -- CTRY_COUNTRY_NAME
    c.IS_ACTIVE                         AS is_active
FROM dbo.LEGAL_AREA AS c
WHERE c.SUBCLASS = 1                    -- SicsCountry only
ORDER BY COALESCE(c.ISO_ALPHA_2, c.CODE), c.NAME;
