SELECT
    ip.I_PERIOD_FORMER_ID,
    ip.BUS_INS_PER_ID,
    b.IDENTIFIER            AS POLICY_CONTRACT_NUMBER,
    b.FK_FUNCTIONAL_CCY     AS POLICY_CHOSEN_CURRENCY,   -- FC1, already the ISO code
    fc1.DESCRIPTION         AS POLICY_CHOSEN_CURRENCY_NAME,
    b.FK_FUNCTIONAL_CCY2    AS FUNCTIONAL_CCY2,          -- FC2, already the ISO code
    fc2.DESCRIPTION         AS FUNCTIONAL_CCY2_NAME
FROM dbo.BUSINESS AS b
INNER JOIN dbo.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
LEFT JOIN dbo.CNU_CURRENCY AS fc1
    ON fc1.ISO_ALPHA = b.FK_FUNCTIONAL_CCY
LEFT JOIN dbo.CNU_CURRENCY AS fc2
    ON fc2.ISO_ALPHA = b.FK_FUNCTIONAL_CCY2
WHERE b.IDENTIFIER = :contract_number;
