SELECT
    c.CLAIM_IDENTIFIER,
    cs.SEQ_NUMBER,
    cs.CHANGE_DATE,
    cs.IS_CURRENT,
    st.CODE  AS STATUS_CODE,      -- typically O / C
    st.NAME  AS STATUS_NAME,      -- Open / Closed
    sst.CODE AS SUBSTATUS_CODE,
    sst.NAME AS SUBSTATUS_NAME    -- e.g. Reopened if configured
FROM CLAIM_STATUS cs
JOIN SOC_TO_CLAIM_REL rel
  ON rel.OBJECT_ID = cs.FK_CLAIM
JOIN CLAIMS c
  ON c.OBJECT_ID = rel.FK_CLAIM
LEFT JOIN REFERENCE_DATA st
  ON st.CODE = cs.FRK_STATUS
 AND st.SUBCLASS = 517
LEFT JOIN REFERENCE_DATA sst
  ON sst.CODE = cs.FRK_SUB_STATUS
 AND sst.SUBCLASS = 518
WHERE c.CLAIM_IDENTIFIER = N'<claim id>'
ORDER BY cs.SEQ_NUMBER;
