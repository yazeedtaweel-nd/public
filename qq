-- Allowed 534 -> 535 value pairs (if this table exists / is populated)
SELECT
    occ.CODE  AS OCC_BK,
    occ.NAME  AS OCC_NAME,
    cls.CODE  AS MAJOR_CLASS_BK,
    cls.NAME  AS MAJOR_CLASS_NAME,
    COUNT(*)  AS CNT
FROM dbo.REFERENCE_DATA AS occ
JOIN dbo.REFERENCE_DATA AS cls
  ON 1 = 1   -- replace with real dependency-values join if you have one
WHERE occ.SUBCLASS = 534
  AND cls.SUBCLASS = 535
GROUP BY occ.CODE, occ.NAME, cls.CODE, cls.NAME;


SELECT CODE, NAME, IS_ACTIVE
FROM dbo.REFERENCE_DATA
WHERE SUBCLASS = 535
ORDER BY CODE;
