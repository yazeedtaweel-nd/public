SELECT
    COALESCE(NULLIF(LTRIM(RTRIM(rd.EXTERNAL_CODE)), N''), rd.CODE) AS LOB_BK,
    rd.NAME AS LOB_NAME,
    CAST(N'' AS nvarchar(250)) AS LOB_SHORT_NAME,
    CAST(N'' AS nvarchar(250)) AS LOB_SHORT_NAME_NEW,
    COALESCE(NULLIF(LTRIM(RTRIM(spl.EXTERNAL_CODE)), N''), spl.CODE) AS LOB_SPL_BK,
    spl.NAME AS LOB_SPL_NAME,
    rd.EXTERNAL_CODE,
    rd.IS_ACTIVE,
    rd.SUBCLASS
FROM SICS.REFERENCE_DATA AS rd
LEFT JOIN SICS.REF_TO_REF AS link
       ON link.FSK_CHILD  = 3
      AND link.FRK_CHILD  = rd.CODE
      AND link.FSK_PARENT = 19
LEFT JOIN SICS.REFERENCE_DATA AS spl
       ON spl.SUBCLASS = 19
      AND spl.CODE     = link.FRK_PARENT
WHERE rd.SUBCLASS = 3
ORDER BY COALESCE(NULLIF(LTRIM(RTRIM(rd.EXTERNAL_CODE)), N''), rd.CODE);
