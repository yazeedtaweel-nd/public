
DECLARE @BusinessId nvarchar(50) = N'PUT_CONTRACT_ID_HERE';

WITH periods AS (
    SELECT
        b.IDENTIFIER,
        ip.OBJECT_ID AS IP_OID,
        ip.IS_LATEST,
        ip.I_PERIOD_FORMER_ID,
        ip.BUS_INS_PER_ID,
        CAST(
            COALESCE(
                NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
                NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N''),
                ip.OBJECT_ID
            ) AS nvarchar(50)
        ) AS POLICY_BK,
        MIN(bsr.INSRD_PERIOD_START) AS PERIOD_START,
        MAX(bsr.INSRD_PERIOD_END) AS PERIOD_END
    FROM SICS.BUSINESS AS b
    INNER JOIN SICS.INSURED_PERIOD AS ip
        ON ip.FK_BUSINESS = b.OBJECT_ID
    INNER JOIN SICS.BUS_STRUCT_REP AS bsr
        ON bsr.FK_INS_PERIOD = ip.OBJECT_ID
    WHERE b.IDENTIFIER = @BusinessId
    GROUP BY
        b.IDENTIFIER,
        ip.OBJECT_ID,
        ip.IS_LATEST,
        ip.I_PERIOD_FORMER_ID,
        ip.BUS_INS_PER_ID
)
SELECT
    IDENTIFIER,
    IP_OID,
    I_PERIOD_FORMER_ID,
    BUS_INS_PER_ID,
    POLICY_BK,
    PERIOD_START,
    PERIOD_END,
    IS_LATEST,
    CASE
        WHEN LEAD(IP_OID) OVER (ORDER BY PERIOD_START, IP_OID) IS NOT NULL
        THEN N'Y' ELSE N'N'
    END AS POLICY_IS_RENEWED,
    CASE
        WHEN LAG(IP_OID) OVER (ORDER BY PERIOD_START, IP_OID) IS NOT NULL
        THEN N'Y' ELSE N'N'
    END AS POLICY_IS_RENEWAL,
    LAG(POLICY_BK) OVER (ORDER BY PERIOD_START, IP_OID) AS POLICY_RENEWED_FROM,
    LEAD(POLICY_BK) OVER (ORDER BY PERIOD_START, IP_OID) AS POLICY_RENEWED_BY
FROM periods
ORDER BY PERIOD_START, IP_OID;
