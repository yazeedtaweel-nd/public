SELECT
    rd.CODE,
    rd.NAME,
    rd.EXTERNAL_CODE,
    rd.IS_ACTIVE,
    rd.IS_STATIC,
    rd.IS_USER_DEFINED
FROM REFERENCE_DATA rd
WHERE rd.SUBCLASS = 90
ORDER BY rd.IS_ACTIVE DESC, rd.CODE;



SELECT
    b.IDENTIFIER            AS BUSINESS_ID,
    b.IDENTIFIER_CURR       AS QUOTE_ID,
    b.FRK_BASICSTAT_CURR    AS BASIC_CODE,
    rb.NAME                 AS BASIC_NAME,
    b.FRK_LC_STAT_CURR      AS LC_CODE,
    rl.NAME                 AS LC_NAME,
    s.IDENTIFIER            AS LCS_QUOTE_IDENTIFIER,
    s.CHANGE_DATE,
    s.FRK_AGRLCYCSUBST      AS SUBSTAT_CODE,
    rs.NAME                 AS SUBSTAT_NAME,
    s.FRK_QUOTE_REASON      AS QUOTE_REASON_CODE,
    rq.NAME                 AS QUOTE_REASON_NAME
FROM BUS_STRUCT_REP b
LEFT JOIN LIFE_CYCLE_STATUS s
       ON s.OBJECT_ID = b.FK_LC_STATUS_CURR
LEFT JOIN REFERENCE_DATA rb
       ON rb.SUBCLASS = 89 AND rb.CODE = b.FRK_BASICSTAT_CURR
LEFT JOIN REFERENCE_DATA rl
       ON rl.SUBCLASS = 90 AND rl.CODE = b.FRK_LC_STAT_CURR
LEFT JOIN REFERENCE_DATA rs
       ON rs.SUBCLASS = 91 AND rs.CODE = s.FRK_AGRLCYCSUBST
LEFT JOIN REFERENCE_DATA rq
       ON rq.SUBCLASS = 11 AND rq.CODE = s.FRK_QUOTE_REASON
WHERE b.FRK_LC_STAT_CURR IS NOT NULL
ORDER BY b.FRK_LC_STAT_CURR, b.IDENTIFIER;





SELECT
    b.FRK_LC_STAT_CURR AS LC_CODE,
    rl.NAME            AS LC_NAME,
    b.FRK_BASICSTAT_CURR AS BASIC_CODE,
    rb.NAME            AS BASIC_NAME,
    COUNT(*)           AS ROW_CNT
FROM BUS_STRUCT_REP b
LEFT JOIN REFERENCE_DATA rl
       ON rl.SUBCLASS = 90 AND rl.CODE = b.FRK_LC_STAT_CURR
LEFT JOIN REFERENCE_DATA rb
       ON rb.SUBCLASS = 89 AND rb.CODE = b.FRK_BASICSTAT_CURR
WHERE b.FRK_LC_STAT_CURR IS NOT NULL
GROUP BY
    b.FRK_LC_STAT_CURR, rl.NAME,
    b.FRK_BASICSTAT_CURR, rb.NAME
ORDER BY ROW_CNT DESC;
