/* =============================================================================
   SICS source extract for DIM_CLAIM (validation / mapping check)
   Grain: SOC_TO_CLAIM_REL (claim–section). Confirm vs CLAIMS-only grain.
   ============================================================================= */

SELECT TOP (1000)
    /* Keys / identity */
    c.OBJECT_ID                         AS CLAIMS_OBJECT_ID,
    scr.OBJECT_ID                       AS SOC_TO_CLAIM_REL_OBJECT_ID,
    c.CLAIM_IDENTIFIER                  AS CLA_BK,
    COALESCE(c.SHORT_DESCR, c.LOSS_NAME) AS CLA_DESC,

    /* Broker (derived) */
    CASE
        WHEN ip.IS_DIRECT = 'Y' THEN 'DIRECT'
        ELSE brk.IDENTIFIER
    END                                 AS CLA_BROKER,

    /* Source / type candidates */
    c.FRK_CLM_CLASSFCTN                 AS CLA_SOURCE,      -- candidate: ref 528
    cls.NAME                            AS CLA_SOURCE_NAME,
    c.PROD_TYPE                         AS CLA_TYPE,        -- candidate only (ATT?)
    c.FRK_CLAIM_TYPE                    AS SICS_CLAIM_TYPE_527,  -- Individual/Interlocking/Various

    /* Current status / substatus */
    COALESCE(cs.FRK_STATUS, scr.FRK_STATUS_TYPE) AS CLA_STATUS,       -- e.g. OP
    st.NAME                                      AS CLA_STATUS_CODE, -- e.g. OPEN
    cs.FRK_SUB_STATUS                            AS CLA_SUBSTATUS,
    ss.NAME                                      AS CLA_SUBSTATUS_NAME,

    /* Handler */
    u.SHORTNAME                         AS CLA_HANDLER,
    u.USER_ID                           AS CLA_HANDLER_LOGIN,

    /* Alt reference */
    COALESCE(cref.REFERENCE_ID, scr.CL_REF) AS CLA_ALT_REF,

    /* Weak / unconfirmed */
    cs.FRK_SUB_STATUS                   AS CLA_IS_MOVEMENT_CANDIDATE_SUBSTATUS,
    scr.TO_BE_BOOKED                    AS TO_BE_BOOKED_NOT_IS_MOVEMENT,

    /* Dates */
    c.LOSS_START_DT                     AS CLA_LOSS_DATE,
    open_dt.CHANGE_DATE                 AS CLA_OPEN_DATE,
    reopen_dt.CHANGE_DATE               AS CLA_REOPEN_DATE,
    COALESCE(scr.ADVICE_REC_DATE, scr.CLAIM_ADVISED_DT) AS CLA_REPORTED_DATE,
    close_dt.CHANGE_DATE                AS CLA_CLOSE_DATE,
    scr.LAST_UPDATE_DT                  AS CLA_LAST_TRANSACTION,

    /* Policy / group / loss-type natural keys (for DW surrogate lookup) */
    b.IDENTIFIER                        AS POLICY_BK_CANDIDATE,
    soc.IDENTIFIER                      AS SECTION_IDENTIFIER,
    hl.CLAIM_IDENTIFIER                 AS CLGRP_BK_CANDIDATE,  -- via FK_HEADLINE_LOSS
    c.FRK_CAUSE_OF_LOSS                 AS LSTP_BK,             -- ref 523
    loss_type.NAME                      AS LSTP_NAME

FROM dbo.CLAIMS AS c
INNER JOIN dbo.SOC_TO_CLAIM_REL AS scr
    ON scr.FK_CLAIM = c.OBJECT_ID

LEFT JOIN dbo.SCOPE_OF_COVER AS soc
    ON soc.OBJECT_ID = scr.FK_SOC

LEFT JOIN dbo.LIFE_CYCLE_PHASE AS lcp
    ON lcp.OBJECT_ID = soc.FK_LIFECYCLEP
   -- OR: lcp.FK_SCOPE_OF_CVR = soc.OBJECT_ID AND lcp.IS_CURRENT = 'Y'

LEFT JOIN dbo.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = lcp.FK_INS_PRD

LEFT JOIN dbo.BUSINESS AS b
    ON b.OBJECT_ID = ip.FK_BUSINESS

/* Current claim status row */
OUTER APPLY (
    SELECT TOP (1)
        csx.FRK_STATUS,
        csx.FRK_SUB_STATUS,
        csx.CHANGE_DATE,
        csx.IS_CURRENT
    FROM dbo.CLAIM_STATUS AS csx
    WHERE csx.FK_CLAIM = scr.OBJECT_ID
      AND csx.IS_CURRENT = 'Y'
    ORDER BY csx.SEQ_NUMBER DESC, csx.CHANGE_DATE DESC
) AS cs

LEFT JOIN dbo.REFERENCE_DATA AS st
    ON st.CODE = COALESCE(cs.FRK_STATUS, scr.FRK_STATUS_TYPE)
   AND st.SUBCLASS = 517

LEFT JOIN dbo.REFERENCE_DATA AS ss
    ON ss.CODE = cs.FRK_SUB_STATUS
   AND ss.SUBCLASS = 518

LEFT JOIN dbo.REFERENCE_DATA AS cls
    ON cls.CODE = c.FRK_CLM_CLASSFCTN
   AND cls.SUBCLASS = 528

LEFT JOIN dbo.REFERENCE_DATA AS loss_type
    ON loss_type.CODE = c.FRK_CAUSE_OF_LOSS
   AND loss_type.SUBCLASS = 523

LEFT JOIN dbo.CNU_USER AS u
    ON u.OBJECT_ID = c.FK_RES_CL_HDL

LEFT JOIN dbo.CLAIMS AS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS

/* One claim reference (adjust FRK_CLM_REF_TYPE if needed) */
OUTER APPLY (
    SELECT TOP (1) r.REFERENCE_ID, r.FRK_CLM_REF_TYPE
    FROM dbo.CLAIM_REFS AS r
    WHERE r.FK_SOC_REL = scr.OBJECT_ID
    ORDER BY r.OBJECT_ID
) AS cref

/* Broker party on insured period / business — confirm RELSHIP_TYPE code for Broker */
OUTER APPLY (
    SELECT TOP (1) p.IDENTIFIER
    FROM dbo.BUSINESS_PRTNR_REL AS bpr
    INNER JOIN dbo.PARTY AS p
        ON p.OBJECT_ID = bpr.FK_BUS_PARTNER
    WHERE (bpr.FK_INS_PERIOD = ip.OBJECT_ID OR bpr.FK_BUSINESS = b.OBJECT_ID)
      -- AND bpr.FRK_RELSHIP_TYPE = '<Broker code from REFERENCE_DATA SUBCLASS=55>'
      AND p.SUBCLASS = 4
    ORDER BY bpr.OBJECT_ID
) AS brk

/* Status event dates (derived) — confirm codes OP/RO/CL against live ref 517 */
OUTER APPLY (
    SELECT MIN(x.CHANGE_DATE) AS CHANGE_DATE
    FROM dbo.CLAIM_STATUS AS x
    WHERE x.FK_CLAIM = scr.OBJECT_ID
      AND x.FRK_STATUS = 'OP'
) AS open_dt

OUTER APPLY (
    SELECT MAX(x.CHANGE_DATE) AS CHANGE_DATE
    FROM dbo.CLAIM_STATUS AS x
    WHERE x.FK_CLAIM = scr.OBJECT_ID
      AND x.FRK_STATUS = 'RO'
) AS reopen_dt

OUTER APPLY (
    SELECT MAX(x.CHANGE_DATE) AS CHANGE_DATE
    FROM dbo.CLAIM_STATUS AS x
    WHERE x.FK_CLAIM = scr.OBJECT_ID
      AND x.FRK_STATUS = 'CL'
) AS close_dt

ORDER BY c.CLAIM_IDENTIFIER, scr.OBJECT_ID;
