/* ============================================================
   003_seed_claim_package.sql — Claim Package registration

   Seeds audit.ETL_PACKAGE + audit.ETL_PACKAGE_TABLE for the
   Claim Package (DimClaim.dtsx) and its six dimension loads.

   Re-runnable: inserts the package if missing, then MERGE-upserts
   the table rows. Does not touch execution / error history.

   Apply after 001 control DDL and 002 Party seed.
   ============================================================ */

SET NOCOUNT ON;
GO

IF NOT EXISTS (
    SELECT 1
    FROM   audit.ETL_PACKAGE
    WHERE  PACKAGE_NAME = N'CLAIM_PACKAGE'
)
BEGIN
    INSERT INTO audit.ETL_PACKAGE
        (PACKAGE_NAME, PACKAGE_FILE_NAME, EXECUTION_ORDER, IS_ENABLED, DESCRIPTION)
    VALUES
        (N'CLAIM_PACKAGE',
         N'DimClaim.dtsx',
         20,
         1,
         N'Claim package: Loss Type, Claim Type, Claim Group, Claim Status, Claim Substatus, Claim.');
END
ELSE
BEGIN
    UPDATE audit.ETL_PACKAGE
    SET    PACKAGE_FILE_NAME = N'DimClaim.dtsx',
           EXECUTION_ORDER   = 20,
           IS_ENABLED        = 1,
           DESCRIPTION       = N'Claim package: Loss Type, Claim Type, Claim Group, Claim Status, Claim Substatus, Claim.'
    WHERE  PACKAGE_NAME = N'CLAIM_PACKAGE';
END
GO

DECLARE @PackageId INT =
    (SELECT PACKAGE_ID FROM audit.ETL_PACKAGE WHERE PACKAGE_NAME = N'CLAIM_PACKAGE');

IF @PackageId IS NULL
BEGIN
    RAISERROR(N'CLAIM_PACKAGE was not found in audit.ETL_PACKAGE after seed.', 16, 1);
END
ELSE
BEGIN
    ;WITH src AS (
        SELECT *
        FROM (VALUES
            (N'LOSS_TYPE',
             N'SICS.dbo.REFERENCE_DATA',
             N'dbo.DIM_LOSS_TYPE',
             N'REFERENCE_DATA WHERE SUBCLASS = 523 (Cause of Loss).'),
            (N'CLAIM_TYPE',
             N'SICS.dbo.REFERENCE_DATA',
             N'dbo.DIM_CLAIM_TYPE',
             N'REFERENCE_DATA WHERE SUBCLASS = 528 (Claim Classification).'),
            (N'CLAIM_GROUP',
             N'SICS.dbo.CLAIMS',
             N'dbo.DIM_CLAIM_GROUP',
             N'CLAIMS WHERE SUBCLASS = 6 (Headline Loss).'),
            (N'CLAIM_STATUS',
             N'SICS.dbo.REFERENCE_DATA',
             N'dbo.DIM_CLAIM_STATUS',
             N'REFERENCE_DATA WHERE SUBCLASS = 517 (Claim Status).'),
            (N'CLAIM_SUBSTATUS',
             N'SICS.dbo.REFERENCE_DATA',
             N'dbo.DIM_CLAIM_SUBSTATUS',
             N'REFERENCE_DATA WHERE SUBCLASS = 518 (Claim Sub Status).'),
            (N'CLAIM',
             N'SICS.dbo.CLAIMS',
             N'dbo.DIM_CLAIM',
             N'CLAIMS joined to SOC_TO_CLAIM_REL via FK_CLAIM.')
        ) AS v (TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, DESCRIPTION)
    )
    MERGE audit.ETL_PACKAGE_TABLE AS t
    USING src
       ON t.PACKAGE_ID = @PackageId
      AND t.TABLE_NAME = src.TABLE_NAME
    WHEN MATCHED THEN
        UPDATE SET
            SOURCE_OBJECT = src.SOURCE_OBJECT,
            TARGET_OBJECT = src.TARGET_OBJECT,
            DESCRIPTION   = src.DESCRIPTION,
            IS_ENABLED    = 1
    WHEN NOT MATCHED THEN
        INSERT (PACKAGE_ID, TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, IS_ENABLED, DESCRIPTION)
        VALUES (@PackageId, src.TABLE_NAME, src.SOURCE_OBJECT, src.TARGET_OBJECT, 1, src.DESCRIPTION);
END
GO
