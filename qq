SELECT
    -- Identity
    bsr.IDENTIFIER                                              AS SBMS_BK,
    bsr.TITLE                                                   AS SBMS_TITLE,

    -- User
    u.USER_ID                                                   AS SBMS_ENTERED_BY,
    u.SHORTNAME                                                 AS SBMS_UDT_LOGIN,

    -- Take-up
    bsr.IDENTIFIER_PREV                                         AS SBMS_TAKEN_FROM_REF,
    bsr.IDENTIFIER_CURR                                         AS IDENTIFIER_CURR,
    bsr.IDENTIFIER                                              AS SBMS_TAKEN_TO_REF,   -- bound business id

    -- Dates
    bsr.INCEPTION_DATE                                          AS SBMS_INCEPTION_DATE,
    lcs.CHANGE_DATE                                             AS SBMS_ENTRY_DATE,
    CAST(bsr.INSRD_PERIOD_START AS DATE)                        AS SBMS_START_DATE,
    CAST(bsr.INSRD_PERIOD_END   AS DATE)                        AS SBMS_EXPIRY_DATE,

    -- Status (prefer LC for SUBMS_STATUS)
    bsr.FRK_LC_STAT_CURR                                        AS LC_STATUS_CODE,
    rd_lc.NAME                                                  AS SUBMS_STATUS,          -- LC name
    bsr.FRK_BASICSTAT_CURR                                      AS BASIC_STATUS_CODE,
    rd_bs.NAME                                                  AS BASIC_STATUS_NAME,     -- e.g. Definite

    -- Parties (natural keys for dim lookup)
    brk.IDENTIFIER                                              AS BROKER_BK,
    bsr.BROKER_NAME,
    ced.IDENTIFIER                                              AS CEDENT_BK,
    bsr.CEDENT_NAME,
    ins.IDENTIFIER                                              AS INSURED_BK,            -- OIN*
    bsr.INSURED_NAME,

    -- Countries
    bsr.INSURED_COUNTRY                                         AS CTRY_RISK_CODE,        -- e.g. SAU
    bsr.CEDENT_COUNTRY                                          AS CTRY_DOMICILE_CODE,    -- e.g. SAU/ARE
    bsr.BROKER_COUNTRY,

    -- Type of business
    bsr.FRK_TYPE_OF_BUS,
    tob.NAME                                                    AS TYPE_OF_BUS_NAME,
    bsr.LOB_REF_NM,                                             -- note: "Assumed Business" ≠ LOB

    -- EPI / TSI
    lpc.FK_MAIN_CURRENCY                                        AS CURRENCY_FK,
    cur.ISO_ALPHA                                               AS SBMS_EPI_CURRENCY,
    prem.CURRENT_AMOUNT                                         AS SBMS_EPI_AMOUNT_ORIGIN,
    prem.ANNUAL_AMOUNT                                          AS EPI_ANNUAL_AMOUNT,
    prem.INSURED_AMOUNT                                         AS EPI_INSURED_AMOUNT,
    prem.BASE_AMOUNT                                            AS EPI_BASE_AMOUNT_SICS,  -- often NULL
    lim.AMOUNT                                                  AS SBMS_TSI_AMOUNT_ORIGIN,
    lim.IS_UNLIMITED                                            AS TSI_IS_UNLIMITED,

    -- Debug / grain
    bsr.OBJECT_ID                                               AS BUS_STRUCT_REP_OID,
    bsr.IS_CRNT_STATUS,
    bsr.IS_CRNT_BASIC_STAT,
    bsr.IS_CURRENT_LCP,
    bsr.IS_IP_LATEST
FROM SICS.BUS_STRUCT_REP AS bsr
LEFT JOIN SICS.CNU_USER AS u
    ON u.OBJECT_ID = bsr.FK_UNDERW_CURR
LEFT JOIN SICS.LIFE_CYCLE_STATUS AS lcs
    ON lcs.OBJECT_ID = bsr.FK_LC_STATUS_CURR
LEFT JOIN SICS.REFERENCE_DATA AS rd_lc
    ON rd_lc.CODE = bsr.FRK_LC_STAT_CURR
   AND rd_lc.SUBCLASS = 90
LEFT JOIN SICS.REFERENCE_DATA AS rd_bs
    ON rd_bs.CODE = bsr.FRK_BASICSTAT_CURR
   AND rd_bs.SUBCLASS = 89
LEFT JOIN SICS.REFERENCE_DATA AS tob
    ON tob.CODE = bsr.FRK_TYPE_OF_BUS
   AND tob.SUBCLASS = 46
LEFT JOIN SICS.PARTY AS brk
    ON brk.OBJECT_ID = bsr.FK_BROKER
LEFT JOIN SICS.PARTY AS ced
    ON ced.OBJECT_ID = bsr.FK_CEDENT
LEFT JOIN SICS.PARTY AS ins
    ON ins.OBJECT_ID = bsr.FK_INSURED
LEFT JOIN SICS.LPC_LIM_PREM_COND AS lpc
    ON lpc.OBJECT_ID = COALESCE(bsr.FK_PC_LIM_PREM, bsr.FK_PC_PREM)
LEFT JOIN SICS.CNU_CURRENCY AS cur
    ON cur.ISO_ALPHA = lpc.FK_MAIN_CURRENCY
LEFT JOIN SICS.LPC_PREMIUM AS prem
    ON prem.OBJECT_ID = lpc.FK_TOT_PREM
LEFT JOIN SICS.LPC_LIMIT AS lim
    ON lim.OBJECT_ID = lpc.FK_MAIN_LIMIT
WHERE bsr.FRK_TYPE_OF_BUS IN (
    'NONPROPFAC',  -- confirmed live
    'PF', 'NPF', 'PFO', 'NPFO',
    'PAFM', 'PAFW',
    'PPFAC', 'PFOFM'
)
  AND bsr.IS_CRNT_STATUS     = 'Y'   -- required (removes duplicate BK rows)
  AND bsr.IS_CURRENT_LCP     = 'Y'
  AND bsr.IS_IP_LATEST       = 'Y'
ORDER BY bsr.IDENTIFIER;
