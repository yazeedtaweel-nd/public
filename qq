SELECT
    CASE WHEN CRZ_BK LIKE '%9800' OR CRZ_BK LIKE '%9900' THEN 'peril' ELSE 'standard' END AS row_kind,
    CREATED_DATE_SRGT,
    UPDATED_DATE_SRGT,
    COUNT(*) AS cnt
FROM [SaudiRe_Dw].[dbo].[DIM_CRESTA_ZONE]
GROUP BY
    CASE WHEN CRZ_BK LIKE '%9800' OR CRZ_BK LIKE '%9900' THEN 'peril' ELSE 'standard' END,
    CREATED_DATE_SRGT, UPDATED_DATE_SRGT
ORDER BY cnt DESC;
