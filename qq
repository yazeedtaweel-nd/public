SELECT
    c.CLAIM_IDENTIFIER,
    scr.OBJECT_ID AS SOC_CLAIM_OID,
    c.OBJECT_ID   AS CLAIM_OID,
    c.FK_HEADLINE_LOSS
FROM SICS.CLAIMS c
INNER JOIN SICS.SOC_TO_CLAIM_REL scr
    ON scr.FK_CLAIM = c.OBJECT_ID


******
SELECT 'BAL.FK_CLAIM = SOC' AS PATH, COUNT(*) AS ROWS
FROM SICS.AC_LEDGER_BALANCE bal
INNER JOIN SICS.SOC_TO_CLAIM_REL scr ON scr.OBJECT_ID = bal.FK_CLAIM

UNION ALL
SELECT 'BAL.FK_CLAIM = CLAIMS', COUNT(*)
FROM SICS.AC_LEDGER_BALANCE bal
INNER JOIN SICS.CLAIMS c ON c.OBJECT_ID = bal.FK_CLAIM

UNION ALL
SELECT 'DTL.FK_HEADLINE_LOSS = CLAIMS', COUNT(*)
FROM SICS.AC_LEDGER_DETAIL d
INNER JOIN SICS.CLAIMS c ON c.OBJECT_ID = d.FK_HEADLINE_LOSS

UNION ALL
SELECT 'DTL.FK_CLAIM_TO_SOC = CLAIMS', COUNT(*)
FROM SICS.AC_LEDGER_DETAIL d
INNER JOIN SICS.CLAIMS c ON c.OBJECT_ID = d.FK_CLAIM_TO_SOC

UNION ALL
SELECT 'BAL.FK_CLAIM IS NOT NULL', COUNT(*)
FROM SICS.AC_LEDGER_BALANCE
WHERE FK_CLAIM IS NOT NULL


