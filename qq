SELECT
    rz.CODE  AS RISK_ZONE_CODE,
    rz.NAME  AS RISK_ZONE_NAME,
    rd.CODE  AS PERIL_CODE,
    rd.NAME  AS PERIL_NAME
FROM SICS.RISK_ZONE AS rz
LEFT JOIN SICS.RZ_CTR_TO_REF AS rzp
    ON rzp.FK_RZ_COUNTRY = rz.OBJECT_ID

LEFT JOIN SICS.REFERENCE_DATA AS rd
    ON rd.CODE     = rzp.FRK_PERIL_TYPE
   AND rd.SUBCLASS = rzp.FSK_PERIL_TYPE
   AND rd.SUBCLASS = 44
where   rz.SUBCLASS =2
ORDER BY rz.CODE, rd.NAME;
