SELECT
      e.CODE                                          AS TRCD_CODE_BK
    , e.DESCRIPTION
    , COUNT(*)                                        AS detail_rows
    , SUM(CASE WHEN d.IS_LIQUID = 'Y' THEN 1 ELSE 0 END) AS liquid_rows
    , SUM(CASE WHEN d.IS_LIQUID = 'N' THEN 1 ELSE 0 END) AS non_liquid_rows
    , MAX(d.IS_LIQUID)                                AS any_liquid
    , CASE
          WHEN MIN(d.IS_LIQUID) = MAX(d.IS_LIQUID) THEN 'CONSISTENT'
          ELSE 'MIXED'
      END                                             AS liquidity_consistency
    , CASE WHEN MAX(d.IS_LIQUID) = 'Y' THEN 1 ELSE 0 END AS CANDIDATE_IS_CASH
FROM dbo.ENTRY_CODE AS e
JOIN dbo.AC_LEDGER_DETAIL AS d
      ON d.FK_ENTRY_CODE = e.OBJECT_ID
GROUP BY
      e.CODE
    , e.DESCRIPTION
ORDER BY
      e.CODE;





