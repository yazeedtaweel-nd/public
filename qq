SELECT
    CASE rd.CODE
        WHEN 'QA'      THEN '1'
             WHEN 'XL'      THEN '2'
        WHEN 'SURPLUS' THEN '3'
        ELSE COALESCE(rd.EXTERNAL_CODE,rd.CODE)
    END AS MOP_BK,
    CASE rd.CODE
        WHEN 'QA'      THEN 'PRO RATA - QS'
        WHEN 'XL'      THEN 'EXCESS OF LOSS'
        WHEN 'SURPLUS' THEN 'PRO RATA - SURPLUS'
        ELSE rd.NAME
    END AS MOP_NAME,
  CASE rd.CODE
        WHEN 'QA'      THEN 'PRO'
        WHEN 'XL'      THEN 'XL'
        WHEN 'SURPLUS' THEN 'PRO'
        ELSE rd.NAME
    END AS MOP_SHORT_NAME,
  CAST(CASE WHEN rd.IS_ACTIVE       = 'Y' THEN 1 ELSE 0 END AS BIT) AS MOP_IS_ACTIVE
FROM SICS.REFERENCE_DATA AS rd
WHERE rd.SUBCLASS = 22
ORDER BY rd.CODE;
