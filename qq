DECLARE @Exclude TABLE (ColumnName sysname PRIMARY KEY);
INSERT INTO @Exclude (ColumnName) VALUES
    (N'TRANS_SRGT'),
    (N'CREATED_DATE_SRGT'),
    (N'UPDATED_DATE_SRGT');

DECLARE @Fingerprint nvarchar(max);

SELECT @Fingerprint = STRING_AGG(CAST(
    N'CONVERT(binary(33), CASE WHEN d.' + QUOTENAME(c.name)
    + N' IS NULL THEN CONVERT(binary(33), 0x00) ELSE CONVERT(binary(33), 0x01 + HASHBYTES(''SHA2_256'', CONVERT(varbinary(max), '
    + CASE
        WHEN ty.name IN (N'money', N'smallmoney', N'decimal', N'numeric')
            THEN N'CONVERT(nvarchar(100), CONVERT(decimal(38,10), d.' + QUOTENAME(c.name) + N'))'
        WHEN ty.name IN (N'datetime', N'datetime2', N'smalldatetime')
            THEN N'CONVERT(nvarchar(40), d.' + QUOTENAME(c.name) + N', 121)'
        WHEN ty.name = N'date'
            THEN N'CONVERT(nvarchar(10), d.' + QUOTENAME(c.name) + N', 23)'
        ELSE N'CONVERT(nvarchar(max), d.' + QUOTENAME(c.name) + N')'
      END
    + N'))) END)' AS nvarchar(max)), N' + ')
    WITHIN GROUP (ORDER BY c.column_id)
FROM sys.columns AS c
INNER JOIN sys.tables AS t ON t.object_id = c.object_id
INNER JOIN sys.schemas AS s ON s.schema_id = t.schema_id
INNER JOIN sys.types AS ty ON ty.user_type_id = c.user_type_id
WHERE s.name = N'dbo'
  AND t.name = N'FACT_IW_TRANSACTION'
  AND c.name NOT IN (SELECT ColumnName FROM @Exclude)
  AND c.is_computed = 0;

IF @Fingerprint IS NULL
    THROW 50001, N'No columns selected. Check the table name.', 1;

DECLARE @Sql nvarchar(max) = N'
WITH src AS (
    SELECT CONVERT(binary(32), HASHBYTES(''SHA2_256'', ' + @Fingerprint + N')) AS RowHash
    FROM dbo.FACT_IW_TRANSACTION AS d
),
tgt AS (
    SELECT CONVERT(binary(32), HASHBYTES(''SHA2_256'', ' + @Fingerprint + N')) AS RowHash
    FROM OtherDwh.dbo.FACT_IW_TRANSACTION AS d
),
src_c AS (
    SELECT RowHash, COUNT_BIG(*) AS Cnt FROM src GROUP BY RowHash
),
tgt_c AS (
    SELECT RowHash, COUNT_BIG(*) AS Cnt FROM tgt GROUP BY RowHash
)
SELECT
    COALESCE(s.RowHash, t.RowHash) AS RowHash,
    ISNULL(s.Cnt, 0) AS SourceCount,
    ISNULL(t.Cnt, 0) AS TargetCount,
    ISNULL(s.Cnt, 0) - ISNULL(t.Cnt, 0) AS CountDiff
FROM src_c AS s
FULL OUTER JOIN tgt_c AS t ON s.RowHash = t.RowHash
WHERE ISNULL(s.Cnt, 0) <> ISNULL(t.Cnt, 0)
ORDER BY ABS(ISNULL(s.Cnt, 0) - ISNULL(t.Cnt, 0)) DESC;';

EXEC sys.sp_executesql @Sql;
