/* ============================================================
   Result 1 — the two objects side by side
   ============================================================ */
SELECT
    'policy_claim' AS SIDE,
    c.CLAIM_IDENTIFIER,
    c.OBJECT_ID,
    c.SUBCLASS,
    c.LOSS_NAME,
    c.FK_HEADLINE_LOSS,
    c.FK_HL_LOSS_GRP,
    CAST(NULL AS NVARCHAR(30)) AS REF_ID
FROM SICS.CLAIMS AS c
WHERE c.CLAIM_IDENTIFIER = N'IC201910001'

UNION ALL
SELECT
    'assigned_parent',
    hl.CLAIM_IDENTIFIER,
    hl.OBJECT_ID,
    hl.SUBCLASS,
    hl.LOSS_NAME,
    hl.FK_HEADLINE_LOSS,
    hl.FK_HL_LOSS_GRP,
    r.REFERENCE_ID
FROM SICS.CLAIMS AS c
INNER JOIN SICS.CLAIMS AS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
LEFT JOIN SICS.CL_HLOSS_REF AS r
    ON r.FK_PARENT = hl.OBJECT_ID
WHERE c.CLAIM_IDENTIFIER = N'IC201910001'

UNION ALL
SELECT
    'group_headline',
    g.CLAIM_IDENTIFIER,
    g.OBJECT_ID,
    g.SUBCLASS,
    g.LOSS_NAME,
    g.FK_HEADLINE_LOSS,
    g.FK_HL_LOSS_GRP,
    r.REFERENCE_ID
FROM SICS.CLAIMS AS g
LEFT JOIN SICS.CL_HLOSS_REF AS r
    ON r.FK_PARENT = g.OBJECT_ID
WHERE g.SUBCLASS = 6
ORDER BY SIDE;


/* ============================================================
   Result 2 — what each option would store as CLGRP_BK
   ============================================================ */
SELECT
    c.CLAIM_IDENTIFIER                          AS CLA_BK,
    c.FK_HEADLINE_LOSS                          AS HAS_ASSIGNMENT,
    hl.CLAIM_IDENTIFIER                         AS ASSIGNED_HEADLINE_BK,
    hl.SUBCLASS                                 AS ASSIGNED_SUBCLASS,
    r_assigned.REFERENCE_ID                     AS REF_ON_ASSIGNED_PARENT,
    r_group.REFERENCE_ID                        AS GROUP_REF_ID,          /* 324242424 */
    g.CLAIM_IDENTIFIER                          AS GROUP_HEADLINE_BK,     /* 6CL100001 */

    /* Option 1: same attribute on both dims = headline CLAIM_IDENTIFIER */
    CASE
        WHEN c.FK_HEADLINE_LOSS IS NULL THEN NULL
        ELSE hl.CLAIM_IDENTIFIER
    END                                         AS OPTION1_CLGRP_BK,

    /* Option 2: group dim key, only if assignment IS the subclass-6 headline */
    CASE
        WHEN c.FK_HEADLINE_LOSS IS NULL THEN NULL
        WHEN hl.OBJECT_ID = g.OBJECT_ID THEN r_group.REFERENCE_ID
        ELSE NULL
    END                                         AS OPTION2_CLGRP_BK,

    CASE
        WHEN c.FK_HEADLINE_LOSS IS NULL
            THEN 'no assignment — stay null'
        WHEN hl.OBJECT_ID = g.OBJECT_ID
            THEN 'same object — option 2 works (use REFERENCE_ID)'
        WHEN hl.CLAIM_IDENTIFIER IS NOT NULL
            THEN 'different objects — option 1 works (use CLAIM_IDENTIFIER); option 2 needs SICS re-assign to 6CL100001'
        ELSE
            'assignment FK does not resolve to a CLAIMS row'
    END                                         AS DECISION
FROM SICS.CLAIMS AS c
INNER JOIN SICS.SOC_TO_CLAIM_REL AS scr
    ON scr.FK_CLAIM = c.OBJECT_ID
LEFT JOIN SICS.CLAIMS AS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
LEFT JOIN SICS.CL_HLOSS_REF AS r_assigned
    ON r_assigned.FK_PARENT = hl.OBJECT_ID
LEFT JOIN SICS.CLAIMS AS g
    ON g.SUBCLASS = 6
   AND g.CLAIM_IDENTIFIER = N'6CL100001'
LEFT JOIN SICS.CL_HLOSS_REF AS r_group
    ON r_group.FK_PARENT = g.OBJECT_ID
ORDER BY c.CLAIM_IDENTIFIER, scr.OBJECT_ID;


/* ============================================================
   Result 3 — is there any bridge? (empty = no option-2 path)
   ============================================================ */
SELECT
    'same_object' AS BRIDGE,
    c.CLAIM_IDENTIFIER AS CLA_BK,
    hl.OBJECT_ID AS LEFT_OID,
    g.OBJECT_ID AS RIGHT_OID
FROM SICS.CLAIMS AS c
INNER JOIN SICS.CLAIMS AS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
INNER JOIN SICS.CLAIMS AS g
    ON g.SUBCLASS = 6
   AND g.CLAIM_IDENTIFIER = N'6CL100001'
WHERE c.CLAIM_IDENTIFIER = N'IC201910001'
  AND hl.OBJECT_ID = g.OBJECT_ID

UNION ALL
SELECT
    'assigned_points_at_group',
    c.CLAIM_IDENTIFIER,
    hl.FK_HEADLINE_LOSS,
    g.OBJECT_ID
FROM SICS.CLAIMS AS c
INNER JOIN SICS.CLAIMS AS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
INNER JOIN SICS.CLAIMS AS g
    ON g.SUBCLASS = 6
   AND g.CLAIM_IDENTIFIER = N'6CL100001'
WHERE c.CLAIM_IDENTIFIER = N'IC201910001'
  AND hl.FK_HEADLINE_LOSS = g.OBJECT_ID

UNION ALL
SELECT
    'same_hl_loss_grp',
    c.CLAIM_IDENTIFIER,
    hl.FK_HL_LOSS_GRP,
    g.FK_HL_LOSS_GRP
FROM SICS.CLAIMS AS c
INNER JOIN SICS.CLAIMS AS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
INNER JOIN SICS.CLAIMS AS g
    ON g.SUBCLASS = 6
   AND g.CLAIM_IDENTIFIER = N'6CL100001'
WHERE c.CLAIM_IDENTIFIER = N'IC201910001'
  AND hl.FK_HL_LOSS_GRP IS NOT NULL
  AND hl.FK_HL_LOSS_GRP = g.FK_HL_LOSS_GRP

UNION ALL
SELECT
    'same_loss_name',
    c.CLAIM_IDENTIFIER,
    hl.LOSS_NAME,
    g.LOSS_NAME
FROM SICS.CLAIMS AS c
INNER JOIN SICS.CLAIMS AS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
INNER JOIN SICS.CLAIMS AS g
    ON g.SUBCLASS = 6
   AND g.CLAIM_IDENTIFIER = N'6CL100001'
WHERE c.CLAIM_IDENTIFIER = N'IC201910001'
  AND NULLIF(LTRIM(RTRIM(hl.LOSS_NAME)), '') IS NOT NULL
  AND hl.LOSS_NAME = g.LOSS_NAME

UNION ALL
SELECT
    'claim_link',
    c.CLAIM_IDENTIFIER,
    ln.FK_SOURCE_CL,
    ln.FK_TARGET_CL
FROM SICS.CLAIMS AS c
INNER JOIN SICS.CLAIMS AS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
INNER JOIN SICS.CLAIMS AS g
    ON g.SUBCLASS = 6
   AND g.CLAIM_IDENTIFIER = N'6CL100001'
INNER JOIN SICS.CLAIM_LINK AS ln
    ON (
            (ln.FK_SOURCE_CL IN (c.OBJECT_ID, hl.OBJECT_ID) AND ln.FK_TARGET_CL = g.OBJECT_ID)
         OR (ln.FK_TARGET_CL IN (c.OBJECT_ID, hl.OBJECT_ID) AND ln.FK_SOURCE_CL = g.OBJECT_ID)
       )
WHERE c.CLAIM_IDENTIFIER = N'IC201910001';


/* ============================================================
   Result 4 — decision line
   ============================================================ */
SELECT
    CASE
        WHEN NOT EXISTS (
            SELECT 1
            FROM SICS.CLAIMS AS c
            WHERE c.CLAIM_IDENTIFIER = N'IC201910001'
              AND c.FK_HEADLINE_LOSS IS NOT NULL
        )
            THEN 'No assignment on IC201910001 — cannot populate CLGRP_BK'

        WHEN EXISTS (
            SELECT 1
            FROM SICS.CLAIMS AS c
            INNER JOIN SICS.CLAIMS AS hl ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
            INNER JOIN SICS.CLAIMS AS g
                ON g.SUBCLASS = 6 AND g.CLAIM_IDENTIFIER = N'6CL100001'
            WHERE c.CLAIM_IDENTIFIER = N'IC201910001'
              AND hl.OBJECT_ID = g.OBJECT_ID
        )
            THEN 'Option 2: assignment already is 6CL100001. DIM_CLAIM CLGRP_BK = CL_HLOSS_REF.REFERENCE_ID (324242424).'

        WHEN EXISTS (
            SELECT 1
            FROM SICS.CLAIMS AS c
            INNER JOIN SICS.CLAIMS AS hl ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
            WHERE c.CLAIM_IDENTIFIER = N'IC201910001'
        )
            THEN 'Option 1: assignment is a different claim than 6CL100001. Set both dims to headline CLAIM_IDENTIFIER, OR re-assign IC201910001 to 6CL100001 in SICS for option 2.'

        ELSE
            'FK_HEADLINE_LOSS is set but that OBJECT_ID is not in CLAIMS — broken FK'
    END AS DECISION;
