-- 1) J62 itself (every subclass it exists in)
SELECT
    r.SUBCLASS,
    t.NAME            AS TYPE_NAME,
    t.SYSTEM_NAME,
    r.CODE,
    r.NAME,
    r.EXTERNAL_CODE,
    r.IS_ACTIVE,
    r.IS_DEFAULT,
    r.IS_STATIC,
    r.IS_USER_DEFINED
FROM SICS.REFERENCE_DATA AS r
LEFT JOIN SICS.REF_DATA_TYPE AS t
       ON t.SUBCLASS_NUMBER = r.SUBCLASS
WHERE r.CODE = 'J62';

-- 2) J62 as CHILD — who is the parent?
SELECT
    'AS_CHILD'        AS ROLE,
    l.FSK_PARENT,
    pt.NAME           AS PARENT_TYPE_NAME,
    l.FRK_PARENT,
    p.NAME            AS PARENT_NAME,
    l.FSK_CHILD,
    ct.NAME           AS CHILD_TYPE_NAME,
    l.FRK_CHILD,
    c.NAME            AS CHILD_NAME
FROM SICS.REF_TO_REF AS l
LEFT JOIN SICS.REFERENCE_DATA AS c
       ON c.SUBCLASS = l.FSK_CHILD
      AND c.CODE     = l.FRK_CHILD
LEFT JOIN SICS.REFERENCE_DATA AS p
       ON p.SUBCLASS = l.FSK_PARENT
      AND p.CODE     = l.FRK_PARENT
LEFT JOIN SICS.REF_DATA_TYPE AS ct
       ON ct.SUBCLASS_NUMBER = l.FSK_CHILD
LEFT JOIN SICS.REF_DATA_TYPE AS pt
       ON pt.SUBCLASS_NUMBER = l.FSK_PARENT
WHERE l.FRK_CHILD = 'J62';

-- 3) J62 as PARENT — who are the children?
SELECT
    'AS_PARENT'       AS ROLE,
    l.FSK_PARENT,
    pt.NAME           AS PARENT_TYPE_NAME,
    l.FRK_PARENT,
    p.NAME            AS PARENT_NAME,
    l.FSK_CHILD,
    ct.NAME           AS CHILD_TYPE_NAME,
    l.FRK_CHILD,
    c.NAME            AS CHILD_NAME
FROM SICS.REF_TO_REF AS l
LEFT JOIN SICS.REFERENCE_DATA AS c
       ON c.SUBCLASS = l.FSK_CHILD
      AND c.CODE     = l.FRK_CHILD
LEFT JOIN SICS.REFERENCE_DATA AS p
       ON p.SUBCLASS = l.FSK_PARENT
      AND p.CODE     = l.FRK_PARENT
LEFT JOIN SICS.REF_DATA_TYPE AS ct
       ON ct.SUBCLASS_NUMBER = l.FSK_CHILD
LEFT JOIN SICS.REF_DATA_TYPE AS pt
       ON pt.SUBCLASS_NUMBER = l.FSK_PARENT
WHERE l.FRK_PARENT = 'J62';

-- 4) Same code on Occupancy (52) or Major Class (51)?
SELECT SUBCLASS, CODE, NAME, IS_ACTIVE
FROM SICS.REFERENCE_DATA
WHERE CODE = 'J62'
  AND SUBCLASS IN (50, 51, 52, 587, 588, 589, 590);

-- 5) All parent/child type pairs that involve 588
SELECT
    l.FSK_PARENT,
    pt.NAME AS PARENT_TYPE,
    l.FSK_CHILD,
    ct.NAME AS CHILD_TYPE,
    COUNT(*) AS PAIR_CNT
FROM SICS.REF_TO_REF AS l
LEFT JOIN SICS.REF_DATA_TYPE AS pt ON pt.SUBCLASS_NUMBER = l.FSK_PARENT
LEFT JOIN SICS.REF_DATA_TYPE AS ct ON ct.SUBCLASS_NUMBER = l.FSK_CHILD
WHERE l.FSK_PARENT = 588
   OR l.FSK_CHILD  = 588
GROUP BY l.FSK_PARENT, pt.NAME, l.FSK_CHILD, ct.NAME
ORDER BY PAIR_CNT DESC;
