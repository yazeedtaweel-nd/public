-- What CESSION subtypes exist, and how many have INS_PERIL?
SELECT
    c.SUBCLASS,
    COUNT(*) AS row_cnt,
    SUM(CASE WHEN c.FK_INS_PERIL IS NOT NULL THEN 1 ELSE 0 END) AS with_ins_peril,
    SUM(CASE WHEN c.OUR_EXPOSURE IS NOT NULL THEN 1 ELSE 0 END) AS with_our_exposure,
    SUM(CASE WHEN c.EXPOSURE IS NOT NULL THEN 1 ELSE 0 END) AS with_exposure,
    SUM(CASE WHEN c.CEDENT_EXPOSURE IS NOT NULL THEN 1 ELSE 0 END) AS with_cedent_exposure
FROM dbo.CESSION c
GROUP BY c.SUBCLASS
ORDER BY c.SUBCLASS;

-- What CESSION_PERIL_DETL subtypes exist, and how often LIMIT_AMOUNT is filled?
SELECT
    d.SUBCLASS,
    COUNT(*) AS row_cnt,
    SUM(CASE WHEN d.LIMIT_AMOUNT IS NOT NULL THEN 1 ELSE 0 END) AS with_limit_amount,
    MIN(d.LIMIT_AMOUNT) AS min_limit_amount,
    MAX(d.LIMIT_AMOUNT) AS max_limit_amount
FROM dbo.CESSION_PERIL_DETL d
GROUP BY d.SUBCLASS
ORDER BY d.SUBCLASS;




