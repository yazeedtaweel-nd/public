DECLARE @POLICY_IDENTIFIER nvarchar(50) = N'OPTT10000-2';

SELECT
    b.IDENTIFIER AS SEARCHED_IDENTIFIER,
    b.SUBCLASS AS SEARCHED_SUBCLASS,
    occ_b.IDENTIFIER AS OCC_IDENTIFIER,
    COALESCE(sh_own.CEDED_OF_100, sh_own.CEDED) AS OWN_CEDED,
    COALESCE(sh_occ.CEDED_OF_100, sh_occ.CEDED) AS OCC_CEDED,
    COALESCE(
        sh_own.CEDED_OF_100, sh_own.CEDED,
        sh_occ.CEDED_OF_100, sh_occ.CEDED
    ) AS POLICY_CEDED_PERCENT
FROM SICS.BUSINESS AS b
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
LEFT JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_BUSINESS = b.OBJECT_ID
   AND bsr.FK_INS_PERIOD = ip.OBJECT_ID
LEFT JOIN SICS.BC_SHARE AS sh_own
    ON sh_own.FK_INSURED_PERIOD = ip.OBJECT_ID
    OR sh_own.FK_COND_CONTAINER = bsr.FK_COND_CONT
LEFT JOIN SICS.INSURED_PERIOD AS occ_ip
    ON occ_ip.OBJECT_ID = COALESCE(ip.FK_OCC, bsr.FK_IP_OCC)
LEFT JOIN SICS.BUSINESS AS occ_b
    ON occ_b.OBJECT_ID = occ_ip.FK_BUSINESS
LEFT JOIN SICS.BUS_STRUCT_REP AS occ_bsr
    ON occ_bsr.FK_INS_PERIOD = occ_ip.OBJECT_ID
   AND occ_bsr.FK_BUSINESS = occ_b.OBJECT_ID
LEFT JOIN SICS.BC_SHARE AS sh_occ
    ON sh_occ.FK_INSURED_PERIOD = occ_ip.OBJECT_ID
    OR sh_occ.FK_COND_CONTAINER = occ_bsr.FK_COND_CONT
WHERE b.IDENTIFIER = @POLICY_IDENTIFIER
   OR ip.I_PERIOD_FORMER_ID = @POLICY_IDENTIFIER
   OR ip.BUS_INS_PER_ID = @POLICY_IDENTIFIER;
