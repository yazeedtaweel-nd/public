DECLARE @POLICY_IDENTIFIER nvarchar(50) = N'OPTT10000';

SELECT
    b.IDENTIFIER AS POLICY_IDENTIFIER,
    b.SUBCLASS,
    ip.I_PERIOD_FORMER_ID,
    ip.BUS_INS_PER_ID,
    sh.CEDED,
    sh.CEDED_OF_100,
    sh.CUR_SHARE_PCT,
    sh.SIGNED_SHARE,
    sh.WRITTEN_SHARE
FROM SICS.BUSINESS AS b
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
INNER JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_BUSINESS = b.OBJECT_ID
   AND bsr.FK_INS_PERIOD = ip.OBJECT_ID
LEFT JOIN SICS.BC_SHARE AS sh
    ON sh.FK_INSURED_PERIOD = ip.OBJECT_ID
    OR sh.FK_COND_CONTAINER = bsr.FK_COND_CONT
WHERE b.SUBCLASS IN (3, 8, 11)
  AND (
        b.IDENTIFIER = @POLICY_IDENTIFIER
     OR ip.I_PERIOD_FORMER_ID = @POLICY_IDENTIFIER
     OR ip.BUS_INS_PER_ID = @POLICY_IDENTIFIER
      )
ORDER BY b.IDENTIFIER;
