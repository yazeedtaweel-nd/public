SELECT TOP (100)
    rd.SUBCLASS,
    rd.CODE,
    rd.NAME,
    COUNT(*) AS used_by_ins_peril_rows
FROM dbo.INS_PERIL iper
INNER JOIN dbo.REFERENCE_DATA rd
    ON rd.OBJECT_ID = iper.FRK_PERIL_TYPE
GROUP BY rd.SUBCLASS, rd.CODE, rd.NAME
ORDER BY used_by_ins_peril_rows DESC;

-- If the join above is empty, try CODE join:
SELECT TOP (100)
    iper.FRK_PERIL_TYPE,
    iper.FSK_PERIL_TYPE,
    rd.SUBCLASS,
    rd.CODE,
    rd.NAME
FROM dbo.INS_PERIL iper
LEFT JOIN dbo.REFERENCE_DATA rd
    ON rd.CODE = iper.FRK_PERIL_TYPE
   AND (rd.SUBCLASS = 44 OR rd.SUBCLASS = iper.FSK_PERIL_TYPE)
WHERE iper.FRK_PERIL_TYPE IS NOT NULL;

