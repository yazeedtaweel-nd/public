SELECT 'ENTRY_CODE'        AS table_name, COUNT(*) AS row_cnt FROM ENTRY_CODE
UNION ALL SELECT 'EC_REF_DATA',        COUNT(*) FROM EC_REF_DATA
UNION ALL SELECT 'ENT_CODE_REF_DATA',  COUNT(*) FROM ENT_CODE_REF_DATA
UNION ALL SELECT 'EC_DETAIL_REF_DATA', COUNT(*) FROM EC_DETAIL_REF_DATA
UNION ALL SELECT 'ENTRY_CODE_GROUP',   COUNT(*) FROM ENTRY_CODE_GROUP
UNION ALL SELECT 'ENTRY_CODE_USAGE',   COUNT(*) FROM ENTRY_CODE_USAGE
UNION ALL SELECT 'AC_LEDGER_DETAIL',   COUNT(*) FROM AC_LEDGER_DETAIL
UNION ALL SELECT 'AC_LEDGER_BALANCE',  COUNT(*) FROM AC_LEDGER_BALANCE
UNION ALL SELECT 'GL_T_ALL',           COUNT(*) FROM GL_T_ALL
UNION ALL SELECT 'AC_BOOK_DTL_INFO',   COUNT(*) FROM AC_BOOK_DTL_INFO
UNION ALL SELECT 'REFERENCE_DATA',     COUNT(*) FROM REFERENCE_DATA
ORDER BY table_name;
