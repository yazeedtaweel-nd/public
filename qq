SELECT
      e.CODE                    AS TRCD_CODE_BK
    , e.DESCRIPTION
    , g.CODE                    AS group_code
    , g.NAME                    AS group_name
    , g.FRK_GRP_CATEGORY        AS group_category
    , gc.NAME                   AS group_category_name
FROM ENTRY_CODE AS e
JOIN ENTRY_CODE_USAGE AS u
      ON u.FK_ENTRY_CODE = e.OBJECT_ID
JOIN ENTRY_CODE_GROUP AS g
      ON g.OBJECT_ID = u.FK_ENTRY_CODE_GRP
LEFT JOIN REFERENCE_DATA AS gc
       ON gc.SUBCLASS = 223
      AND gc.CODE     = g.FRK_GRP_CATEGORY
ORDER BY
      e.CODE
    , g.CODE;



