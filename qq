SELECT
     COALESCE(rd.external_code,rd.CODE) AS CTYP_BK,
    upper(rd.NAME )AS CTYP_NAME,
    CAST(N'' AS nvarchar(50)) AS CTYP_RI_TYPE,
    rd.EXTERNAL_CODE,
     CAST(CASE WHEN rd.IS_ACTIVE       = 'Y' THEN 1 ELSE 0 END AS BIT)  as CTYP_IS_ACTIVE
FROM SICS.REFERENCE_DATA AS rd
WHERE rd.SUBCLASS = 256
ORDER BY rd.CODE;
