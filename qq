SELECT TOP (100)
    er.OBJECT_ID,
    er.SUBCLASS,
    er.FK_PRIM_CURRENCY,
    pc.ISO_NAME_ENGLISH AS primary_name,
    er.FK_SCNDRY_CURRENCY,
    sc.ISO_NAME_ENGLISH AS secondary_name,
    er.FRK_CATEGORY,
    er.RATE,
    er.FACTOR,
    er.IS_FOREIGN_IN_PRIM,
    er.PRIMARY_UNITS,
    er.SECONDARY_UNITS,
    er.RATE_DATE,
    er.RATE_YEAR,
    er.FRK_PERIOD,
    er.FRK_PERIOD_SET,
    er.ORIGIN
FROM SICS.EXCHANGE_RATE AS er
LEFT JOIN SICS.CNU_CURRENCY AS pc
       ON pc.ISO_ALPHA = er.FK_PRIM_CURRENCY
LEFT JOIN SICS.CNU_CURRENCY AS sc
       ON sc.ISO_ALPHA = er.FK_SCNDRY_CURRENCY
ORDER BY er.RATE_DATE DESC, er.RATE_YEAR DESC;
