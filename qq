/* ============================================================
   Sample link rows + BASE_AUDIT (Q4) + type-of-business names
   ============================================================ */
SELECT TOP (100)
    b.IDENTIFIER                         AS POLICY_BK,
    b.SUBCLASS                            AS BUS_SUBCLASS,      -- expect 11 for OCC?
    tob.CODE                             AS TYPE_OF_BUS_CODE,
    tob.NAME                             AS TYPE_OF_BUS_NAME,
    CASE
        WHEN r.FK_BUSINESS   IS NOT NULL THEN 'BUSINESS'
        WHEN r.FK_INS_PERIOD IS NOT NULL THEN 'INSURED_PERIOD'
        ELSE 'NONE'
    END                                  AS JOIN_GRAIN,        -- Q2
    ip.UNDERWR_YEAR,
    p.IDENTIFIER                         AS BROKER_BK,
    p.CURR_NAME                          AS BROKER_NAME,
    r.FRK_RELSHIP_TYPE,
    r.SUBCLASS                            AS REL_SUBCLASS,
    r.CEASE,
    a.CREATED_WHEN,                                             -- Q4
    a.UPDATED_WHEN,                                             -- Q4
    a.PARENT_CLASS
FROM dbo.BUSINESS_PRTNR_REL r
JOIN dbo.PARTY p
      ON p.OBJECT_ID = r.FK_BUS_PARTNER
LEFT JOIN dbo.BUSINESS b_direct
       ON b_direct.OBJECT_ID = r.FK_BUSINESS
LEFT JOIN dbo.INSURED_PERIOD ip
       ON ip.OBJECT_ID = r.FK_INS_PERIOD
LEFT JOIN dbo.BUSINESS b_via_ip
       ON b_via_ip.OBJECT_ID = ip.FK_BUSINESS
CROSS APPLY (
    SELECT
        COALESCE(b_direct.OBJECT_ID, b_via_ip.OBJECT_ID) AS OBJECT_ID,
        COALESCE(b_direct.IDENTIFIER, b_via_ip.IDENTIFIER) AS IDENTIFIER,
        COALESCE(b_direct.SUBCLASS, b_via_ip.SUBCLASS) AS SUBCLASS,
        COALESCE(b_direct.FRK_TYPE_OF_BUS, b_via_ip.FRK_TYPE_OF_BUS) AS FRK_TYPE_OF_BUS,
        COALESCE(b_direct.FSK_TYPE_OF_BUS, b_via_ip.FSK_TYPE_OF_BUS) AS FSK_TYPE_OF_BUS
) b
LEFT JOIN dbo.REFERENCE_DATA tob
       ON tob.SUBCLASS = 46
      AND tob.CODE = b.FRK_TYPE_OF_BUS
LEFT JOIN dbo.BASE_AUDIT a
       ON a.FK_PARENT = r.OBJECT_ID
WHERE r.FSK_RELSHIP_TYPE = 55
  AND r.FRK_RELSHIP_TYPE = 'BR'
  -- Uncomment once Q1 is clear:
  -- AND b.SUBCLASS = 11
ORDER BY b.IDENTIFIER, p.IDENTIFIER;
