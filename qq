-- Occupation (52)
SELECT
    CODE,
    NAME,
    IS_ACTIVE,
    RIGHT('000' + LTRIM(RTRIM(CODE)), 3) AS OCC_BK_PADDED
FROM REFERENCE_DATA
WHERE SUBCLASS = 52
ORDER BY CODE;

-- Major class (51)
SELECT
    CODE,
    NAME,
    IS_ACTIVE,
    RIGHT('00' + LTRIM(RTRIM(CODE)), 2) AS MAJOR_CLASS_BK_PADDED
FROM REFERENCE_DATA
WHERE SUBCLASS = 51
ORDER BY CODE;
