/* Confirm subclass 65 = Clean Cut codes M/N/O */
SELECT
    rd.CODE,
    rd.NAME,
    rd.EXTERNAL_CODE,
    rd.IS_ACTIVE,
    COUNT(bca.OBJECT_ID) AS USED_AS_PREM_BASIS_CNT,
    COUNT(bca2.OBJECT_ID) AS USED_AS_CLAIM_BASIS_CNT
FROM dbo.REFERENCE_DATA AS rd
LEFT JOIN dbo.BUS_COMMON_ACC AS bca
       ON bca.FRK_ACCT_BASIS = rd.CODE
      AND ISNULL(bca.FSK_ACCT_BASIS, 65) = 65
LEFT JOIN dbo.BUS_COMMON_ACC AS bca2
       ON bca2.FRK_ACCT_CLAIM_BAS = rd.CODE
      AND ISNULL(bca2.FSK_ACCT_CLAIM_BAS, 65) = 65
WHERE rd.SUBCLASS = 65
GROUP BY rd.CODE, rd.NAME, rd.EXTERNAL_CODE, rd.IS_ACTIVE
ORDER BY rd.CODE;
