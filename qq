/* DIM_SUBMISSION candidate extract from SICS
   Primary path: BUS_STRUCT_REP (denormalized business structure)
   Adjust schema/db name if needed: [SICS].[dbo].
*/
SELECT TOP (1000)
    /* Keys / versioning */
    bsr.IDENTIFIER_CURR                         AS SBM_BK,                 -- Quotation Identifier
    bsr.IDENTIFIER                              AS SBM_CONTRACT_NUMBER,    -- Business Identifier
    lcp.SEQUENCE_NUMBER                         AS SBM_VERSION_NO,
    CASE WHEN bsr.IS_CRNT_STATUS = 'Y' THEN 1 ELSE 0 END
                                                AS SBM_IS_LATEST_VERSION,

    /* Status / indicators */
    bsr.FRK_TYPE_OF_BUS                         AS SBM_BUSINESS_INDICATOR, -- candidate
    bsr.FRK_BASICSTAT_CURR                      AS AGREEMENT_BASIC_STATUS,
    bsr.FRK_LC_STAT_CURR                        AS AGREEMENT_LC_STATUS,
    CASE
        WHEN bsr.FRK_BASICSTAT_CURR IN ('A', 'OA') -- confirm accepted codes with team
          OR bsr.FRK_LC_STAT_CURR   IN ('A', 'OA')
        THEN 1 ELSE 0
    END                                         AS SBM_IS_ACCEPTED,
    bsr.LAYER_NUMBER                            AS SBM_LAYER,
    bsr.AMNDMNT_NMBR                             AS SBM_END_NO,
    bsr.FORMER_IDENTIFIER                       AS SBM_TAKEN_TO_REF_CANDIDATE,

    /* Dates / description */
    bsr.INCEPTION_DATE                          AS SBM_INCEPTION_DATE,
    CAST(ipt.INSRD_PERIOD_START AS date)        AS SBM_VALID_FROM,
    CAST(ipt.INSRD_PERIOD_END   AS date)        AS SBM_EXPIRY_DATE,
    bus.EXT_IDENTIFIER                          AS SBM_EXTERNAL_REF,
    bsr.TITLE                                   AS SBM_DESC,
    soc.ORIG_POLICY_ID                          AS SBM_ORIG_POL_REF,
    lcs.CHANGE_DATE                             AS SBM_ENTRY_DATE,
    CONCAT(u.FIRSTNAME, ' ', u.LASTNAME)        AS SBM_ENTERED_BY,
    u.SHORTNAME                                 AS SBM_ENTERED_BY_SHORTNAME,

    /* Shares */
    sh.WRITTEN_SHARE                            AS SBM_WSHARED_PRCNT,
    sh.SIGNED_SHARE                             AS SBM_SSHARED_PRCNT,

    /* Premium / TSI candidates */
    curr_lpc.OBJECT_ID                          AS PREMIUM_CURRENCY,       -- SICS currency PK is usually ISO code
    prem.CURRENT_AMOUNT                         AS PREMIUM_AMOUNT_CURRENT,
    prem.ANNUAL_AMOUNT                          AS PREMIUM_AMOUNT_ANNUAL,
    lim.AMOUNT                                  AS SBM_TSI_AMOUNT_ORIGIN_CANDIDATE,
    soc.EXPOSURE                                AS SBM_TSI_EXPOSURE_ALT,
    curr_soc.OBJECT_ID                          AS SBM_TSI_CURRENCY_CANDIDATE,

    /* Party natural keys (resolve to *_SRGT in DW) */
    brok.IDENTIFIER                             AS BROKER_BK,
    brok.CURR_NAME                              AS BROKER_NAME,
    ced.IDENTIFIER                              AS COMPANY_BK,
    ced.CURR_NAME                               AS COMPANY_NAME,
    ins.IDENTIFIER                              AS OIN_BK,
    ins.CURR_NAME                               AS OIN_NAME,

    /* Useful join keys for debugging */
    bsr.OBJECT_ID                               AS BUS_STRUCT_REP_OID,
    bsr.FK_BUSINESS                             AS BUSINESS_OID,
    bsr.FK_INS_PERIOD                           AS INSURED_PERIOD_OID,
    bsr.FK_LC_PHASE                             AS LIFE_CYCLE_PHASE_OID,
    bsr.FK_LC_STATUS_CURR                       AS LIFE_CYCLE_STATUS_OID,
    bsr.FK_SOC                                  AS SCOPE_OF_COVER_OID,
    bsr.FK_PC_SHARE                             AS BC_SHARE_OID,
    bsr.FK_PC_LIM_PREM                          AS LPC_LIM_PREM_OID

FROM BUS_STRUCT_REP AS bsr
LEFT JOIN BUSINESS           AS bus ON bus.OBJECT_ID = bsr.FK_BUSINESS
LEFT JOIN LIFE_CYCLE_PHASE   AS lcp ON lcp.OBJECT_ID = bsr.FK_LC_PHASE
LEFT JOIN LIFE_CYCLE_STATUS  AS lcs ON lcs.OBJECT_ID = bsr.FK_LC_STATUS_CURR
LEFT JOIN INS_PER_TIMESPAN   AS ipt
       ON ipt.FK_LIFECYCLEPHASE = bsr.FK_LC_PHASE
      AND ipt.IS_CURRENT = 'Y'
LEFT JOIN SCOPE_OF_COVER     AS soc ON soc.OBJECT_ID = bsr.FK_SOC
LEFT JOIN BC_SHARE           AS sh  ON sh.OBJECT_ID  = bsr.FK_PC_SHARE
LEFT JOIN LPC_LIM_PREM_COND  AS lpc ON lpc.OBJECT_ID = COALESCE(bsr.FK_PC_LIM_PREM, bsr.FK_PC_PREM)
LEFT JOIN LPC_PREMIUM        AS prem ON prem.OBJECT_ID = lpc.FK_TOT_PREM
LEFT JOIN LPC_LIMIT          AS lim  ON lim.OBJECT_ID  = lpc.FK_MAIN_LIMIT
LEFT JOIN CNU_CURRENCY       AS curr_lpc ON curr_lpc.OBJECT_ID = lpc.FK_MAIN_CURRENCY
LEFT JOIN CNU_CURRENCY       AS curr_soc ON curr_soc.OBJECT_ID = soc.FK_CURRENCY
LEFT JOIN PARTY              AS brok ON brok.OBJECT_ID = bsr.FK_BROKER
LEFT JOIN PARTY              AS ced  ON ced.OBJECT_ID  = bsr.FK_CEDENT
LEFT JOIN PARTY              AS ins  ON ins.OBJECT_ID  = bsr.FK_INSURED
LEFT JOIN CNU_USER           AS u    ON u.OBJECT_ID    = lcs.FK_UNDERWRITER

WHERE 1 = 1
  /* Optional filters while validating */
  -- AND bsr.IS_CRNT_STATUS = 'Y'
  -- AND bsr.IDENTIFIER_CURR LIKE 'Q%'
  -- AND bsr.IDENTIFIER_CURR = 'Q0101004988A'

ORDER BY
    bsr.IDENTIFIER_CURR,
    lcp.SEQUENCE_NUMBER;
