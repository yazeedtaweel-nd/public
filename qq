SELECT 
    bsr.IDENTIFIER           AS SBM_BK,
    bsr.ID_PREFIX            AS SBM_CONTRACT_NUMBER,
    bsr.TITLE                AS SBM_DESC,
    bsr.LAYER_NUMBER         AS SBM_LAYER,
    bsr.INCEPTION_DATE       AS SBM_INCEPTION_DATE,
    bsr.FRK_LC_STAT_CURR     AS LC_STATUS,
    bsr.FRK_BASICSTAT_CURR   AS BASIC_STATUS,
    CASE WHEN bsr.FRK_LC_STAT_CURR = 'OA' THEN 1 ELSE 0 END AS SBM_IS_ACCEPTED,
    CASE WHEN bsr.IS_CRNT_STATUS = 'Y' THEN 1 ELSE 0 END   AS SBM_IS_LATEST_VERSION,
    lcp.SEQUENCE_NUMBER      AS SBM_VERSION_NO,
    lcs.CHANGE_DATE          AS SBM_ENTRY_DATE,
    ipt.INSRD_PERIOD_START   AS SBM_VALID_FROM,
    ipt.INSRD_PERIOD_END     AS SBM_EXPIRY_DATE,
    sh.WRITTEN_SHARE         AS SBM_WSHARED_PRCNT,
    sh.SIGNED_SHARE          AS SBM_SSHARED_PRCNT,
    brok.IDENTIFIER          AS BROKER_BK,
    ced.IDENTIFIER           AS COMPANY_BK,
    cur.ISO_ALPHA            AS SOC_CURRENCY
FROM SICS.BUS_STRUCT_REP bsr
LEFT JOIN SICS.LIFE_CYCLE_PHASE  lcp ON lcp.OBJECT_ID = bsr.FK_LC_PHASE
LEFT JOIN SICS.LIFE_CYCLE_STATUS lcs ON lcs.OBJECT_ID = bsr.FK_LC_STATUS_CURR
LEFT JOIN SICS.INS_PER_TIMESPAN  ipt ON ipt.FK_LIFECYCLEPHASE = bsr.FK_LC_PHASE AND ipt.IS_CURRENT = 'Y'
LEFT JOIN SICS.SCOPE_OF_COVER    soc ON soc.OBJECT_ID = bsr.FK_SOC
LEFT JOIN SICS.BC_SHARE          sh  ON sh.OBJECT_ID  = bsr.FK_PC_SHARE
LEFT JOIN SICS.PARTY             brok ON brok.OBJECT_ID = bsr.FK_BROKER
LEFT JOIN SICS.PARTY             ced  ON ced.OBJECT_ID  = bsr.FK_CEDENT
LEFT JOIN SICS.CNU_CURRENCY      cur  ON cur.ISO_ALPHA  = soc.FK_CURRENCY
WHERE bsr.IS_CRNT_STATUS = 'Y'
ORDER BY bsr.IDENTIFIER;
