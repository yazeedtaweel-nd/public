/* 1. Status / substatus / classification / source-system / relationship-type domains */
SELECT SUBCLASS, CODE, NAME, IS_ACTIVE
FROM SICS.REFERENCE_DATA
WHERE SUBCLASS IN (517, 518, 528, 55, 1074)
ORDER BY SUBCLASS, CODE;

/* 2. Full status history for the two claims - shows what dates exist */
SELECT scr.OBJECT_ID AS SOC_CLAIM, c.CLAIM_IDENTIFIER,
       cs.SEQ_NUMBER, cs.FRK_STATUS, rd.NAME AS STATUS_NAME,
       cs.FRK_SUB_STATUS, cs.CHANGE_DATE, cs.IS_CURRENT
FROM SICS.CLAIMS c
INNER JOIN SOC_TO_CLAIM_REL scr ON scr.FK_CLAIM = c.OBJECT_ID
INNER JOIN CLAIM_STATUS cs      ON cs.FK_CLAIM  = scr.OBJECT_ID
LEFT  JOIN SICS.REFERENCE_DATA rd    ON rd.CODE = cs.FRK_STATUS AND rd.SUBCLASS = 517
ORDER BY c.CLAIM_IDENTIFIER, cs.SEQ_NUMBER;

/* 3. All business partners on the claim's insured period - identify the real broker */
SELECT c.CLAIM_IDENTIFIER, p.IDENTIFIER AS PARTY_ID, p.SUBCLASS AS PARTY_SUBCLASS,
       bpr.FRK_RELSHIP_TYPE, rd.NAME AS RELATIONSHIP_NAME
FROM SICS.CLAIMS c
INNER JOIN SICS.SOC_TO_CLAIM_REL scr  ON scr.FK_CLAIM = c.OBJECT_ID
LEFT  JOIN SICS.SCOPE_OF_COVER soc    ON soc.OBJECT_ID = scr.FK_SOC
LEFT  JOIN SICS.LIFE_CYCLE_PHASE lcp  ON lcp.FK_SCOPE_OF_CVR = soc.OBJECT_ID
LEFT  JOIN SICS.INSURED_PERIOD ip     ON ip.OBJECT_ID = COALESCE(soc.FK_LIFECYCLEP, lcp.FK_INS_PRD)
LEFT  JOIN SICS.BUSINESS_PRTNR_REL bpr
       ON bpr.FK_INS_PERIOD = ip.OBJECT_ID OR bpr.FK_BUSINESS = ip.FK_BUSINESS
LEFT  JOIN SICS.PARTY p               ON p.OBJECT_ID = bpr.FK_BUS_PARTNER
LEFT  JOIN SICS.REFERENCE_DATA rd     ON rd.CODE = bpr.FRK_RELSHIP_TYPE AND rd.SUBCLASS = 55
ORDER BY c.CLAIM_IDENTIFIER;
