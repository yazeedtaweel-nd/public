/* ============================================================
   Sample link rows + BASE_AUDIT (Q4) + type-of-business names
   ============================================================ */
/* 2) Sample rows + audit dates */
SELECT TOP 100
    b.IDENTIFIER            AS POLICY_BK,
    b.SUBCLASS              AS BUS_SUBCLASS,
    b.FRK_TYPE_OF_BUS,
    p.IDENTIFIER            AS BROKER_BK,
    p.CURR_NAME             AS BROKER_NAME,
    r.CEASE,
    CASE WHEN r.FK_BUSINESS IS NOT NULL THEN 'BUSINESS'
         WHEN r.FK_INS_PERIOD IS NOT NULL THEN 'INSURED_PERIOD'
         ELSE 'NONE' END    AS JOIN_GRAIN,
    a.CREATED_WHEN,
    a.UPDATED_WHEN
FROM BUSINESS_PRTNR_REL r
JOIN PARTY p ON p.OBJECT_ID = r.FK_BUS_PARTNER
LEFT JOIN INSURED_PERIOD ip ON ip.OBJECT_ID = r.FK_INS_PERIOD
LEFT JOIN BUSINESS b
       ON b.OBJECT_ID = COALESCE(r.FK_BUSINESS, ip.FK_BUSINESS)
LEFT JOIN BASE_AUDIT a ON a.FK_PARENT = r.OBJECT_ID
WHERE r.FSK_RELSHIP_TYPE = 55
  AND r.FRK_RELSHIP_TYPE = 'BR'
ORDER BY b.IDENTIFIER, p.IDENTIFIER;
