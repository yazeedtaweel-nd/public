WITH ws_balance AS (
    SELECT DISTINCT
        d.FK_WORKSHEET,
        b.OBJECT_ID,
        b.IS_OUTWARD,
        b.LEDGER_BAL_ORG_AMT
    FROM dbo.AC_LEDGER_DETAIL AS d
    INNER JOIN dbo.AC_LEDGER_BALANCE AS b
            ON b.OBJECT_ID = d.FK_BALANCE
    WHERE d.FK_WORKSHEET IS NOT NULL
)
SELECT
    w.OBJECT_ID                         AS sics_object_id,   -- staging only; not WRKS_SRGT
    CONVERT(varchar(8), w.BOOKING_DATE, 112)
        + '|' + CAST(w.ID_SERIE_NO AS varchar(20))
                                        AS WRKS_BK,
    w.BOOKING_DATE                      AS WRKS_DATE,
    w.ID_SERIE_NO                       AS WRKS_NO,
    CASE
        WHEN SUM(CASE WHEN b.IS_OUTWARD = 'Y' THEN 1 ELSE 0 END) > 0
         AND SUM(CASE WHEN ISNULL(b.IS_OUTWARD, 'N') = 'N' THEN 1 ELSE 0 END) = 0
            THEN 'O'
        WHEN SUM(CASE WHEN ISNULL(b.IS_OUTWARD, 'N') = 'N' THEN 1 ELSE 0 END) > 0
         AND SUM(CASE WHEN b.IS_OUTWARD = 'Y' THEN 1 ELSE 0 END) = 0
            THEN 'I'
        WHEN COUNT(b.OBJECT_ID) = 0
            THEN NULL
        ELSE 'MIXED'
    END                                 AS WRKS_INDICATOR,
    SUM(b.LEDGER_BAL_ORG_AMT)           AS WRKS_CASH_TOTAL_AMT
FROM dbo.AC_WORKSHEET AS w
LEFT JOIN ws_balance AS b
       ON b.FK_WORKSHEET = w.OBJECT_ID
GROUP BY
    w.OBJECT_ID,
    w.BOOKING_DATE,
    w.ID_SERIE_NO
ORDER BY
    w.BOOKING_DATE,
    w.ID_SERIE_NO;
