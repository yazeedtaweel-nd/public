/* FACT_SETTLEMENT — SICS parent extract
   Grain: exactly one row per Settlement Balance / Provision:
          settlement_balance.OBJECT_ID

   SETTLEMENT_BK links:
     FACT_SETTLEMENT -> FACT_TRA_SETTLEMENT

   Child-level dimensions remain NULL because one parent settlement can
   contain multiple worksheets, policies, claims, brokers, and entry codes.
*/
SELECT
    /* Source BK: required to link the parent fact to FACT_TRA_SETTLEMENT */
    settlement_balance.OBJECT_ID                            AS SETTLEMENT_BK,

    /* 1. STL_AUDIT_DATE_SRGT */
    TRY_CONVERT(
        int,
        CONVERT(char(8), settlement_balance.DATE_OF_BOOKING, 112)
    )                                                       AS STL_AUDIT_DATE_SRGT,

    /* 2. STL_AUDIT_DATE */
    CAST(settlement_balance.DATE_OF_BOOKING AS date)        AS STL_AUDIT_DATE,

    /* 3. STL_AUDIT_NUM */
    settlement_balance.ID_SERIE_NO                          AS STL_AUDIT_NUM,

    /* 4. STL_EFFECTIVE_DATE */
    CAST(
        COALESCE(
            settlement_balance.VALUE_DATE,
            settlement_balance.DUE_DATE
        ) AS date
    )                                                       AS STL_EFFECTIVE_DATE,

    /* 5. STL_RECONCILED_DATE */
    CAST(settlement_balance.ACTUAL_SETLMT_DATE AS date)     AS STL_RECONCILED_DATE,

    /* 6. STL_PROCESSING_PERIOD_SRGT */
    TRY_CONVERT(
        int,
        CONVERT(char(4), settlement_balance.BOOKING_YEAR)
        + RIGHT(
            '0' + REPLACE(
                UPPER(LTRIM(RTRIM(settlement_balance.FRK_BOOKING_PERIOD))),
                'M',
                ''
            ),
            2
        )
        + '01'
    )                                                       AS STL_PROCESSING_PERIOD_SRGT,

    /*
       7–14: Null at parent settlement grain.
       These dimensions are populated in FACT_TRA_SETTLEMENT.
    */
    CAST(NULL AS int)                                       AS WRKS_SRGT,
    CAST(NULL AS int)                                       AS TRST_SRGT,
    CAST(NULL AS int)                                       AS TRCD_SRGT,
    CAST(NULL AS int)                                       AS STL_ENTRY_TYPE_SRGT,
    CAST(NULL AS int)                                       AS STL_STATUS_SRGT,
    CAST(NULL AS int)                                       AS POLICY_SRGT,
    CAST(NULL AS int)                                       AS CLA_CLAIM_SRGT,
    CAST(NULL AS int)                                       AS BROK_SRGT,

    /* 15. CURR_BASE_SRGT lookup BK: only if all members have one value */
    members.CURR_BASE_BK,

    /* 16. CURR_SETT_SRGT lookup BK: settlement header currency */
    settlement_balance.FK_CURR                              AS CURR_SETT_BK,

    /* 17. CURR_ORIG_SRGT lookup BK: only if all members have one value */
    members.CURR_ORIG_BK,

    /* 18. STL_BASE_GROSS_AMT */
    CAST(details.STL_BASE_GROSS_AMT AS money)               AS STL_BASE_GROSS_AMT,

    /* 19. STL_BASE2_GROSS_AMT */
    CAST(details.STL_BASE2_GROSS_AMT AS money)              AS STL_BASE2_GROSS_AMT,

    /*
       20. STL_SETT_GROSS_AMT
       Full parent Settlement Balance total in the settlement currency.
    */
    CAST(settlement_balance.LEDGER_BAL_ORG_AMT AS money)    AS STL_SETT_GROSS_AMT,

    /* 21. STL_ORIG_GROSS_AMT */
    CAST(details.STL_ORIG_GROSS_AMT AS money)               AS STL_ORIG_GROSS_AMT,

    /* 22. STL_BASE_PTD_AMT */
    CAST(details.STL_BASE_PTD_AMT AS money)                 AS STL_BASE_PTD_AMT,

    /* 23. STL_BASE2_PTD_AMT */
    CAST(details.STL_BASE2_PTD_AMT AS money)                AS STL_BASE2_PTD_AMT,

    /*
       24. STL_SETT_PTD_AMT
       Sum of member contribution amounts in settlement balance currency.
    */
    CAST(members.STL_SETT_PTD_AMT AS money)                 AS STL_SETT_PTD_AMT,

    /* 25. STL_ORIG_PTD_AMT */
    CAST(details.STL_ORIG_PTD_AMT AS money)                 AS STL_ORIG_PTD_AMT,

    /* 26–27. ETL-generated */
    CAST(NULL AS int)                                       AS CREATED_DATE_SRGT,
    CAST(NULL AS int)                                       AS UPDATED_DATE_SRGT,

    /* 28. STL_ACCOUNT_CODE: only if all members share one value */
    members.STL_ACCOUNT_CODE,

    /*
       29. CLGRP_SRGT
       Null at parent grain; claim group belongs to FACT_TRA_SETTLEMENT.
    */
    CAST(NULL AS int)                                       AS CLGRP_SRGT

FROM SICS.AC_LEDGER_BALANCE AS settlement_balance

/* Member-level aggregation: no detail join, preventing SETTLED_AMT fan-out */
OUTER APPLY (
    SELECT
        CASE
            WHEN COUNT(DISTINCT member.FK_AC_FUNC_CCY) = 1
                THEN MIN(member.FK_AC_FUNC_CCY)
        END AS CURR_BASE_BK,

        CASE
            WHEN COUNT(DISTINCT member.FK_CURR) = 1
                THEN MIN(member.FK_CURR)
        END AS CURR_ORIG_BK,

        SUM(
            CAST(
                COALESCE(member.SETTLED_AMT, 0)
                AS decimal(38, 8)
            )
        ) AS STL_SETT_PTD_AMT,

        CASE
            WHEN COUNT(DISTINCT member.FRK_GL_ACCOUNT) = 1
                THEN MIN(member.FRK_GL_ACCOUNT)
        END AS STL_ACCOUNT_CODE

    FROM SICS.AC_LEDGER_BALANCE AS member
    WHERE member.FK_SETTLEMENT_BAL = settlement_balance.OBJECT_ID
      AND member.IS_PART_SET_BAL = 'Y'
) AS members

/* Detail-level aggregation: each detail contributes once */
OUTER APPLY (
    SELECT
        SUM(
            CAST(COALESCE(dtl.EXCH_AMT, 0) AS decimal(38, 8))
        ) AS STL_BASE_GROSS_AMT,

        SUM(
            CAST(COALESCE(dtl.FUNC_AMT2, 0) AS decimal(38, 8))
        ) AS STL_BASE2_GROSS_AMT,

        SUM(
            CAST(COALESCE(dtl.DTL_AMT, 0) AS decimal(38, 8))
        ) AS STL_ORIG_GROSS_AMT,

        SUM(
            CAST(
                CASE
                    WHEN NULLIF(dtl.DTL_AMT, 0) IS NULL THEN 0
                    ELSE dtl.EXCH_AMT
                        * (
                            (dtl.DTL_AMT - COALESCE(dtl.DTL_UNR_AMT, 0))
                            / NULLIF(dtl.DTL_AMT, 0)
                        )
                END
                AS decimal(38, 8)
            )
        ) AS STL_BASE_PTD_AMT,

        SUM(
            CAST(
                CASE
                    WHEN NULLIF(dtl.DTL_AMT, 0) IS NULL THEN 0
                    ELSE dtl.FUNC_AMT2
                        * (
                            (dtl.DTL_AMT - COALESCE(dtl.DTL_UNR_AMT, 0))
                            / NULLIF(dtl.DTL_AMT, 0)
                        )
                END
                AS decimal(38, 8)
            )
        ) AS STL_BASE2_PTD_AMT,

        SUM(
            CAST(
                COALESCE(dtl.DTL_AMT, 0)
                - COALESCE(dtl.DTL_UNR_AMT, 0)
                AS decimal(38, 8)
            )
        ) AS STL_ORIG_PTD_AMT

    FROM SICS.AC_LEDGER_BALANCE AS member
    INNER JOIN SICS.AC_LEDGER_DETAIL AS dtl
            ON dtl.FK_BALANCE = member.OBJECT_ID
    WHERE member.FK_SETTLEMENT_BAL = settlement_balance.OBJECT_ID
      AND member.IS_PART_SET_BAL = 'Y'
) AS details

WHERE settlement_balance.SUBCLASS = 1;
