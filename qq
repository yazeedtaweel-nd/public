select  T.RAL_RET_AUDIT_NUMBER AS AUDIT_NUMBER,
		T.RAL_RET_AUDIT_DATE AS AUDIT_DATE,
		CONVERT(int, CONVERT(varchar(10),T.RAL_RET_AUDIT_DATE,112)) AS AUDIT_DATE_SRGT,
		T.RAL_TRANSACTION_TYPE AS TRANSACTION_TYPE,
		T.RAL_YEAR AS UW_YEAR,
		T.RAL_COB_CODE AS COB_CODE,
		T.RAL_SYN_USER_NUMBER AS SYN_USER_NUMBER,
		T.RAL_SUG_GROUP_CODE AS SUG_GROUP_CODE,
		T.RAL_PROC_PRD AS PROCESSING_PERIOD,
		T.RAL_ORIG_CCY AS ORIG_CCY,
		T.RAL_ALL_ORIG_NET_AMT AS ORIG_NET_AMT,
		T.RAL_SETTLEMENT_CCY AS SETTLEMENT_CCY,
		T.RAL_ALL_SETT_NET_AMT AS SETTLEMENT_NET_AMT
from REIN_ALLOCATION T
