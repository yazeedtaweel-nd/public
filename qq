WITH current_span AS (
    SELECT
        ts.FK_LIFECYCLEPHASE,
        ts.INSRD_PERIOD_START,
        ts.INSRD_PERIOD_END
    FROM INS_PER_TIMESPAN AS ts
    WHERE ts.IS_CURRENT = 'Y'
),
ip_term AS (
    SELECT
        ip.OBJECT_ID,
        ip.IS_MULTI_YEAR,
        ip.UNDERWR_YEAR,
        cs.INSRD_PERIOD_START,
        cs.INSRD_PERIOD_END,
        CASE
            WHEN cs.INSRD_PERIOD_START IS NULL OR cs.INSRD_PERIOD_END IS NULL THEN NULL
            ELSE DATEDIFF(MONTH, cs.INSRD_PERIOD_START, cs.INSRD_PERIOD_END)
        END AS TERM_MONTHS
    FROM INSURED_PERIOD AS ip
    INNER JOIN LIFE_CYCLE_PHASE AS lcp
            ON lcp.FK_INS_PRD = ip.OBJECT_ID
           AND lcp.IS_CURRENT = 'Y'
    LEFT JOIN current_span AS cs
           ON cs.FK_LIFECYCLEPHASE = lcp.OBJECT_ID
)
SELECT
    ISNULL(CAST(TERM_MONTHS AS VARCHAR(10)), 'UNKNOWN') AS CANDIDATE_PTRM_BK,
    CASE
        WHEN TERM_MONTHS IS NULL THEN 'UNKNOWN'
        WHEN ISNULL(IS_MULTI_YEAR, 'N') = 'Y' THEN CONCAT(TERM_MONTHS, ' Months (Multi-Year)')
        ELSE CONCAT(TERM_MONTHS, ' Months')
    END AS CANDIDATE_PTRM_NAME,
    ISNULL(IS_MULTI_YEAR, 'N') AS IS_MULTI_YEAR,
    COUNT(*) AS IP_CNT
FROM ip_term
GROUP BY
    TERM_MONTHS,
    ISNULL(IS_MULTI_YEAR, 'N')
ORDER BY IP_CNT DESC;


