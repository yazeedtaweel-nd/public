SELECT
      e.CODE                    AS TRCD_CODE_BK
    , r.FSK_REF_DATA            AS ref_subclass
    , r.FRK_REF_DATA            AS ref_code
    , rd.NAME                   AS ref_name
    , rd.EXTERNAL_CODE
FROM dbo.ENTRY_CODE AS e
JOIN dbo.EC_REF_DATA AS r
      ON r.FK_ENTRY_CODE = e.OBJECT_ID
LEFT JOIN dbo.REFERENCE_DATA AS rd
      ON rd.SUBCLASS = r.FSK_REF_DATA
     AND rd.CODE     = r.FRK_REF_DATA
ORDER BY
      e.CODE
    , r.FSK_REF_DATA;

