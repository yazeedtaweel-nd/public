DECLARE @Bk VARCHAR(36) = 'S0111020556A';  -- paste a DIM SBMS_BK

SELECT
    bsr.IDENTIFIER,
    bsr.TITLE,
    u.USER_ID,
    u.SHORTNAME,
    bsr.IDENTIFIER_PREV,
    bsr.IDENTIFIER_CURR,
    bsr.INCEPTION_DATE,
    lcs.CHANGE_DATE,
    bsr.INSRD_PERIOD_START,
    bsr.INSRD_PERIOD_END,
    rd_lc.NAME AS LC_STATUS_NAME,
    brk.IDENTIFIER AS BROKER_BK,
    ced.IDENTIFIER AS CEDENT_BK,
    ins.IDENTIFIER AS INSURED_BK,
    cur.ISO_ALPHA,
    prem.BASE_AMOUNT,
    prem.CURRENT_AMOUNT,
    lim.AMOUNT AS LIMIT_AMOUNT
FROM BUS_STRUCT_REP AS bsr
LEFT JOIN CNU_USER AS u ON u.OBJECT_ID = bsr.FK_UNDERW_CURR
LEFT JOIN LIFE_CYCLE_STATUS AS lcs ON lcs.OBJECT_ID = bsr.FK_LC_STATUS_CURR
LEFT JOIN REFERENCE_DATA AS rd_lc
    ON rd_lc.CODE = bsr.FRK_LC_STAT_CURR AND rd_lc.SUBCLASS = 90
LEFT JOIN PARTY AS brk ON brk.OBJECT_ID = bsr.FK_BROKER
LEFT JOIN PARTY AS ced ON ced.OBJECT_ID = bsr.FK_CEDENT
LEFT JOIN PARTY AS ins ON ins.OBJECT_ID = bsr.FK_INSURED
LEFT JOIN LPC_LIM_PREM_COND AS lpc
    ON lpc.OBJECT_ID = COALESCE(bsr.FK_PC_LIM_PREM, bsr.FK_PC_PREM)
LEFT JOIN CNU_CURRENCY AS cur ON cur.ISO_ALPHA = lpc.FK_MAIN_CURRENCY
LEFT JOIN LPC_PREMIUM AS prem ON prem.OBJECT_ID = lpc.FK_TOT_PREM
LEFT JOIN LPC_LIMIT AS lim ON lim.OBJECT_ID = lpc.FK_MAIN_LIMIT
WHERE bsr.IDENTIFIER = @Bk;
