/* Q4 (fixed): which status field is populated, with which codes.
   Sub-status is NOT on BUS_STRUCT_REP - it lives on LIFE_CYCLE_STATUS. */
SELECT
    'BUS_STRUCT_REP.FRK_LC_STAT_CURR (90)' AS STATUS_FIELD,
    b.FRK_LC_STAT_CURR                     AS STATUS_CODE,
    rd.NAME                                AS STATUS_NAME,
    rd.IS_ACTIVE,
    COUNT(*)                               AS ROW_CNT
FROM BUS_STRUCT_REP b
LEFT JOIN REFERENCE_DATA rd
       ON rd.SUBCLASS = 90
      AND rd.CODE     = b.FRK_LC_STAT_CURR
WHERE b.FRK_LC_STAT_CURR IS NOT NULL
GROUP BY b.FRK_LC_STAT_CURR, rd.NAME, rd.IS_ACTIVE

UNION ALL

SELECT
    'BUS_STRUCT_REP.FRK_BASICSTAT_CURR (89)',
    b.FRK_BASICSTAT_CURR,
    rd.NAME,
    rd.IS_ACTIVE,
    COUNT(*)
FROM BUS_STRUCT_REP b
LEFT JOIN REFERENCE_DATA rd
       ON rd.SUBCLASS = 89
      AND rd.CODE     = b.FRK_BASICSTAT_CURR
WHERE b.FRK_BASICSTAT_CURR IS NOT NULL
GROUP BY b.FRK_BASICSTAT_CURR, rd.NAME, rd.IS_ACTIVE

UNION ALL

SELECT
    'LIFE_CYCLE_STATUS.FRK_AGRLCYCSTAT (90)',
    s.FRK_AGRLCYCSTAT,
    rd.NAME,
    rd.IS_ACTIVE,
    COUNT(*)
FROM LIFE_CYCLE_STATUS s
LEFT JOIN REFERENCE_DATA rd
       ON rd.SUBCLASS = 90
      AND rd.CODE     = s.FRK_AGRLCYCSTAT
WHERE s.FRK_AGRLCYCSTAT IS NOT NULL
GROUP BY s.FRK_AGRLCYCSTAT, rd.NAME, rd.IS_ACTIVE

UNION ALL

