WITH ws_balance AS (
    SELECT DISTINCT
        d.FK_WORKSHEET,
        b.OBJECT_ID,
        b.IS_OUTWARD,
        b.LEDGER_BAL_ORG_AMT
    FROM SICS.AC_LEDGER_DETAIL AS d
    INNER JOIN SICS.AC_LEDGER_BALANCE AS b
            ON b.OBJECT_ID = d.FK_BALANCE
    WHERE d.FK_WORKSHEET IS NOT NULL
),
ws_seq AS (
    SELECT
        w.OBJECT_ID,
        w.BOOKING_DATE,
        w.EXTERNAL_ID,
        ROW_NUMBER() OVER (
            PARTITION BY w.BOOKING_DATE
            ORDER BY w.ID_SERIE_NO, w.OBJECT_ID
        ) AS serie_no
    FROM SICS.AC_WORKSHEET AS w
),
ws AS (
    SELECT
        OBJECT_ID,
        BOOKING_DATE,
        CASE
            WHEN EXTERNAL_ID LIKE 'TW|%'
                THEN STUFF(EXTERNAL_ID, 1, 3, '')
            ELSE CONVERT(varchar(8), BOOKING_DATE, 112)
                 + '|' + CAST(serie_no AS varchar(20))
        END AS WRKS_BK,
        CASE
            WHEN EXTERNAL_ID LIKE 'TW|%'
                THEN COALESCE(
                    TRY_CAST(
                        RIGHT(EXTERNAL_ID, CHARINDEX('|', REVERSE(EXTERNAL_ID)) - 1)
                        AS int
                    ),
                    serie_no
                )
            ELSE serie_no
        END AS WRKS_NO
    FROM ws_seq
)
SELECT
    ws.OBJECT_ID                        AS sics_object_id,
    ws.WRKS_BK                          AS WRKS_BK,
    ws.BOOKING_DATE                     AS WRKS_DATE,
    ws.WRKS_NO                          AS WRKS_NO,
    CASE
        WHEN SUM(CASE WHEN b.IS_OUTWARD = 'Y' THEN 1 ELSE 0 END) > 0
         AND SUM(CASE WHEN ISNULL(b.IS_OUTWARD, 'N') = 'N' THEN 1 ELSE 0 END) = 0
            THEN 'O'
        WHEN SUM(CASE WHEN ISNULL(b.IS_OUTWARD, 'N') = 'N' THEN 1 ELSE 0 END) > 0
         AND SUM(CASE WHEN b.IS_OUTWARD = 'Y' THEN 1 ELSE 0 END) = 0
            THEN 'I'
        WHEN COUNT(b.OBJECT_ID) = 0
            THEN NULL
        ELSE 'MIXED'
    END                                 AS WRKS_INDICATOR,
    SUM(b.LEDGER_BAL_ORG_AMT)           AS WRKS_CASH_TOTAL_AMT
FROM ws
LEFT JOIN ws_balance AS b
       ON b.FK_WORKSHEET = ws.OBJECT_ID
GROUP BY
    ws.OBJECT_ID,
    ws.BOOKING_DATE,
    ws.WRKS_BK,
    ws.WRKS_NO
ORDER BY
    ws.BOOKING_DATE,
    ws.WRKS_NO;
