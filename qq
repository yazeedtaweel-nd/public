/* IW/OW non-proportional premium split from SICS.
   Replaces REIN_COB_CODE_PREM_SPLIT (latest version) for RI types X and R. */
WITH T0 AS (  -- outward non-proportional policies
    SELECT
        b.OBJECT_ID AS BUSINESS_ID,
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS RCS_RPD_POLICY_REF,
        YEAR(b.INCEPTION_DATE) AS RCS_YEAR,
        ip.OBJECT_ID AS INSURED_PERIOD_ID
    FROM SICS.BUSINESS AS b
    JOIN SICS.REFERENCE_DATA AS tob
        ON tob.CODE = b.FRK_TYPE_OF_BUS
       AND tob.SUBCLASS = b.FSK_TYPE_OF_BUS
       AND tob.SUBCLASS = 46
       AND tob.CODE IN (N'NONPROPTT', N'NONPROPFA')
       AND tob.EXTERNAL_CODE IN (N'TN', N'FN')
    JOIN SICS.INSURED_PERIOD AS ip
        ON ip.FK_BUSINESS = b.OBJECT_ID
    WHERE b.SUBCLASS IN (3, 8, 11)
),
T1 AS (  -- current accounting-classification split
    SELECT
        t0.RCS_RPD_POLICY_REF,
        t0.RCS_YEAR,
        ac.FRK_REFIC3 AS RCS_COB_CODE,
        CASE LTRIM(RTRIM(COALESCE(NULLIF(LTRIM(RTRIM(sug.EXTERNAL_CODE)), N''), sug.CODE)))
            WHEN N'TP' THEN N'11'
            WHEN N'TN' THEN N'12'
            WHEN N'FP' THEN N'21'
            WHEN N'FN' THEN N'22'
        END AS RCS_SUG_GROUP_CODE,
        rl.CODE AS RCS_SYN_USER_NUMBER,
        ac.SPLIT_PCT AS RCS_PREM_SPLIT_PCNT
    FROM T0 AS t0
    JOIN SICS.LIFE_CYCLE_PHASE AS lcp
        ON lcp.FK_INS_PRD = t0.INSURED_PERIOD_ID
       AND lcp.IS_CURRENT = 'Y'
    JOIN SICS.SCOPE_OF_COVER AS soc
        ON soc.FK_LIFECYCLEP = lcp.OBJECT_ID
    JOIN SICS.ACC_CLASSIFIC AS ac
        ON ac.FK_SOURCE_SOC = soc.OBJECT_ID
       AND ac.FK_BUS = t0.BUSINESS_ID
       AND ac.IS_ACTIVE = 'Y'
       AND ac.FSK_REFIC3 = 3
    JOIN SICS.REFERENCE_DATA AS sug
        ON sug.CODE = ac.FRK_REFIC46
       AND sug.SUBCLASS = ac.FSK_REFIC46
       AND sug.SUBCLASS = 46
    JOIN SICS.RU_LEAF AS rl
        ON rl.OBJECT_ID = ac.FK_REP_UNIT_1
       AND rl.FRK_CATEGORY = 'PC'
       AND rl.FSK_CATEGORY = 42
)
SELECT
    t1.RCS_RPD_POLICY_REF,
    t1.RCS_YEAR,
    t1.RCS_COB_CODE,
    t1.RCS_SUG_GROUP_CODE,
    t1.RCS_SYN_USER_NUMBER,
    SUM(t1.RCS_PREM_SPLIT_PCNT) AS RCS_PREM_SPLIT_PCNT
FROM T1 AS t1
GROUP BY
    t1.RCS_RPD_POLICY_REF,
    t1.RCS_YEAR,
    t1.RCS_COB_CODE,
    t1.RCS_SUG_GROUP_CODE,
    t1.RCS_SYN_USER_NUMBER;
