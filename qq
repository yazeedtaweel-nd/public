SELECT
      rd.CODE,
      rd.NAME,
      rd.EXTERNAL_CODE,
      rd.SUBCLASS,
      rd.IS_ACTIVE,
      rd.IS_DEFAULT,
      rd.IS_STATIC,
      rd.IS_USER_DEFINED
FROM dbo.REFERENCE_DATA AS rd
WHERE rd.SUBCLASS = 95
ORDER BY rd.CODE;


SELECT
      rd.CODE,
      rd.NAME              AS DEFAULT_NAME,
      rdn.LANGUAGE_CODE,
      rdn.NAME             AS LOCALIZED_NAME,
      rd.EXTERNAL_CODE,
      rd.IS_ACTIVE
FROM dbo.REFERENCE_DATA AS rd
LEFT JOIN dbo.REF_DATA_NAME AS rdn
       ON rdn.FRK_REF_DATA = rd.CODE
      AND rdn.FSK_REF_DATA = rd.SUBCLASS
WHERE rd.SUBCLASS = 95
ORDER BY rd.CODE, rdn.LANGUAGE_CODE;
