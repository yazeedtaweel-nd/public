SELECT
    CAST(bg.IDENTIFIER AS nvarchar(50)) AS CTRG_BK,
    COALESCE(NULLIF(LTRIM(RTRIM(bg.DESCRIPTION)), N''), bg.NAME) AS CTRG_DESCRIPTION,
    CAST(NULL AS int) AS CTRG_YEAR,
    bg.NAME AS BUS_GROUP_NAME,
    bg.DESCRIPTION AS BUS_GROUP_DESCRIPTION,
    bg.FRK_TYPE_OF_GRP,
    bg.IS_ACTIVE
FROM SICS.BUS_GROUP AS bg
WHERE bg.FRK_TYPE_OF_GRP = N'MTG'
ORDER BY bg.IDENTIFIER;
