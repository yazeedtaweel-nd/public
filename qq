SELECT
    c.ISO_ALPHA_2 AS country_code,
    c.NAME        AS country_name,
    COUNT(*)      AS region_cnt
FROM SICS.LEGAL_AREA AS c
INNER JOIN SICS.AREA_GROUP_COUNTRY AS agc
        ON agc.FK_COUNTRY = c.OBJECT_ID
INNER JOIN SICS.LEGAL_AREA AS r
        ON r.OBJECT_ID = agc.FK_AREA_GROUP
       AND r.SUBCLASS = 4
       AND r.FRK_AREA_GRP_CTGRY = 'REGION'
WHERE c.SUBCLASS = 1
  AND c.ISO_ALPHA_2 = 'YE'
GROUP BY c.ISO_ALPHA_2, c.NAME;
