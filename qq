```sql
SELECT
    p.IDENTIFIER                    AS BROK_BK,
    COALESCE(n.NAME, p.CURR_NAME)   AS BROK_NAME,
    a.ADDR_LINE_1                   AS BROK_ADDRESS_LINE1,
    a.ADDR_LINE_2                   AS BROK_ADDRESS_LINE2,
    a.ADDR_LINE_3                   AS BROK_ADDRESS_LINE3,
    a.CITY_NAME                     AS BROK_ADDRESS_CITY,
    st.NAME                         AS BROK_ADDRESS_STATE,
    ctry.ISO_ALPHA_2                AS CTRY_CODE,
    ctry.NAME                       AS CTRY_NAME,
    p.OBJECT_ID                     AS PARTY_OBJECT_ID
FROM PARTY AS p
INNER JOIN BUS_PARTNER_CAT AS bpc
    ON bpc.FK_PARTNER = p.OBJECT_ID
   AND bpc.FSK_CATEGORY = 23
   AND bpc.FRK_CATEGORY IN ('B', 'BOUT')
LEFT JOIN ORGANISATION_NAME AS n
    ON n.FK_ORGANISATION = p.OBJECT_ID
LEFT JOIN ADDRESS AS a
    ON a.FK_PARTY = p.OBJECT_ID
   AND a.IS_HOME_ADDR = 'Y'
LEFT JOIN LEGAL_AREA AS st
    ON st.OBJECT_ID = a.FK_STATE
   AND st.SUBCLASS = 2
LEFT JOIN LEGAL_AREA AS ctry
    ON ctry.OBJECT_ID = p.FK_HOME_COUNTRY
   AND ctry.SUBCLASS = 1
WHERE p.SUBCLASS = 4
ORDER BY p.IDENTIFIER;


SELECT
    a.IS_MAIN_ADDR,
    a.IS_HOME_ADDR,
    a.IS_ACTIVE,
    a.SUBCLASS,
    COUNT(*) AS CNT
FROM ADDRESS AS a
INNER JOIN PARTY AS p
    ON p.OBJECT_ID = a.FK_PARTY
   AND p.SUBCLASS = 4
GROUP BY
    a.IS_MAIN_ADDR,
    a.IS_HOME_ADDR,
    a.IS_ACTIVE,
    a.SUBCLASS
ORDER BY CNT DESC;
```
