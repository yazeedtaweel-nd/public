SELECT TOP (1000)
    w.OBJECT_ID                         AS sics_object_id,
    w.SUBCLASS,                         -- 1 = technical / business WS
    w.IDENTIFIER,                       -- Prefix + year + sequence (SICS natural id)
    w.ID_PREFIX,
    w.ID_YR_PART,
    w.ID_SERIE_NO,                      -- candidate for WRKS_NO
    w.BOOKING_DATE,                     -- candidate for WRKS_DATE
    CONVERT(varchar(8), w.BOOKING_DATE, 112)
        + '|' + CAST(w.ID_SERIE_NO AS varchar(20))
                                        AS wrks_bk_candidate_a,  -- date|serie (matches DW shape)
    CONVERT(varchar(8), w.BOOKING_DATE, 112)
        + '|' + CAST(1 AS varchar(20))  AS wrks_bk_candidate_b,  -- date|1 if DW uses daily seq
    w.FRK_TYPE,                         -- worksheet type (ref 167) — not the DW "I" indicator
    w.FRK_STATUS,                       -- worksheet status (ref 168)
    w.FRK_ORIGIN,
    w.TITLE,
    w.SOA_CONTROL_AMT,                  -- weak cash-total candidate (summary control only)
    w.REGIST_TIMESTAMP,
    w.LAST_UPDATE_DT
FROM dbo.AC_WORKSHEET AS w
ORDER BY w.BOOKING_DATE, w.ID_SERIE_NO;
