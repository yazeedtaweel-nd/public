SELECT
    p.IDENTIFIER                    AS OIN_BK,
    COALESCE(n.NAME, p.CURR_NAME)   AS OIN_NAME,
    p.OBJECT_ID                     AS PARTY_OBJECT_ID,
    p.IS_INSURED
FROM PARTY AS p
INNER JOIN (
    SELECT DISTINCT rel.FK_BUS_PARTNER
    FROM BUSINESS AS b
    INNER JOIN BUSINESS_PRTNR_REL AS rel
        ON rel.OBJECT_ID = b.FK_ORG_CDNT_RL
    WHERE rel.FK_BUS_PARTNER IS NOT NULL
) AS oin
    ON oin.FK_BUS_PARTNER = p.OBJECT_ID
LEFT JOIN (
    SELECT
        FK_ORGANISATION,
        NAME,
        ROW_NUMBER() OVER (PARTITION BY FK_ORGANISATION ORDER BY OBJECT_ID) AS RN
    FROM ORGANISATION_NAME
) AS n
    ON n.FK_ORGANISATION = p.OBJECT_ID
   AND n.RN = 1
WHERE p.SUBCLASS = 4
ORDER BY p.IDENTIFIER;





