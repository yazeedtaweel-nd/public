SELECT c.CLAIM_IDENTIFIER, bal.IS_OUTWARD, COUNT(*) AS DETAIL_ROWS,
       SUM(d.EXCH_AMT) AS FUNCTIONAL_AMT, SUM(d.DTL_AMT) AS ORIGINAL_AMT
FROM CLAIMS c
INNER JOIN SOC_TO_CLAIM_REL scr  ON scr.FK_CLAIM  = c.OBJECT_ID
INNER JOIN AC_LEDGER_BALANCE bal ON bal.FK_CLAIM  = scr.OBJECT_ID
INNER JOIN AC_LEDGER_DETAIL  d   ON d.FK_BALANCE  = bal.OBJECT_ID
GROUP BY c.CLAIM_IDENTIFIER, bal.IS_OUTWARD
ORDER BY c.CLAIM_IDENTIFIER;
