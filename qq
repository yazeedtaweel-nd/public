DECLARE @BusinessId nvarchar(50) = N'PUT_CONTRACT_ID_HERE';

WITH periods AS (
    SELECT
        b.IDENTIFIER,
        ip.OBJECT_ID AS IP_OID,
        ip.IS_LATEST,
        CAST(
            COALESCE(
                NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
                NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
            ) AS nvarchar(50)
        ) AS POLICY_BK,
        MIN(bsr.INSRD_PERIOD_START) AS PERIOD_START
    FROM SICS.BUSINESS AS b
    INNER JOIN SICS.INSURED_PERIOD AS ip
        ON ip.FK_BUSINESS = b.OBJECT_ID
    INNER JOIN SICS.BUS_STRUCT_REP AS bsr
        ON bsr.FK_INS_PERIOD = ip.OBJECT_ID
    WHERE b.IDENTIFIER = @BusinessId
    GROUP BY
        b.IDENTIFIER,
        ip.OBJECT_ID,
        ip.IS_LATEST,
        ip.I_PERIOD_FORMER_ID,
        ip.BUS_INS_PER_ID
),
ordered AS (
    SELECT
        *,
        LAG(IP_OID)  OVER (ORDER BY PERIOD_START, IP_OID) AS PREV_IP_OID,
        LEAD(IP_OID) OVER (ORDER BY PERIOD_START, IP_OID) AS NEXT_IP_OID,
        LAG(POLICY_BK)  OVER (ORDER BY PERIOD_START, IP_OID) AS PREV_POLICY_BK,
        LEAD(POLICY_BK) OVER (ORDER BY PERIOD_START, IP_OID) AS NEXT_POLICY_BK
    FROM periods
)
SELECT
    IDENTIFIER,
    IP_OID,
    POLICY_BK,
    PERIOD_START,
    IS_LATEST,
    CASE WHEN NEXT_IP_OID IS NOT NULL THEN N'Y' ELSE N'N' END AS POLICY_IS_RENEWED,
    CASE WHEN PREV_IP_OID IS NOT NULL THEN N'Y' ELSE N'N' END AS POLICY_IS_RENEWAL,
    PREV_POLICY_BK AS POLICY_RENEWED_FROM,   -- null if previous period has no POLICY_BK
    NEXT_POLICY_BK AS POLICY_RENEWED_BY      -- null if next period has no POLICY_BK
FROM ordered
ORDER BY PERIOD_START, IP_OID;
