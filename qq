SELECT
    p.IDENTIFIER                    AS OIN_BK,
    COALESCE(n.NAME, p.CURR_NAME)   AS OIN_NAME,
    p.OBJECT_ID                     AS PARTY_OBJECT_ID,
    p.IS_INSURED
FROM PARTY AS p
LEFT JOIN (
    SELECT
        FK_ORGANISATION,
        NAME,
        ROW_NUMBER() OVER (PARTITION BY FK_ORGANISATION ORDER BY OBJECT_ID) AS RN
    FROM ORGANISATION_NAME
) AS n
    ON n.FK_ORGANISATION = p.OBJECT_ID
   AND n.RN = 1
WHERE p.SUBCLASS = 4
  AND p.IS_INSURED = 'Y'
ORDER BY p.IDENTIFIER;
