SELECT CODE, NAME
FROM sics.REFERENCE_DATA
WHERE SUBCLASS = 83
ORDER BY CODE;
-- premium type (subclass 134) — last remaining typed candidate
SELECT CODE, NAME
FROM sics.REFERENCE_DATA
WHERE SUBCLASS = 134
ORDER BY CODE;
-- catch-all in case DFD is a name/external code, not CODE
SELECT SUBCLASS, CODE, NAME, EXTERNAL_CODE
FROM sics.REFERENCE_DATA
WHERE CODE LIKE N'%DFD%'
   OR NAME LIKE N'%DFD%'
   OR EXTERNAL_CODE LIKE N'%DFD%'
   OR NAME LIKE N'%Defer%';
