DECLARE @BusinessOid nvarchar(32) = N'A8FF8473D8C84510A8B46EDD6F867FC3';

SELECT
    b.IDENTIFIER                         AS POLICY_CONTRACT_NUMBER,
    ip.OBJECT_ID                         AS INSURED_PERIOD_OID,
    ip.BUS_INS_PER_ID,
    ip.I_PERIOD_FORMER_ID,
    lcp.SEQUENCE_NUMBER                  AS LCP_SEQ,
    am.OBJECT_ID                         AS AMENDMENT_OID,
    am.AMNDMNT_NMBR,
    am.EXTN_NUMBER,
    am.IS_EXTENSION,
    am.IS_ACTIVE,
    am.IS_AMND_COMP,
    am.IS_AMD_REOPENED,
    am.AMND_COMP_DATE,
    am_user.USER_ID                      AS AMENDMENT_CHECKED_BY,
    CASE
        WHEN bsr.FK_AMENDMENT IS NOT NULL
         AND bsr.IS_CURRENT_LCP = N'Y'
         AND bsr.IS_CURRENT_AM  = N'Y'
        THEN N'Y'
        ELSE N'N'
    END                                  AS IS_CURRENT_ON_EXTRACT
FROM SICS.INSURED_PERIOD AS ip
INNER JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
INNER JOIN SICS.LIFE_CYCLE_PHASE AS lcp
    ON lcp.FK_INS_PRD = ip.OBJECT_ID
INNER JOIN SICS.AM_COUPLER AS c
    ON c.FK_LIFECYCLEPHASE = lcp.OBJECT_ID
INNER JOIN SICS.AMENDMENT AS am
    ON am.OBJECT_ID = c.FK_AMENDMENT
LEFT JOIN SICS.CNU_USER AS am_user
    ON am_user.OBJECT_ID = am.FK_AMND_COMP_USER
LEFT JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_AMENDMENT = am.OBJECT_ID
   AND bsr.FK_INS_PERIOD = ip.OBJECT_ID
WHERE b.OBJECT_ID = @BusinessOid
ORDER BY ip.CREATE_TIMESTAMP, am.AMNDMNT_NMBR, lcp.SEQUENCE_NUMBER;
