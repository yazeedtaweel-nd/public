SELECT
      rd.SUBCLASS
    , rd.CODE
    , rd.NAME
    , rd.EXTERNAL_CODE
FROM REFERENCE_DATA AS rd
WHERE rd.NAME LIKE '%LIQUID%'
   OR rd.NAME LIKE '%CASH%'
   OR rd.NAME LIKE '%TECHNICAL%'
   OR rd.CODE IN ('CASH','LIQ','NLIQ','TECH')
ORDER BY rd.SUBCLASS, rd.CODE;
