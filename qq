SELECT COLUMN_NAME, DATA_TYPE, CHARACTER_MAXIMUM_LENGTH
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'dbo'
  AND TABLE_NAME = 'DIM_OCCUPATION'
ORDER BY ORDINAL_POSITION;


-- Run on SICS
-- A) Ref items for Occupation (534), Classification (535), Life Occupation Class (1134)
SELECT
    rd.SUBCLASS,
    rd.CODE,
    rd.NAME,
    rd.IS_ACTIVE,
    rd.EXTERNAL_CODE
FROM dbo.REFERENCE_DATA AS rd
WHERE rd.SUBCLASS IN (534, 535, 1134)
ORDER BY rd.SUBCLASS, rd.CODE;

-- B) Formal parent/child dependency between those ref types (if any)
SELECT
    p.SUBCLASS_NUMBER AS PARENT_SUBCLASS,
    p.NAME            AS PARENT_TYPE_NAME,
    c.SUBCLASS_NUMBER AS CHILD_SUBCLASS,
    c.NAME            AS CHILD_TYPE_NAME,
    d.FRK_TYPE,
    d.PARENT_CARDINALITY
FROM dbo.REF_DATA_DEP_TYPE AS d
JOIN dbo.REF_DATA_TYPE AS p ON p.CODE = d.FK_PARENT
JOIN dbo.REF_DATA_TYPE AS c ON c.CODE = d.FK_CHILD
WHERE p.SUBCLASS_NUMBER IN (534, 535, 1134)
   OR c.SUBCLASS_NUMBER IN (534, 535, 1134);

-- C) How often occupation + classification appear together on risks
SELECT
    'IO_PERSON' AS SRC,
    p.FRK_OCCUPATION AS OCC_CODE,
    p.FRK_CLASS_OF_OCC AS MAJOR_CLASS_CODE,
    COUNT(*) AS ROW_CNT
FROM dbo.IO_PERSON AS p
WHERE p.FRK_OCCUPATION IS NOT NULL
GROUP BY p.FRK_OCCUPATION, p.FRK_CLASS_OF_OCC

UNION ALL

SELECT
    'IO_BUILDING',
    b.FRK_OCCUPATION,
    b.FRK_CLASS_OCCUP,
    COUNT(*)
FROM dbo.IO_BUILDING AS b
WHERE b.FRK_OCCUPATION IS NOT NULL
GROUP BY b.FRK_OCCUPATION, b.FRK_CLASS_OCCUP

UNION ALL

SELECT
    'IO_ENGINEER',
    e.FRK_ENG_OCC,
    e.FRK_ENG_CLASS,
    COUNT(*)
FROM dbo.IO_ENGINEER AS e
WHERE e.FRK_ENG_OCC IS NOT NULL
GROUP BY e.FRK_ENG_OCC, e.FRK_ENG_CLASS

ORDER BY SRC, OCC_CODE, MAJOR_CLASS_CODE;
