SELECT
  (SELECT COUNT(*) FROM SICS.BC_INSTAL) AS total_instalments,
  (SELECT COUNT(DISTINCT d.FK_SRCE_INSTALMENT)
     FROM SICS.AC_LEDGER_DETAIL d
    WHERE d.FK_SRCE_INSTALMENT IS NOT NULL
      AND d.FK_WORKSHEET IS NOT NULL)                AS route1_detail_srce,
  (SELECT COUNT(*)
     FROM SICS.BC_INSTAL i
    WHERE EXISTS (SELECT 1 FROM SICS.AC_LEDGER_DETAIL d
                   WHERE d.FK_BALANCE = i.FK_REMITTANCE
                     AND d.FK_WORKSHEET IS NOT NULL)) AS route2_remittance,
  (SELECT COUNT(*)
     FROM SICS.AC_LEDGER_BALANCE bl
    WHERE bl.FK_BUSINESS IS NOT NULL
      AND bl.INSTALMENT_NUMBER IS NOT NULL)          AS route3_balances_with_bus_and_instno;
