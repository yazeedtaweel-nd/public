SELECT 'REFERENCE_DATA' AS SRC, SUBCLASS, CODE, NAME
FROM dbo.REFERENCE_DATA
WHERE NAME LIKE '%ABATTOIR%'
   OR NAME LIKE '%BAKERY%'
   OR NAME LIKE '%AERATED WATER%'
   OR CODE IN ('001','000','09','FOOD')
UNION ALL
SELECT 'REF_DATA_NAME', NULL, FRK_REF_DATA, NAME
FROM dbo.REF_DATA_NAME
WHERE NAME LIKE '%ABATTOIR%'
   OR NAME LIKE '%BAKERY%';
