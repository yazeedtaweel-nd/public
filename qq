SELECT DISTINCT
    rz.CODE  AS RISK_ZONE_CODE,
    rz.NAME  AS RISK_ZONE_NAME,
    rd.CODE  AS PERIL_CODE,
    rd.NAME  AS PERIL_NAME
FROM SICS.dbo.RISK_ZONE AS rz
LEFT JOIN SICS.dbo.INS_PERIL AS ip
    ON ip.FK_RISKZONE = rz.OBJECT_ID
LEFT JOIN SICS.dbo.REFERENCE_DATA AS rd
    ON rd.CODE     = ip.FRK_PERIL_TYPE
   AND rd.SUBCLASS = ip.FSK_PERIL_TYPE
   AND rd.SUBCLASS = 44
ORDER BY rz.CODE, rd.NAME;
