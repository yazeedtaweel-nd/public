SELECT
    c.CLAIM_IDENTIFIER AS CLGRP_BK,
    c.SHORT_DESCR AS CLGRP_LOSS_DETAILS,
    c.LOSS_NAME AS CLGRP_DESCRIPTION,
    c.LOSS_START_DT AS CLGRP_LOSS_DATE_FROM,
    c.LOSS_END_DT AS CLGRP_LOSS_DATE_TO,
    c.ADD_CODE_DT AS CLGRP_XL_DATE,
    c.IS_MARKET_LOSS AS CLGRP_MARKET_INDICATOR,
    c.FRK_ADDIT_CODE AS CLGRP_MARKET_CODE
FROM SICS.CLAIMS AS c
WHERE c.SUBCLASS = 6
ORDER BY c.CLAIM_IDENTIFIER;
