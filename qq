-- Type of Business = reference data subclass 46
SELECT
    rd.CODE,
    rd.NAME,
    rd.IS_ACTIVE
FROM REFERENCE_DATA AS rd
WHERE rd.SUBCLASS = 46
ORDER BY rd.CODE;



