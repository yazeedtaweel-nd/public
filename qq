/* ------------------------------------------------------------
   Q2 – COMP_TYPE
   All Business Partner Type codes (ref data table 23)
   Look at: CEDANT vs CEDENT spelling, multi-type parties, SECURITY
   ------------------------------------------------------------ */
SELECT
    p.IDENTIFIER                         AS COMP_BK,
    p.CURR_NAME,
    cat.FRK_CATEGORY                     AS type_code,
    cat.FSK_CATEGORY                     AS type_subclass,   -- expect 23
    rd.NAME                              AS type_name,
    rd.CODE                              AS rd_code
FROM PARTY p
LEFT JOIN BUS_PARTNER_CAT cat
       ON cat.FK_PARTNER = p.OBJECT_ID
LEFT JOIN REFERENCE_DATA rd
       ON rd.CODE     = cat.FRK_CATEGORY
      AND rd.SUBCLASS = cat.FSK_CATEGORY
WHERE p.SUBCLASS = 4
ORDER BY p.IDENTIFIER, cat.FRK_CATEGORY;
-- Distinct type codes/names in SICS
SELECT
    cat.FSK_CATEGORY,
    cat.FRK_CATEGORY,
    rd.NAME,
    COUNT(*)                 AS row_cnt,
    COUNT(DISTINCT p.OBJECT_ID) AS party_cnt
FROM PARTY p
JOIN BUS_PARTNER_CAT cat ON cat.FK_PARTNER = p.OBJECT_ID
LEFT JOIN REFERENCE_DATA rd
       ON rd.CODE = cat.FRK_CATEGORY AND rd.SUBCLASS = cat.FSK_CATEGORY
WHERE p.SUBCLASS = 4
GROUP BY cat.FSK_CATEGORY, cat.FRK_CATEGORY, rd.NAME
ORDER BY party_cnt DESC;
-- How many types per party (grain risk)
SELECT type_cnt, COUNT(*) AS parties
FROM (
    SELECT p.OBJECT_ID, COUNT(*) AS type_cnt
    FROM dbo.PARTY p
    JOIN dbo.BUS_PARTNER_CAT cat ON cat.FK_PARTNER = p.OBJECT_ID
    WHERE p.SUBCLASS = 4
    GROUP BY p.OBJECT_ID
) x
GROUP BY type_cnt
ORDER BY type_cnt;
-- Parties that look like DWH CEDANT / SECURITY
SELECT
    p.IDENTIFIER,
    p.CURR_NAME,
    STRING_AGG(CONCAT(cat.FRK_CATEGORY, ':', ISNULL(rd.NAME,'?')), ' | ')
        WITHIN GROUP (ORDER BY cat.FRK_CATEGORY) AS all_types
FROM dbo.PARTY p
JOIN dbo.BUS_PARTNER_CAT cat ON cat.FK_PARTNER = p.OBJECT_ID
LEFT JOIN dbo.REFERENCE_DATA rd
       ON rd.CODE = cat.FRK_CATEGORY AND rd.SUBCLASS = cat.FSK_CATEGORY
WHERE p.SUBCLASS = 4
  AND (
        cat.FRK_CATEGORY LIKE '%CED%'
     OR cat.FRK_CATEGORY LIKE '%SEC%'
     OR rd.NAME LIKE '%CED%'
     OR rd.NAME LIKE '%SEC%'
      )
GROUP BY p.IDENTIFIER, p.CURR_NAME
ORDER BY p.IDENTIFIER;
/* ------------------------------------------------------------
   Q3 – COMP_SECURITY_RATING
   All ratings: system, code, name, validity
   Look at: 0 / NA frequency, multiple ratings, current vs expired
   ------------------------------------------------------------ */
SELECT
    p.IDENTIFIER                         AS COMP_BK,
    p.CURR_NAME,
    bpd.SUBCLASS                         AS bp_detail_subclass,  -- rating container = 3
    r.FRK_RATING                         AS rating_code,
    r.FSK_RATING                         AS rating_subclass,     -- expect 21
    rd_r.NAME                            AS rating_name,
    r.FRK_RATING_SYSTEM                  AS rating_system_code,
    r.FSK_RATING_SYSTEM                  AS rating_system_subclass, -- expect 13
    rd_s.NAME                            AS rating_system_name,
    r.VALID_FROM,
    r.VALID_TO,
    CASE
        WHEN r.VALID_FROM IS NULL AND r.VALID_TO IS NULL THEN 'NO_DATES'
        WHEN CAST(GETDATE() AS DATE) >= ISNULL(r.VALID_FROM, '1900-01-01')
         AND CAST(GETDATE() AS DATE) <= ISNULL(r.VALID_TO,   '9999-12-31')
            THEN 'CURRENT'
        ELSE 'NOT_CURRENT'
    END                                  AS validity_flag
FROM dbo.PARTY p
LEFT JOIN dbo.BP_DETAIL bpd
       ON bpd.FK_BUS_PARTNER = p.OBJECT_ID
      AND bpd.SUBCLASS = 3          -- SicsBusinessPartnerRatingContainer
LEFT JOIN dbo.BP_RATING r
       ON r.FK_BP_RTNG_CNTNR = bpd.OBJECT_ID
LEFT JOIN dbo.REFERENCE_DATA rd_r
       ON rd_r.CODE = r.FRK_RATING AND rd_r.SUBCLASS = r.FSK_RATING
LEFT JOIN dbo.REFERENCE_DATA rd_s
       ON rd_s.CODE = r.FRK_RATING_SYSTEM AND rd_s.SUBCLASS = r.FSK_RATING_SYSTEM
WHERE p.SUBCLASS = 4
ORDER BY p.IDENTIFIER, r.VALID_FROM DESC, r.FRK_RATING_SYSTEM, r.FRK_RATING;
-- Rating code / system distribution
SELECT
    r.FRK_RATING_SYSTEM,
    rd_s.NAME AS rating_system_name,
    r.FRK_RATING,
    rd_r.NAME AS rating_name,
    COUNT(*) AS rating_rows,
    COUNT(DISTINCT p.OBJECT_ID) AS parties
FROM dbo.PARTY p
JOIN dbo.BP_DETAIL bpd ON bpd.FK_BUS_PARTNER = p.OBJECT_ID AND bpd.SUBCLASS = 3
JOIN dbo.BP_RATING r   ON r.FK_BP_RTNG_CNTNR = bpd.OBJECT_ID
LEFT JOIN dbo.REFERENCE_DATA rd_r ON rd_r.CODE = r.FRK_RATING AND rd_r.SUBCLASS = r.FSK_RATING
LEFT JOIN dbo.REFERENCE_DATA rd_s ON rd_s.CODE = r.FRK_RATING_SYSTEM AND rd_s.SUBCLASS = r.FSK_RATING_SYSTEM
WHERE p.SUBCLASS = 4
GROUP BY r.FRK_RATING_SYSTEM, rd_s.NAME, r.FRK_RATING, rd_r.NAME
ORDER BY parties DESC;
-- Multiple ratings per party
SELECT rating_cnt, COUNT(*) AS parties
FROM (
    SELECT p.OBJECT_ID, COUNT(*) AS rating_cnt
    FROM dbo.PARTY p
    JOIN dbo.BP_DETAIL bpd ON bpd.FK_BUS_PARTNER = p.OBJECT_ID AND bpd.SUBCLASS = 3
    JOIN dbo.BP_RATING r   ON r.FK_BP_RTNG_CNTNR = bpd.OBJECT_ID
    WHERE p.SUBCLASS = 4
    GROUP BY p.OBJECT_ID
) x
GROUP BY rating_cnt
ORDER BY rating_cnt;
-- Values that look like DWH 0 / NA
SELECT r.FRK_RATING, rd_r.NAME, COUNT(*) AS cnt
FROM dbo.BP_RATING r
LEFT JOIN dbo.REFERENCE_DATA rd_r
       ON rd_r.CODE = r.FRK_RATING AND rd_r.SUBCLASS = r.FSK_RATING
WHERE r.FRK_RATING IN ('0','00','NA','N/A','N.A.','NR')
   OR rd_r.NAME IN ('0','NA','N/A','Not applicable','Not rated')
   OR r.FRK_RATING LIKE '%NA%'
GROUP BY r.FRK_RATING, rd_r.NAME;
/* ------------------------------------------------------------
   Q4 – Address + CTRY_SRGT
   Home country vs address country; main vs home vs other address
   ------------------------------------------------------------ */
SELECT
    p.IDENTIFIER                         AS COMP_BK,
    p.CURR_NAME,
    p.LOCATION                           AS party_location,
    -- home country on party
    hc.CODE                              AS home_country_code,
    hc.ISO_ALPHA_2                       AS home_iso2,
    hc.NAME                              AS home_country_name,
    -- address
    a.IS_MAIN_ADDR,
    a.IS_HOME_ADDR,
    a.IS_ACTIVE,
    a.FRK_OFFICE_TYPE,
    a.ADDR_LINE_1,
    a.ADDR_LINE_2,
    a.ADDR_LINE_3,
    a.CITY_NAME,
    st.CODE                              AS state_code,
    st.NAME                              AS state_name,
    ac.CODE                              AS addr_country_code,
    ac.ISO_ALPHA_2                       AS addr_iso2,
    ac.NAME                              AS addr_country_name,
    CASE WHEN p.FK_HOME_COUNTRY = a.FK_COUNTRY THEN 1 ELSE 0 END AS home_eq_addr_country
FROM PARTY p
LEFT JOIN LEGAL_AREA hc
       ON hc.OBJECT_ID = p.FK_HOME_COUNTRY
LEFT JOIN ADDRESS a
       ON a.FK_PARTY = p.OBJECT_ID
LEFT JOIN LEGAL_AREA ac
       ON ac.OBJECT_ID = a.FK_COUNTRY
LEFT JOIN LEGAL_AREA st
       ON st.OBJECT_ID = a.FK_STATE
WHERE p.SUBCLASS = 4
ORDER BY p.IDENTIFIER, a.IS_MAIN_ADDR DESC, a.IS_HOME_ADDR DESC, a.IS_ACTIVE DESC;
-- Address cardinality / flags
SELECT
    COUNT(DISTINCT p.OBJECT_ID) AS parties,
    SUM(CASE WHEN a.OBJECT_ID IS NULL THEN 1 ELSE 0 END) AS parties_with_no_address_join_rows
FROM PARTY p
LEFT JOIN ADDRESS a ON a.FK_PARTY = p.OBJECT_ID
WHERE p.SUBCLASS = 4;
SELECT addr_cnt, COUNT(*) AS parties
FROM (
    SELECT p.OBJECT_ID, COUNT(a.OBJECT_ID) AS addr_cnt
    FROM PARTY p
    LEFT JOIN ADDRESS a ON a.FK_PARTY = p.OBJECT_ID
    WHERE p.SUBCLASS = 4
    GROUP BY p.OBJECT_ID
) x
GROUP BY addr_cnt
ORDER BY addr_cnt;
SELECT
    a.IS_MAIN_ADDR,
    a.IS_HOME_ADDR,
    a.IS_ACTIVE,
    COUNT(*) AS addr_rows,
    COUNT(DISTINCT a.FK_PARTY) AS parties
FROM ADDRESS a
JOIN PARTY p ON p.OBJECT_ID = a.FK_PARTY AND p.SUBCLASS = 4
GROUP BY a.IS_MAIN_ADDR, a.IS_HOME_ADDR, a.IS_ACTIVE
ORDER BY addr_rows DESC;
-- Home country vs main-address country mismatch
SELECT
    p.IDENTIFIER,
    p.CURR_NAME,
    hc.NAME AS home_country,
    ac.NAME AS main_addr_country,
    a.ADDR_LINE_1,
    a.CITY_NAME
FROM PARTY p
LEFT JOIN LEGAL_AREA hc ON hc.OBJECT_ID = p.FK_HOME_COUNTRY
LEFT JOIN ADDRESS a
       ON a.FK_PARTY = p.OBJECT_ID
      AND a.IS_MAIN_ADDR = 'Y'
LEFT JOIN LEGAL_AREA ac ON ac.OBJECT_ID = a.FK_COUNTRY
WHERE p.SUBCLASS = 4
  AND ISNULL(p.FK_HOME_COUNTRY,'') <> ISNULL(a.FK_COUNTRY,'')
ORDER BY p.IDENTIFIER;
-- City/state populated vs empty (explains DWH nulls)
SELECT
    SUM(CASE WHEN NULLIF(LTRIM(RTRIM(a.CITY_NAME)),'') IS NULL THEN 1 ELSE 0 END) AS city_empty,
    SUM(CASE WHEN NULLIF(LTRIM(RTRIM(a.CITY_NAME)),'') IS NOT NULL THEN 1 ELSE 0 END) AS city_filled,
    SUM(CASE WHEN a.FK_STATE IS NULL THEN 1 ELSE 0 END) AS state_empty,
    SUM(CASE WHEN a.FK_STATE IS NOT NULL THEN 1 ELSE 0 END) AS state_filled,
    COUNT(*) AS addr_rows
FROM dbo.ADDRESS a
JOIN dbo.PARTY p ON p.OBJECT_ID = a.FK_PARTY AND p.SUBCLASS = 4
WHERE a.IS_MAIN_ADDR = 'Y' OR a.IS_HOME_ADDR = 'Y';
/* ------------------------------------------------------------
   Q5 – CREATED / UPDATED date surrogates
   PARTY has no dates. Check BASE_AUDIT vs DEACTIVATED only.
   Look at: PARENT_CLASS values, whether dates cluster on one load day
   ------------------------------------------------------------ */
SELECT
    ba.PARENT_CLASS,
    COUNT(*) AS audit_rows,
    COUNT(DISTINCT ba.FK_PARENT) AS distinct_parents,
    MIN(ba.CREATED_WHEN) AS min_created,
    MAX(ba.CREATED_WHEN) AS max_created,
    MIN(ba.UPDATED_WHEN) AS min_updated,
    MAX(ba.UPDATED_WHEN) AS max_updated
FROM dbo.BASE_AUDIT ba
GROUP BY ba.PARENT_CLASS
ORDER BY audit_rows DESC;
SELECT
    p.IDENTIFIER                         AS COMP_BK,
    p.CURR_NAME,
    p.DEACTIVATED                        AS party_deactivated,
    ba.PARENT_CLASS,
    ba.CREATED_WHEN,
    ba.UPDATED_WHEN,
    CONVERT(varchar(8), ba.CREATED_WHEN, 112) AS created_yyyymmdd,
    CONVERT(varchar(8), ba.UPDATED_WHEN, 112) AS updated_yyyymmdd
FROM dbo.PARTY p
LEFT JOIN dbo.BASE_AUDIT ba
       ON ba.FK_PARENT = p.OBJECT_ID
WHERE p.SUBCLASS = 4
ORDER BY p.IDENTIFIER;
-- If PARENT_CLASS is a Java class name, this finds Party / BusinessPartner rows
SELECT
    ba.PARENT_CLASS,
    COUNT(*) AS cnt
FROM dbo.BASE_AUDIT ba
JOIN dbo.PARTY p ON p.OBJECT_ID = ba.FK_PARENT AND p.SUBCLASS = 4
GROUP BY ba.PARENT_CLASS
ORDER BY cnt DESC;
-- Date clustering (suggests ETL bulk load vs true source timestamps)
SELECT
    CONVERT(varchar(8), ba.CREATED_WHEN, 112) AS created_yyyymmdd,
    COUNT(*) AS parties
FROM dbo.PARTY p
JOIN dbo.BASE_AUDIT ba ON ba.FK_PARENT = p.OBJECT_ID
WHERE p.SUBCLASS = 4
GROUP BY CONVERT(varchar(8), ba.CREATED_WHEN, 112)
ORDER BY parties DESC;
/* ------------------------------------------------------------
   Q6 – One row per company with ALL options side by side
   Use this to compare a few DWH keys (e.g. 000001) to SICS
   ------------------------------------------------------------ */
SELECT
    p.IDENTIFIER                         AS COMP_BK,
    p.IS_ACTIVE,
    p.IS_BASE_COMPANY,
    p.IS_BUS_PARTNER,
    p.CURR_NAME                          AS opt_name_party_curr,
    org_curr.NAME                        AS opt_name_org_name,
    org_curr.FULL_NAME                   AS opt_name_org_full,
    org_curr.SHORT_NAME                  AS opt_name_org_short,
    org_curr.SUBCLASS                    AS org_name_subclass_used,
    types.all_type_codes                 AS opt_type_codes,
    types.all_type_names                 AS opt_type_names,
    types.type_cnt,
    ratings.all_ratings                  AS opt_all_ratings,
    ratings.current_ratings              AS opt_current_ratings,
    ratings.rating_cnt,
    a.IS_MAIN_ADDR,
    a.IS_HOME_ADDR,
    a.ADDR_LINE_1                        AS opt_addr1,
    a.ADDR_LINE_2                        AS opt_addr2,
    a.ADDR_LINE_3                        AS opt_addr3,
    a.CITY_NAME                          AS opt_city,
    st.NAME                              AS opt_state_name,
    hc.ISO_ALPHA_2                       AS opt_ctry_home_iso2,
    hc.NAME                              AS opt_ctry_home_name,
    ac.ISO_ALPHA_2                       AS opt_ctry_addr_iso2,
    ac.NAME                              AS opt_ctry_addr_name,
    CONVERT(varchar(8), ba.CREATED_WHEN, 112) AS opt_created_yyyymmdd,
    CONVERT(varchar(8), ba.UPDATED_WHEN, 112) AS opt_updated_yyyymmdd
FROM PARTY p
OUTER APPLY (
    SELECT TOP (1) *
    FROM ORGANISATION_NAME o
    WHERE o.FK_ORGANISATION = p.OBJECT_ID
    ORDER BY
        CASE WHEN o.NAME = p.CURR_NAME THEN 0 ELSE 1 END,
        o.SUBCLASS
) org_curr
OUTER APPLY (
    SELECT
        COUNT(*) AS type_cnt,
        STRING_AGG(cat.FRK_CATEGORY, ',') WITHIN GROUP (ORDER BY cat.FRK_CATEGORY) AS all_type_codes,
        STRING_AGG(rd.NAME, ',')          WITHIN GROUP (ORDER BY cat.FRK_CATEGORY) AS all_type_names
    FROM BUS_PARTNER_CAT cat
    LEFT JOIN REFERENCE_DATA rd
           ON rd.CODE = cat.FRK_CATEGORY AND rd.SUBCLASS = cat.FSK_CATEGORY
    WHERE cat.FK_PARTNER = p.OBJECT_ID
) types
OUTER APPLY (
    SELECT
        COUNT(*) AS rating_cnt,
        STRING_AGG(
            CONCAT(r.FRK_RATING_SYSTEM, ':', r.FRK_RATING, ' [', CONVERT(varchar(10), r.VALID_FROM, 23), '..', CONVERT(varchar(10), r.VALID_TO, 23), ']'),
            ' | '
        ) WITHIN GROUP (ORDER BY r.VALID_FROM DESC) AS all_ratings,
        STRING_AGG(
            CASE
                WHEN CAST(GETDATE() AS DATE) >= ISNULL(r.VALID_FROM, '1900-01-01')
                 AND CAST(GETDATE() AS DATE) <= ISNULL(r.VALID_TO,   '9999-12-31')
                THEN CONCAT(r.FRK_RATING_SYSTEM, ':', r.FRK_RATING)
            END,
            ' | '
        ) AS current_ratings
    FROM BP_DETAIL bpd
    JOIN BP_RATING r ON r.FK_BP_RTNG_CNTNR = bpd.OBJECT_ID
    WHERE bpd.FK_BUS_PARTNER = p.OBJECT_ID
      AND bpd.SUBCLASS = 3
) ratings
OUTER APPLY (
    SELECT TOP (1) *
    FROM ADDRESS ad
    WHERE ad.FK_PARTY = p.OBJECT_ID
    ORDER BY
        CASE WHEN ad.IS_MAIN_ADDR = 'Y' THEN 0 ELSE 1 END,
        CASE WHEN ad.IS_HOME_ADDR = 'Y' THEN 0 ELSE 1 END,
        CASE WHEN ad.IS_ACTIVE    = 'Y' THEN 0 ELSE 1 END
) a
LEFT JOIN LEGAL_AREA hc ON hc.OBJECT_ID = p.FK_HOME_COUNTRY
LEFT JOIN LEGAL_AREA ac ON ac.OBJECT_ID = a.FK_COUNTRY
LEFT JOIN LEGAL_AREA st ON st.OBJECT_ID = a.FK_STATE
OUTER APPLY (
    SELECT TOP (1) *
    FROM BASE_AUDIT b
    WHERE b.FK_PARENT = p.OBJECT_ID
    ORDER BY b.UPDATED_WHEN DESC
) ba
WHERE p.SUBCLASS = 4
-- AND p.IDENTIFIER IN ('000001','000002','000003')   -- uncomment to match DWH samples
ORDER BY p.IDENTIFIER;
