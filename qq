SELECT
    rz.OBJECT_ID,
    rz.INTEGER_ID,
    rz.CODE,
    rz.NAME AS RISK_ZONE_NAME,
    rz.SUBCLASS,
    rz.FK_PARENT,
    rz.FK_COUNTRY,
    la.NAME AS COUNTRY_NAME,
    la.ISO_ALPHA_2,
    la.ISO_ALPHA_3,
    la.CODE AS LEGAL_AREA_CODE,
    la.UNIQUE_CODE,
    parent.CODE AS PARENT_CODE,
    parent.NAME AS PARENT_NAME,
    CASE
        WHEN la.NAME IS NOT NULL THEN la.NAME + ' - ' + rz.NAME
        ELSE rz.NAME
    END AS CRZ_NAME_CANDIDATE
FROM SICS.RISK_ZONE rz
LEFT JOIN SICS.LEGAL_AREA la
    ON la.OBJECT_ID = rz.FK_COUNTRY
   AND la.SUBCLASS = 1
LEFT JOIN SICS.RISK_ZONE parent
    ON parent.OBJECT_ID = rz.FK_PARENT
ORDER BY rz.CODE;
