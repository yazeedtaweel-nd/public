DECLARE @POLICY_IDENTIFIER nvarchar(50) = N'OPTT10000';

SELECT
    b.IDENTIFIER,
    COALESCE(sh.CEDED_OF_100, sh.CEDED, sh_occ.CEDED_OF_100, sh_occ.CEDED)
        AS POLICY_CEDED_PERCENT
FROM SICS.BUSINESS AS b
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
LEFT JOIN SICS.BC_SHARE AS sh
    ON sh.FK_INSURED_PERIOD = ip.OBJECT_ID
LEFT JOIN SICS.BC_SHARE AS sh_occ
    ON sh_occ.FK_INSURED_PERIOD = ip.FK_OCC
WHERE b.IDENTIFIER = @POLICY_IDENTIFIER;
