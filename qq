DECLARE @BusinessId nvarchar(50) = N'PUT_CONTRACT_ID_HERE';

WITH periods AS (
    SELECT
        b.IDENTIFIER AS CONTRACT_NUMBER,   -- same on all periods; not FOR/BY unless spec says so
        ip.OBJECT_ID AS IP_OID,
        ip.IS_LATEST,
        CAST(
            COALESCE(
                NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
                NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
            ) AS nvarchar(50)
        ) AS POLICY_BK,
        MIN(bsr.INSRD_PERIOD_START) AS PERIOD_START
    FROM SICS.BUSINESS AS b
    INNER JOIN SICS.INSURED_PERIOD AS ip
        ON ip.FK_BUSINESS = b.OBJECT_ID
    INNER JOIN SICS.BUS_STRUCT_REP AS bsr
        ON bsr.FK_INS_PERIOD = ip.OBJECT_ID
    WHERE b.IDENTIFIER = @BusinessId
    GROUP BY
        b.IDENTIFIER,
        ip.OBJECT_ID,
        ip.IS_LATEST,
        ip.I_PERIOD_FORMER_ID,
        ip.BUS_INS_PER_ID
),
ordered AS (
    SELECT
        *,
        ROW_NUMBER() OVER (ORDER BY PERIOD_START, IP_OID) AS RN
    FROM periods
)
SELECT
    o.CONTRACT_NUMBER,
    o.IP_OID,
    o.POLICY_BK,
    o.PERIOD_START,
    o.IS_LATEST,
    CASE WHEN n.IP_OID IS NOT NULL THEN N'Y' ELSE N'N' END AS POLICY_IS_RENEWED,
    CASE WHEN p.IP_OID IS NOT NULL THEN N'Y' ELSE N'N' END AS POLICY_IS_RENEWAL,
    p.POLICY_BK AS POLICY_RENEWED_FROM,
    n.POLICY_BK AS POLICY_RENEWED_BY,
    -- debug: why BY might be null
    n.POLICY_BK AS NEXT_PERIOD_POLICY_BK,
    p.POLICY_BK AS PREV_PERIOD_POLICY_BK
FROM ordered o
LEFT JOIN ordered p ON p.RN = o.RN - 1
LEFT JOIN ordered n ON n.RN = o.RN + 1
ORDER BY o.RN;
