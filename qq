SELECT
    CAST(LTRIM(RTRIM(g.IDENTIFIER)) AS nvarchar(50)) AS CTRG_BK,
    CAST(g.NAME AS nvarchar(250))                    AS CTRG_DESCRIPTION,
    CAST(ip.UNDERWR_YEAR AS int)                     AS CTRG_YEAR
FROM SICS.BUS_GROUP AS g
LEFT JOIN SICS.BUSINESS AS b
    ON b.FK_MST_TREATY_GRP = g.OBJECT_ID
LEFT JOIN SICS.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
WHERE g.IDENTIFIER IS NOT NULL
GROUP BY
    g.IDENTIFIER,
    g.NAME,
    ip.UNDERWR_YEAR
ORDER BY
    g.IDENTIFIER,
    ip.UNDERWR_YEAR;
