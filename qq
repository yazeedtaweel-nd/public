DECLARE @POLICY_IDENTIFIER nvarchar(50) = N'OPT10000';

SELECT
    b.IDENTIFIER AS SEARCHED_IDENTIFIER,
    b.SUBCLASS AS SEARCHED_SUBCLASS,
    sh_own.CEDED AS OWN_CEDED
FROM SICS.BUSINESS AS b
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
LEFT JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_BUSINESS = b.OBJECT_ID
   AND bsr.FK_INS_PERIOD = ip.OBJECT_ID
LEFT JOIN SICS.BC_SHARE AS sh_own
    ON sh_own.FK_INSURED_PERIOD = ip.OBJECT_ID
    OR sh_own.FK_COND_CONTAINER = bsr.FK_COND_CONT
WHERE b.IDENTIFIER = @POLICY_IDENTIFIER
   OR ip.I_PERIOD_FORMER_ID = @POLICY_IDENTIFIER
   OR ip.BUS_INS_PER_ID = @POLICY_IDENTIFIER;
