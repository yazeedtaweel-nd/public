SELECT TOP (50)
    b.IDENTIFIER              AS business_id,
    ip.BUS_INS_PER_ID         AS insured_period_id,
    ip.UNDERWR_YEAR           AS uw_year,
    lpc.FK_MAIN_CURRENCY      AS orig_ccy,          -- PAG_ORIGINAL_CCY candidate
    b.FK_FUNCTIONAL_CCY       AS base_ccy_candidate,-- PAG_BASE_CCY candidate
    lim.AMOUNT                AS pag_amount,        -- PAG_AMOUNT_ORIGINAL candidate
    lim.LIMIT_PERCENT         AS limit_percent,     -- weak PML% candidate
    lim.IS_UNLIMITED          AS is_unlimited,
    lim.FRK_LIMIT_TYPE        AS limit_type,
    lim.OBJECT_ID             AS limit_oid,
    lpc.OBJECT_ID             AS lpc_oid,
    ip.OBJECT_ID              AS ip_oid
FROM dbo.LPC_LIM_PREM_COND lpc
INNER JOIN dbo.LPC_LIMIT lim
    ON lim.OBJECT_ID = lpc.FK_ANN_AGG_LIMIT
INNER JOIN dbo.INSURED_PERIOD ip
    ON ip.OBJECT_ID = lpc.FK_INSURED_PERIOD
INNER JOIN dbo.BUSINESS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
WHERE lpc.FK_ANN_AGG_LIMIT IS NOT NULL
ORDER BY b.IDENTIFIER, ip.UNDERWR_YEAR;

