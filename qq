DECLARE @POLICY_IDENTIFIER nvarchar(50) = N'PUT_POLICY_IDENTIFIER_HERE';

SELECT
    b.IDENTIFIER AS POLICY_IDENTIFIER,
    b.SUBCLASS,
    ip.I_PERIOD_FORMER_ID,
    ip.BUS_INS_PER_ID,
    ip.OBJECT_ID AS INSURED_PERIOD_OID,
    br.OBJECT_ID AS BUS_RETRO_OID,
    br.PLACED_SHARE,
    br.RETROCEDED_VALUE,
    soc_retro.OBJECT_ID AS SOC_VIA_RETRO_OID,
    soc_retro.CEDED_SHARE AS CEDED_SHARE_VIA_RETRO,
    soc_lcp.OBJECT_ID AS SOC_VIA_LCP_OID,
    soc_lcp.CEDED_SHARE AS CEDED_SHARE_VIA_LCP,
    ppp.QS_PCT
FROM SICS.BUSINESS AS b
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
LEFT JOIN SICS.BUS_RETRO AS br
    ON br.FK_INSURED_PERIOD = ip.OBJECT_ID
LEFT JOIN SICS.SCOPE_OF_COVER AS soc_retro
    ON soc_retro.OBJECT_ID = br.FK_SOC
LEFT JOIN SICS.LIFE_CYCLE_PHASE AS lcp
    ON lcp.FK_INS_PRD = ip.OBJECT_ID
LEFT JOIN SICS.SCOPE_OF_COVER AS soc_lcp
    ON soc_lcp.FK_LIFECYCLEP = lcp.OBJECT_ID
LEFT JOIN SICS.PROTECT_PROG_PART AS ppp
    ON ppp.FK_IP_OCC = ip.OBJECT_ID
WHERE b.IDENTIFIER = @POLICY_IDENTIFIER
   OR ip.I_PERIOD_FORMER_ID = @POLICY_IDENTIFIER
   OR ip.BUS_INS_PER_ID = @POLICY_IDENTIFIER
ORDER BY
    ip.OBJECT_ID,
    br.OBJECT_ID,
    soc_lcp.OBJECT_ID;
