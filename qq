-- 1) Confirm the business exists and its subclass
SELECT OBJECT_ID, IDENTIFIER, SUBCLASS, TITLE
FROM SICS.BUSINESS
WHERE IDENTIFIER = N'PUT_CONTRACT_ID_HERE';

-- 2) All insured periods for that contract (this is the renewal chain)
SELECT
    b.IDENTIFIER,
    b.SUBCLASS AS BUS_SUBCLASS,
    ip.OBJECT_ID AS IP_OID,
    ip.SUBCLASS AS IP_SUBCLASS,
    ip.BUS_INS_PER_ID,
    ip.I_PERIOD_FORMER_ID,
    ip.FRK_RENEWED_LCP,
    ip.FSK_RENEWED_LCP,
    ip.FRK_RENEW_OPTION,
    ip.IS_AUTO_RENEWED,
    ip.IS_FAC_AUTO_RENEW,
    ip.LAST_RENEW,
    bsr.SEQUENCE_NUMBER,
    bsr.IS_CURRENT_LCP,
    bsr.IS_CURRENT_AM,
    bsr.INSRD_PERIOD_START,
    bsr.INSRD_PERIOD_END
FROM SICS.BUSINESS b
JOIN SICS.BUS_STRUCT_REP bsr
    ON bsr.FK_BUSINESS = b.OBJECT_ID
JOIN SICS.INSURED_PERIOD ip
    ON ip.OBJECT_ID = bsr.FK_INS_PERIOD
WHERE b.IDENTIFIER = N'PUT_CONTRACT_ID_HERE'
ORDER BY bsr.INSRD_PERIOD_START, bsr.SEQUENCE_NUMBER;
