SELECT
    z.CODE AS CRZ_BK,
    la.NAME + ' - ' + z.NAME AS CRZ_NAME,
    COALESCE(la.CODE, la.ISO_ALPHA_2) AS CTRY_COUNTRY_CODE
FROM SICS.RISK_ZONE ctry
JOIN SICS.RISK_ZONE z
    ON z.FK_PARENT = ctry.OBJECT_ID
   AND z.SUBCLASS = 1
JOIN SICS.LEGAL_AREA la
    ON la.OBJECT_ID = ctry.FK_COUNTRY
WHERE ctry.SUBCLASS = 2
ORDER BY z.CODE;




WITH tree AS (
    SELECT
        rz.OBJECT_ID,
        rz.CODE,
        rz.NAME,
        rz.SUBCLASS,
        CAST(rz.FK_COUNTRY AS VARCHAR(32)) AS country_id
    FROM SICS.RISK_ZONE rz
    WHERE rz.FK_PARENT IS NULL
    UNION ALL
    SELECT
        c.OBJECT_ID,
        c.CODE,
        c.NAME,
        c.SUBCLASS,
        COALESCE(c.FK_COUNTRY, t.country_id)
    FROM SICS.RISK_ZONE c
    JOIN tree t
        ON c.FK_PARENT = t.OBJECT_ID
)
SELECT
    t.CODE AS CRZ_BK,
    la.NAME + ' - ' + t.NAME AS CRZ_NAME,
    COALESCE(la.CODE, la.ISO_ALPHA_2) AS CTRY_COUNTRY_CODE
FROM tree t
JOIN SICS.LEGAL_AREA la
    ON la.OBJECT_ID = t.country_id
WHERE t.SUBCLASS = 1
ORDER BY t.CODE
OPTION (MAXRECURSION 0);
