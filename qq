SELECT SUBCLASS_NUMBER, CODE, NAME, SYSTEM_NAME,
       IS_USER_DEFINED, IS_FOR_PC, IS_ACTIVE
FROM SICS.REF_DATA_TYPE
WHERE SUBCLASS_NUMBER IN (50, 51, 52, 587, 588, 589, 590)
ORDER BY SUBCLASS_NUMBER;


SELECT SUBCLASS, COUNT(*) AS ROW_CNT
FROM SICS.REFERENCE_DATA
GROUP BY SUBCLASS
HAVING COUNT(*) > 100
ORDER BY ROW_CNT DESC;


SELECT SUBCLASS, CODE, NAME, IS_ACTIVE
FROM SICS.REFERENCE_DATA
WHERE CODE = 'J62';

SELECT FSK_PARENT, FSK_CHILD, COUNT(*) AS PAIR_CNT
FROM SICS.REF_TO_REF
WHERE FSK_CHILD IN (52, 588)
   OR FSK_PARENT IN (52, 588)
GROUP BY FSK_PARENT, FSK_CHILD
ORDER BY FSK_PARENT, FSK_CHILD;
