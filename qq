SELECT
    IDENTIFIER_CURR      AS SBM_BK,
    IDENTIFIER           AS SBM_CONTRACT_NUMBER,
    TITLE                AS SBM_DESC,
    LAYER_NUMBER         AS SBM_LAYER,
    AMNDMNT_NMBR         AS SBM_END_NO,
    FRK_TYPE_OF_BUS      AS TYPE_OF_BUS,
    INCEPTION_DATE       AS SBM_INCEPTION_DATE,
    INSRD_PERIOD_START   AS SBM_VALID_FROM,
    INSRD_PERIOD_END     AS SBM_EXPIRY_DATE,
    IDENTIFIER_PREV      AS PREV_QUOTE_ID,
    FRK_LC_STAT_CURR     AS LC_STATUS_CODE,
    FRK_BASICSTAT_CURR   AS BASIC_STATUS_CODE,
    FK_BROKER,
    FK_CEDENT,
    FK_INSURED,
    FK_UNDERW_CURR,
    FK_LC_STATUS_CURR
FROM BUS_STRUCT_REP
WHERE IDENTIFIER_CURR IS NOT NULL;

-----------------------
SELECT
    IDENTIFIER           AS SBMS_BK,
    TITLE                AS SBMS_TITLE,
    IDENTIFIER_PREV      AS SBMS_TAKEN_FROM_REF,
    IDENTIFIER_CURR      AS SBMS_TAKEN_TO_REF_ALT,
    INCEPTION_DATE       AS SBMS_INCEPTION_DATE,
    INSRD_PERIOD_START   AS SBMS_START_DATE,
    INSRD_PERIOD_END     AS SBMS_EXPIRY_DATE,
    FRK_TYPE_OF_BUS,
    FRK_LC_STAT_CURR,
    FRK_BASICSTAT_CURR,
    LOB_REF_NM,
    INSURED_COUNTRY,
    FK_UNDERW_CURR,
    FK_BROKER,
    FK_CEDENT,
    FK_INSURED,
    FK_LC_STATUS_CURR,
    FK_PC_LIM_PREM,
    FK_PC_PREM
FROM BUS_STRUCT_REP
WHERE FRK_TYPE_OF_BUS IN ('PROPFAC', 'NONPROPFAC');


