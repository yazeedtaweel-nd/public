DECLARE @BusinessId nvarchar(50) = N'PUT_CONTRACT_ID_HERE';

SELECT
    b.IDENTIFIER              AS ContractId,
    ip.BUS_INS_PER_ID         AS InsuredPeriodId,
    occ.CODE                  AS OccupationCode,
    occ.NAME                  AS OccupationName
FROM SICS.BUSINESS AS b
INNER JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_BUSINESS = b.OBJECT_ID
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = bsr.FK_INS_PERIOD
INNER JOIN SICS.BUS_CLASSIFIC AS bc
    ON bc.OBJECT_ID = bsr.FK_SOC_CLASSIFIC
INNER JOIN SICS.REFERENCE_DATA AS occ
    ON occ.CODE = bc.FRK_REFIC52
   AND occ.SUBCLASS = 52
WHERE b.IDENTIFIER = @BusinessId
ORDER BY ip.BUS_INS_PER_ID, occ.CODE;
