-- IW assumed periods that already look "renewed"
SELECT
    b.IDENTIFIER,
    b.SUBCLASS AS BUS_SUBCLASS,
    ip.OBJECT_ID,
    ip.SUBCLASS AS IP_SUBCLASS,
    ip.BUS_INS_PER_ID,
    ip.I_PERIOD_FORMER_ID,
    ip.FRK_RENEWED_LCP,
    ip.FSK_RENEWED_LCP,
    ip.FRK_RENEW_OPTION,
    ip.IS_AUTO_RENEWED
FROM SICS.INSURED_PERIOD ip
JOIN SICS.BUSINESS b ON b.OBJECT_ID = ip.FK_BUSINESS
WHERE b.SUBCLASS = 6
  AND ip.FRK_RENEWED_LCP IS NOT NULL;

-- Same columns on OW OCC — expect FRK_RENEWED_LCP empty
SELECT
    b.IDENTIFIER,
    b.SUBCLASS,
    ip.OBJECT_ID,
    ip.FRK_RENEWED_LCP,
    ip.FRK_RENEW_OPTION,
    ip.IS_AUTO_RENEWED
FROM SICS.INSURED_PERIOD ip
JOIN SICS.BUSINESS b ON b.OBJECT_ID = ip.FK_BUSINESS
WHERE b.SUBCLASS IN (3, 8, 11)
  AND (
        ip.FRK_RENEWED_LCP IS NOT NULL
     OR ip.IS_AUTO_RENEWED = N'Y'
  );
