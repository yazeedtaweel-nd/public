SELECT
    c.OBJECT_ID           AS sics_object_id,
    c.ISO_ALPHA_2         AS ctry_country_code,
    c.NAME                AS ctry_country_name,
    c.IS_ACTIVE           AS is_active,
    sre.<REGION_CODE>     AS ctry_sre_region_code,
    sre.<REGION_NAME>     AS ctry_sre_region_name
FROM dbo.LEGAL_AREA AS c
LEFT JOIN sre.<SRE_REGION_TABLE> AS sre
       ON sre.<COUNTRY_KEY> = c.OBJECT_ID
       /* or: ON sre.<COUNTRY_KEY> = c.ISO_ALPHA_2 */
WHERE c.SUBCLASS = 1
ORDER BY c.ISO_ALPHA_2, c.NAME;


SELECT
    c.OBJECT_ID     AS sics_object_id,
    c.ISO_ALPHA_2   AS ctry_country_code,
    c.NAME          AS ctry_country_name,
    c.IS_ACTIVE     AS is_active
FROM dbo.LEGAL_AREA AS c
WHERE c.SUBCLASS = 1
  AND c.IS_ACTIVE = 'Y'      -- optional; currently all 249 are Y
ORDER BY c.ISO_ALPHA_2, c.NAME;
