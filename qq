SELECT OBJECT_ID, ISO_ALPHA_2, ISO_ALPHA_3, CODE, NAME, IS_ACTIVE
FROM LEGAL_AREA
WHERE SUBCLASS = 1
  AND (
        ISO_ALPHA_2 IN ('00', 'WW')
     OR CODE IN ('00', 'WW')
     OR NAME LIKE '%WORLD%'
      );

-- Q7: inactive counts
SELECT IS_ACTIVE, COUNT(*) AS cnt
FROM LEGAL_AREA
WHERE SUBCLASS = 1
GROUP BY IS_ACTIVE;
