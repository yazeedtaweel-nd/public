SELECT
    COUNT(*) AS peril_cession_rows,
    SUM(CASE WHEN c.OUR_EXPOSURE IS NOT NULL THEN 1 ELSE 0 END) AS n_our_exposure,
    SUM(CASE WHEN c.EXPOSURE IS NOT NULL THEN 1 ELSE 0 END) AS n_exposure,
    SUM(CASE WHEN c.CEDENT_EXPOSURE IS NOT NULL THEN 1 ELSE 0 END) AS n_cedent_exposure,
    SUM(CASE WHEN d.LIMIT_AMOUNT IS NOT NULL THEN 1 ELSE 0 END) AS n_limit_amount,
    SUM(CASE WHEN lim.AMOUNT IS NOT NULL THEN 1 ELSE 0 END) AS n_ann_agg_amount,
    SUM(CASE WHEN iper.PML_FACTOR IS NOT NULL THEN 1 ELSE 0 END) AS n_pml_factor,
    SUM(CASE WHEN rz.FK_COUNTRY IS NOT NULL THEN 1 ELSE 0 END) AS n_with_country,
    SUM(CASE WHEN iper.FK_RISKZONE IS NOT NULL THEN 1 ELSE 0 END) AS n_with_risk_zone,
    SUM(CASE WHEN iper.FRK_PERIL_TYPE IS NOT NULL THEN 1 ELSE 0 END) AS n_with_peril
FROM dbo.CESSION c
INNER JOIN dbo.INS_PERIL iper
    ON iper.OBJECT_ID = c.FK_INS_PERIL
LEFT JOIN dbo.RISK_ZONE rz
    ON rz.OBJECT_ID = iper.FK_RISKZONE
LEFT JOIN dbo.CESSION_PERIL_DETL d
    ON d.FK_CESSION = c.OBJECT_ID
   AND d.LIMIT_AMOUNT IS NOT NULL
LEFT JOIN dbo.SCOPE_OF_COVER soc
    ON soc.OBJECT_ID = c.FK_SOC
LEFT JOIN dbo.LIFE_CYCLE_PHASE lcp
    ON lcp.OBJECT_ID = soc.FK_LIFECYCLEP
LEFT JOIN dbo.INSURED_PERIOD ip
    ON ip.OBJECT_ID = lcp.FK_INS_PRD
LEFT JOIN dbo.LPC_LIM_PREM_COND lpc
    ON lpc.FK_INSURED_PERIOD = ip.OBJECT_ID
   AND lpc.FK_ANN_AGG_LIMIT IS NOT NULL
LEFT JOIN dbo.LPC_LIMIT lim
    ON lim.OBJECT_ID = lpc.FK_ANN_AGG_LIMIT
WHERE c.FK_INS_PERIL IS NOT NULL;
