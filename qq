SELECT
      g.EC_CODE                 AS TRCD_CODE_BK
    , g.EC_NAME
    , g.D_IS_LIQUID
    , COUNT(*)                  AS rows_cnt
FROM dbo.GL_T_ALL AS g
GROUP BY
      g.EC_CODE
    , g.EC_NAME
    , g.D_IS_LIQUID
ORDER BY
      g.EC_CODE
    , g.D_IS_LIQUID;
