SELECT
    u.USER_ID AS USR_LOGIN,
    LTRIM(RTRIM(ISNULL(u.FIRSTNAME, '')))
      + CASE
            WHEN LTRIM(RTRIM(ISNULL(u.FIRSTNAME, ''))) <> ''
             AND LTRIM(RTRIM(ISNULL(u.LASTNAME,  ''))) <> ''
            THEN ' '
            ELSE ''
        END
      + LTRIM(RTRIM(ISNULL(u.LASTNAME, ''))) AS USR_USER_NAME,
    CAST(NULL AS VARCHAR(5))  AS USR_INITIALS,
    CAST(NULL AS VARCHAR(50)) AS USR_SYN_NUMBER,
    c.NAME                    AS USR_USER_GROUP,
    CAST(NULL AS VARCHAR(12)) AS USR_LOCATION_CODE,
    CAST('N' AS CHAR(1))      AS USR_UNDERWRITER_IND,
    CASE WHEN u.IS_ACTIVE = 'N' THEN 'Y' ELSE 'N' END AS USR_DELETED_IND
FROM CNU_USER AS u
LEFT JOIN USER_USERCATEGORY AS ju
    ON ju.FK_USER = u.OBJECT_ID
LEFT JOIN USER_CATEGORY AS c
    ON c.OBJECT_ID = ju.FK_USERCATEGORY
