```sql
SELECT
    COALESCE(pid.IDENTIFIER, p.IDENTIFIER) AS BROK_BK,
    COALESCE(n.NAME, p.CURR_NAME)          AS BROK_NAME,
    CASE bpc.FRK_CATEGORY
        WHEN 'B'    THEN 'I'
        WHEN 'BOUT' THEN 'O'
    END                                    AS BROKE_TYPE,
    a.ADDR_LINE_1                          AS BROK_ADDRESS_LINE1,
    a.ADDR_LINE_2                          AS BROK_ADDRESS_LINE2,
    a.ADDR_LINE_3                          AS BROK_ADDRESS_LINE3,
    a.CITY_NAME                            AS BROK_ADDRESS_CITY,
    CAST(NULL AS VARCHAR(45))              AS BROK_ADDRESS_STATE,
    ctry.ISO_ALPHA_2                       AS CTRY_CODE,
    ctry.NAME                              AS CTRY_NAME
FROM SICS.PARTY AS p
INNER JOIN SICS.BUS_PARTNER_CAT AS bpc
    ON bpc.FK_PARTNER = p.OBJECT_ID
   AND bpc.FSK_CATEGORY = 23
   AND bpc.FRK_CATEGORY IN ('B', 'BOUT')
LEFT JOIN (
    SELECT
        FK_PARTY,
        IDENTIFIER,
        ROW_NUMBER() OVER (PARTITION BY FK_PARTY ORDER BY OBJECT_ID) AS RN
    FROM SICS.PARTY_IDENTIFIER
    WHERE FRK_PARTY_ID_TYPE = 'FORMERID'
) AS pid
    ON pid.FK_PARTY = p.OBJECT_ID
   AND pid.RN = 1
LEFT JOIN (
    SELECT FK_ORGANISATION, NAME,
           ROW_NUMBER() OVER (PARTITION BY FK_ORGANISATION ORDER BY OBJECT_ID) AS RN
    FROM SICS.ORGANISATION_NAME
) AS n
    ON n.FK_ORGANISATION = p.OBJECT_ID
   AND n.RN = 1
LEFT JOIN (
    SELECT
        FK_PARTY,
        ADDR_LINE_1,
        ADDR_LINE_2,
        ADDR_LINE_3,
        CITY_NAME,
        ROW_NUMBER() OVER (
            PARTITION BY FK_PARTY
            ORDER BY
                CASE WHEN IS_MAIN_ADDR = 'Y' THEN 0 ELSE 1 END,
                CASE WHEN IS_HOME_ADDR = 'Y' THEN 0 ELSE 1 END,
                OBJECT_ID
        ) AS RN
    FROM SICS.ADDRESS
) AS a
    ON a.FK_PARTY = p.OBJECT_ID
   AND a.RN = 1
LEFT JOIN SICS.LEGAL_AREA AS ctry
    ON ctry.OBJECT_ID = p.FK_HOME_COUNTRY
   AND ctry.SUBCLASS = 1
WHERE p.SUBCLASS = 4
ORDER BY BROK_BK;
```

`BROKE_TYPE` is `I` when category is `B`, and `O` when it is `BOUT`.
