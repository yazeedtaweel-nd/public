WITH ws_balance AS (
    SELECT DISTINCT
        d.FK_WORKSHEET,
        b.OBJECT_ID,
        b.LEDGER_BAL_ORG_AMT
    FROM SICS.AC_LEDGER_DETAIL AS d
    INNER JOIN SICS.AC_LEDGER_BALANCE AS b
            ON b.OBJECT_ID = d.FK_BALANCE
    WHERE d.FK_WORKSHEET IS NOT NULL
)
SELECT
    w.OBJECT_ID                         AS sics_object_id,
    CONVERT(varchar(8), w.BOOKING_DATE, 112)
        + '|' + CAST(w.ID_SERIE_NO AS varchar(20))
                                        AS WRKS_BK,
    w.BOOKING_DATE                      AS WRKS_DATE,
    w.ID_SERIE_NO                       AS WRKS_NO,
    ROW_NUMBER() OVER (
        PARTITION BY w.BOOKING_DATE
        ORDER BY w.ID_SERIE_NO, w.OBJECT_ID
    )                                   AS WRKS_INDICATOR,
    SUM(b.LEDGER_BAL_ORG_AMT)           AS WRKS_CASH_TOTAL_AMT
FROM SICS.AC_WORKSHEET AS w
LEFT JOIN ws_balance AS b
       ON b.FK_WORKSHEET = w.OBJECT_ID
GROUP BY
    w.OBJECT_ID,
    w.BOOKING_DATE,
    w.ID_SERIE_NO
ORDER BY
    w.BOOKING_DATE,
    w.ID_SERIE_NO;
