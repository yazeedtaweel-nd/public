SELECT 'ACC_CLASSIFIC' AS tbl, COUNT(*) AS n FROM ACC_CLASSIFIC
UNION ALL SELECT 'ACC_CLASSIFIC with FK_IR_COUNTRY', COUNT(*) FROM ACC_CLASSIFIC WHERE FK_IR_COUNTRY IS NOT NULL
UNION ALL SELECT 'IO_GENERAL', COUNT(*) FROM IO_GENERAL
UNION ALL SELECT 'IO_GENERAL with FK_RISK_ZONE', COUNT(*) FROM IO_GENERAL WHERE FK_RISK_ZONE IS NOT NULL
UNION ALL SELECT 'LIGHT_ACC_CLASSIF', COUNT(*) FROM LIGHT_ACC_CLASSIF
UNION ALL SELECT 'REFERENCE_DATA subclass 44 (peril)', COUNT(*) FROM REFERENCE_DATA WHERE SUBCLASS = 44;
UNION ALL SELECT 'CNU_CURRENCY', COUNT(*) FROM CNU_CURRENCY
UNION ALL SELECT 'LEGAL_AREA', COUNT(*) FROM LEGAL_AREA
ORDER BY tbl;
