SELECT
    PTRM_BK,
    PTRM_NAME,
    CREATED_DATE_SRGT,
    UPDATED_DATE_SRGT,
    COUNT(*) AS ROW_CNT
FROM SaudiRe_DW.DIM_POLICY_TERM
GROUP BY
    PTRM_BK,
    PTRM_NAME,
    CREATED_DATE_SRGT,
    UPDATED_DATE_SRGT
ORDER BY ROW_CNT DESC;
