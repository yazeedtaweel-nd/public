SELECT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK,
    CAST(rd.CODE AS nvarchar(50)) AS PRMQ_BK,
    cond.FK_MAIN_CURRENCY AS CURR_ORIGIN_BK,
    CAST(N'SAR' AS nvarchar(3)) AS CURR_BASE_BK,
    CAST(NULL AS decimal(38, 4)) AS PRE_AMOUNT_BASE,
    CAST(prem.INSURED_AMOUNT AS decimal(38, 4)) AS PRE_AMOUNT_ORIGIN
FROM SICS.LPC_PREMIUM AS prem
INNER JOIN SICS.LPC_LIM_PREM_COND AS cond
    ON cond.OBJECT_ID = prem.FK_CONDITION
INNER JOIN SICS.REFERENCE_DATA AS rd
    ON rd.SUBCLASS = 134
   AND rd.CODE = cond.FRK_REF_PREM_TYPE
LEFT JOIN SICS.BUS_COND_CONTAINER AS bcc
    ON bcc.OBJECT_ID = cond.FK_COND_CONTAINER
LEFT JOIN SICS.SCOPE_OF_COVER AS soc
    ON soc.OBJECT_ID = bcc.FK_SOC
LEFT JOIN SICS.LIFE_CYCLE_PHASE AS lcp
    ON lcp.OBJECT_ID = soc.FK_LIFECYCLEP
OUTER APPLY (
    SELECT TOP (1) cur.FK_INS_PRD
    FROM SICS.LIFE_CYCLE_PHASE AS cur
    WHERE cur.FK_SCOPE_OF_CVR = soc.OBJECT_ID
      AND cur.FK_INS_PRD IS NOT NULL
    ORDER BY CASE WHEN cur.IS_CURRENT = N'Y' THEN 0 ELSE 1 END, cur.OBJECT_ID
) AS cur_lcp
OUTER APPLY (
    SELECT TOP (1) bsr.FK_INS_PERIOD
    FROM SICS.BUS_STRUCT_REP AS bsr
    WHERE bsr.FK_PC_LIM_PREM = cond.OBJECT_ID
      AND bsr.FK_INS_PERIOD IS NOT NULL
    ORDER BY CASE WHEN bsr.IS_CURRENT_LCP = N'Y' THEN 0 ELSE 1 END, bsr.OBJECT_ID
) AS rep
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = COALESCE(
           cond.FK_INSURED_PERIOD,
           lcp.FK_INS_PRD,
           cur_lcp.FK_INS_PRD,
           rep.FK_INS_PERIOD
       )
WHERE COALESCE(
          NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
          NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL;
