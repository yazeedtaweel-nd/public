SELECT
    u.USER_ID,
    c.NAME AS USER_CATEGORY_NAME
FROM dbo.CNU_USER AS u
INNER JOIN dbo.USER_USERCATEGORY AS ju
    ON ju.FK_USER = u.OBJECT_ID
INNER JOIN dbo.USER_CATEGORY AS c
    ON c.OBJECT_ID = ju.FK_USERCATEGORY
ORDER BY u.USER_ID, c.NAME;SELECT
    u.USER_ID,
    c.NAME AS USER_CATEGORY_NAME
FROM dbo.CNU_USER AS u
INNER JOIN dbo.USER_USERCATEGORY AS ju
    ON ju.FK_USER = u.OBJECT_ID
INNER JOIN dbo.USER_CATEGORY AS c
    ON c.OBJECT_ID = ju.FK_USERCATEGORY
ORDER BY u.USER_ID, c.NAME;


SELECT
    USER_ID,
    FIRSTNAME,
    LASTNAME,
    SHORTNAME,
    IS_ACTIVE,
    EXPIRY_DATE,
    FK_RU,
    OBJECT_ID
FROM dbo.CNU_USER
ORDER BY USER_ID;
