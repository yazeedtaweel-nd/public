WITH T0 AS (
SELECT [PRI_CPD_POLICY_REF] IW_POLICY_BK
      ,[PRI_CPD_VERSION_NO] IW_POLICY_VERSION_NO
      ,[PRI_SEQUENCE_NO]
      ,[PRI_RPD_POLICY_REF] OW_POLICY_BK
      ,[PRI_CALC_SEQUENCE_NO]
      ,[PRI_CEDED_PCNT]
      ,[PRI_POLICY_TYPE]
  FROM [SYN1].[dbo].[POLICY_REINSURANCE_LINK]
)
, T1 AS (
SELECT T0.*
FROM T0 
		JOIN (SELECT IW_POLICY_BK, MAX(IW_POLICY_VERSION_NO) AS IW_POLICY_VERSION_NO
				FROM T0
				GROUP BY IW_POLICY_BK
			 ) T1
			 ON T1.IW_POLICY_BK=T0.IW_POLICY_BK AND T1.IW_POLICY_VERSION_NO=T0.IW_POLICY_VERSION_NO
)
SELECT DISTINCT N'PROP' AS LINK_TYPE, OWP.POLICY_SRGT AS OW_POLICY_SRGT, IWP.POLICY_SRGT AS IW_POLICY_SRGT
FROM T1
		JOIN [SaudiRe_DW].dbo.DIM_POLICY IWP
			ON IWP.POLICY_BK COLLATE Latin1_General_CI_AS = T1.IW_POLICY_BK COLLATE Latin1_General_CI_AS
		JOIN [SaudiRe_DW].dbo.DIM_POLICY OWP
			ON OWP.POLICY_BK COLLATE Latin1_General_CI_AS = T1.OW_POLICY_BK COLLATE Latin1_General_CI_AS
