WITH zone_country AS (
    SELECT
        rz.OBJECT_ID  AS zone_id,
        rz.FK_COUNTRY AS country_id,
        rz.FK_PARENT  AS next_ancestor
    FROM SICS.RISK_ZONE rz

    UNION ALL

    SELECT
        zc.zone_id,
        anc.FK_COUNTRY,
        anc.FK_PARENT
    FROM zone_country zc
    JOIN SICS.RISK_ZONE anc
        ON anc.OBJECT_ID = zc.next_ancestor
    WHERE zc.country_id IS NULL
)
SELECT 'extract_rows' AS metric, COUNT(*) AS cnt
FROM zone_country zc
WHERE zc.country_id IS NOT NULL OR zc.next_ancestor IS NULL

UNION ALL
SELECT 'extract_distinct_zones', COUNT(DISTINCT zc.zone_id)
FROM zone_country zc
WHERE zc.country_id IS NOT NULL OR zc.next_ancestor IS NULL

UNION ALL
SELECT 'risk_zone_total', COUNT(*) FROM SICS.RISK_ZONE
OPTION (MAXRECURSION 0);
