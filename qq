/* DIM_TRANSACTION_CODE — read from SICS
   Do NOT use ENTRY_CODE.IS_PAYABLE as TRCD_IS_CASH
   Compare these candidates to DW TRCD_IS_CASH (1/0)
*/

SELECT
      e.CODE                                            AS TRCD_CODE_BK
    , e.DESCRIPTION                                     AS TRCD_CODE_DESCRIPTION
    , e.NAME                                            AS TRCD_CODE_NAME

    /* Candidate 1: Entry Sub Category (REFERENCE_DATA subclass 166) */
    , e.FRK_ENTRY_SUB_CAT                               AS SUB_CAT_CODE
    , sc.NAME                                           AS SUB_CAT_NAME
    , sc.EXTERNAL_CODE                                  AS SUB_CAT_EXTERNAL_CODE

    /* Candidate 2: Entry Code Usage (subclass 1085) — one code can have many rows */
    , u.FRK_EC_USAGE_DATA                               AS USAGE_CODE
    , usg.NAME                                          AS USAGE_NAME

    /* Candidate 3: Entry Code Usage Detail (subclass 1086) */
    , d.FRK_EC_USAGE_DET                                AS USAGE_DET_CODE
    , usd.NAME                                          AS USAGE_DET_NAME

    /* Candidate 4: technical / estimate flags (not cash, but often used to split cash vs non-cash) */
    , e.IS_ALLOWED_ON_TEC                               AS IS_ALLOWED_ON_TEC
    , e.IS_FOR_EST_ONLY                                 AS IS_FOR_EST_ONLY
    , e.IS_ALLOWED_AS_EST                               AS IS_ALLOWED_AS_EST
    , e.IS_ACTIVE
FROM ENTRY_CODE AS e
LEFT JOIN REFERENCE_DATA AS sc
       ON sc.SUBCLASS = 166
      AND sc.CODE     = e.FRK_ENTRY_SUB_CAT
LEFT JOIN ENT_CODE_REF_DATA AS u
       ON u.FK_ENT_CODE = e.OBJECT_ID
LEFT JOIN REFERENCE_DATA AS usg
       ON usg.SUBCLASS = 1085
      AND usg.CODE     = u.FRK_EC_USAGE_DATA
LEFT JOIN EC_DETAIL_REF_DATA AS d
       ON d.FK_ENT_CODE = e.OBJECT_ID
LEFT JOIN REFERENCE_DATA AS usd
       ON usd.SUBCLASS = 1086
      AND usd.CODE     = d.FRK_EC_USAGE_DET
ORDER BY
      e.CODE
    , u.FRK_EC_USAGE_DATA
    , d.FRK_EC_USAGE_DET;
