DECLARE @BusinessOid nvarchar(32) = N'PASTE_BUSINESS_OBJECT_ID_HERE';
DECLARE @CurrentOnly char(1)      = 'N';  -- N first, so historic BSR rows also show

SELECT
    b.OBJECT_ID                         AS BUSINESS_OID,
    b.IDENTIFIER                        AS POLICY_CONTRACT_NUMBER,
    b.SUBCLASS,
    ip.OBJECT_ID                        AS INSURED_PERIOD_OID,
    ip.FK_BUSINESS,
    ip.I_PERIOD_FORMER_ID,
    ip.BUS_INS_PER_ID,
    ip.CREATE_TIMESTAMP                 AS POLICY_ENTRY_DATE_FROM_IP,
    ip.CHANGED_DATE,
    bsr.IS_CURRENT_LCP,
    bsr.IS_CURRENT_AM,
    bsr.SEQUENCE_NUMBER,
    bsr.INSRD_PERIOD_START,
    bsr.INSRD_PERIOD_END,
    am.AMNDMNT_NMBR,
    am.IS_AMND_COMP,
    am.AMND_COMP_DATE,
    am_user.USER_ID                     AS POLICY_CHECKED_BY_FROM_AMENDMENT,
    lcp.IS_CONT_REG_COMP,
    lcp.REG_COMP_DATE,
    lcp_user.USER_ID                    AS POLICY_CHECKED_BY_FROM_LCP
FROM SICS.BUS_STRUCT_REP AS bsr
INNER JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = bsr.FK_BUSINESS
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = bsr.FK_INS_PERIOD
LEFT JOIN SICS.AMENDMENT AS am
    ON am.OBJECT_ID = bsr.FK_AMENDMENT
LEFT JOIN SICS.LIFE_CYCLE_PHASE AS lcp
    ON lcp.OBJECT_ID = bsr.FK_LC_PHASE
LEFT JOIN SICS.CNU_USER AS am_user
    ON am_user.OBJECT_ID = am.FK_AMND_COMP_USER
LEFT JOIN SICS.CNU_USER AS lcp_user
    ON lcp_user.OBJECT_ID = lcp.FK_REG_COMP_USER
WHERE b.OBJECT_ID = @BusinessOid
  AND (
        @CurrentOnly <> 'Y'
        OR (bsr.IS_CURRENT_LCP = N'Y' AND bsr.IS_CURRENT_AM = N'Y')
      )
ORDER BY ip.CREATE_TIMESTAMP, bsr.SEQUENCE_NUMBER;
