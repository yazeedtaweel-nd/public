SELECT TOP (30)
    b.IDENTIFIER,
    ip.BUS_INS_PER_ID,
    la.ISO_ALPHA_2,
    la.CODE,
    la.NAME,
    ac.FK_IR_COUNTRY,
    ac.FK_I_COUNTRY
FROM LPC_LIM_PREM_COND lpc
INNER JOIN INSURED_PERIOD ip
    ON ip.OBJECT_ID = lpc.FK_INSURED_PERIOD
INNER JOIN BUSINESS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
LEFT JOIN ACC_CLASSIFIC ac
    ON ac.FK_BUS = b.OBJECT_ID
LEFT JOIN LEGAL_AREA la
    ON la.OBJECT_ID = ac.FK_IR_COUNTRY
WHERE lpc.FK_ANN_AGG_LIMIT IS NOT NULL
ORDER BY b.IDENTIFIER;

