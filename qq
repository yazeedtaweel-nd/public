SELECT
    COALESCE(NULLIF(LTRIM(RTRIM(rd.EXTERNAL_CODE)), N''), rd.CODE) AS CODE,
    rd.NAME,
    rd.EXTERNAL_CODE,
    rd.SUBCLASS,
    rd.IS_ACTIVE,
    rd.IS_DEFAULT,
    rd.IS_STATIC,
    rd.IS_USER_DEFINED
FROM SICS.REFERENCE_DATA AS rd
WHERE rd.SUBCLASS = 90
ORDER BY COALESCE(NULLIF(LTRIM(RTRIM(rd.EXTERNAL_CODE)), N''), rd.CODE);
