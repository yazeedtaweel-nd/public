SELECT
    c.CLAIM_IDENTIFIER                         AS CLGRP_BK,
    c.SHORT_DESCR                              AS CLGRP_LOSS_DETAILS,
    /* Confirm description transform with the team */
    CASE
        WHEN c.CLAIM_IDENTIFIER IS NOT NULL
             AND LTRIM(RTRIM(c.CLAIM_IDENTIFIER)) <> ''
        THEN c.CLAIM_IDENTIFIER + ' - ' + COALESCE(c.UPPERCASE_LOSSNAME, c.LOSS_NAME)
        ELSE COALESCE(c.UPPERCASE_LOSSNAME, c.LOSS_NAME)
    END                                        AS CLGRP_DESCRIPTION,
    c.LOSS_NAME                                AS CLGRP_DESCRIPTION_RAW,
    c.UPPERCASE_LOSSNAME                       AS CLGRP_DESCRIPTION_UPPER,
    c.LOSS_START_DT                            AS CLGRP_LOSS_DATE_FROM,
    c.LOSS_END_DT                              AS CLGRP_LOSS_DATE_TO,
    /* XL date is unconfirmed — compare candidates */
    c.ADD_CODE_DT                              AS CLGRP_XL_DATE_CANDIDATE_ADD_CODE,
    c.FX_DATE                                  AS CLGRP_XL_DATE_CANDIDATE_FX,
    c.IS_MARKET_LOSS                           AS CLGRP_MARKET_INDICATOR,
    /* Market code is unconfirmed */
    c.FRK_ADDIT_CODE                           AS CLGRP_MARKET_CODE_CANDIDATE,
    c.OBJECT_ID,
    c.SUBCLASS,
    ba.CREATED_WHEN,
    ba.UPDATED_WHEN
FROM dbo.CLAIMS AS c
LEFT JOIN dbo.BASE_AUDIT AS ba
    ON ba.FK_PARENT = c.OBJECT_ID
WHERE c.SUBCLASS = 6   -- Headline Loss (SicsClaimAbstractHeadlineLoss)
ORDER BY c.CLAIM_IDENTIFIER;
