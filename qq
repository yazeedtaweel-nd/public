SELECT
    c.CLAIM_IDENTIFIER AS CLGRP_BK,
    CASE WHEN r.OBJECT_ID IS NOT NULL THEN 'Y' ELSE 'N' END AS CLGRP_MARKET_INDICATOR,
    r.REFERENCE_ID AS CLGRP_MARKET_CODE,
    r.FRK_REF_TYPE,
    c.M_FGU_REVIEW AS M_FGU_REVIEW_ALT,
    ud.BOOLEAN01,
    ud.BOOLEAN02,
    ud.BOOLEAN03
FROM SICS.CLAIMS AS c
LEFT JOIN SICS.CL_HLOSS_REF AS r
    ON r.FK_PARENT = c.OBJECT_ID
LEFT JOIN SICS.USER_DEF_DATA AS ud
    ON ud.OBJECT_ID = c.FK_UDEF_DATA
WHERE c.SUBCLASS = 6
ORDER BY c.CLAIM_IDENTIFIER;
