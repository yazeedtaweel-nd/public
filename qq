SELECT
    c.CLAIM_IDENTIFIER,
    c.LOSS_NAME,
    cr.REFERENCE_ID      AS FORMER_CLAIM_ID,
    cr.UPPERREF_ID       AS FORMER_CLAIM_ID_UPPER,
    rd.CODE              AS REF_TYPE_CODE,
    rd.NAME              AS REF_TYPE_NAME,
    cr.FK_SOC_REL,
    scr.FK_CLAIM,
    cr.OBJECT_ID         AS CLAIM_REF_OID
FROM dbo.CLAIM_REFS AS cr
INNER JOIN dbo.REFERENCE_DATA AS rd
    ON  rd.CODE     = cr.FRK_CLM_REF_TYPE
    AND rd.SUBCLASS = 548
INNER JOIN dbo.SOC_TO_CLAIM_REL AS scr
    ON  scr.OBJECT_ID = cr.FK_SOC_REL
INNER JOIN dbo.CLAIMS AS c
    ON  c.OBJECT_ID = scr.FK_CLAIM
WHERE cr.FK_SOC_REL IS NOT NULL
  AND NULLIF(LTRIM(RTRIM(cr.REFERENCE_ID)), '') IS NOT NULL
  AND (
        rd.NAME LIKE N'%Former Claim%'
     OR rd.NAME LIKE N'%Former%Ident%'
     OR rd.CODE IN (N'FCI', N'FORMER')   -- adjust after query 1
      )
ORDER BY c.CLAIM_IDENTIFIER, cr.REFERENCE_ID;
