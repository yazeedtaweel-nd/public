
SELECT
    ip.FSK_TERM_OPT,
    ip.FRK_TERM_OPT,
    rd.CODE          AS REF_CODE,
    rd.NAME          AS REF_NAME,
    rd.EXTERNAL_CODE,
    rd.IS_ACTIVE,
    COUNT(*)         AS IP_CNT,
    CAST(100.0 * COUNT(*) / SUM(COUNT(*)) OVER () AS DECIMAL(6,2)) AS PCT
FROM INSURED_PERIOD AS ip
LEFT JOIN REFERENCE_DATA AS rd
       ON rd.SUBCLASS = ip.FSK_TERM_OPT
      AND rd.CODE     = ip.FRK_TERM_OPT
GROUP BY
    ip.FSK_TERM_OPT,
    ip.FRK_TERM_OPT,
    rd.CODE,
    rd.NAME,
    rd.EXTERNAL_CODE,
    rd.IS_ACTIVE
ORDER BY IP_CNT DESC;



