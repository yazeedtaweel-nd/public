SELECT
    p.IDENTIFIER                                            AS COMP_BK,
    p.CURR_NAME                                             AS party_curr_name,
    org.SUBCLASS                                            AS org_name_subclass,
    org.NAME                                                AS org_name,
    org.FULL_NAME                                           AS org_full_name,
    org.SHORT_NAME                                          AS org_short_name,
    CASE WHEN p.CURR_NAME = org.NAME      THEN 1 ELSE 0 END AS curr_eq_name,
    CASE WHEN p.CURR_NAME = org.FULL_NAME THEN 1 ELSE 0 END AS curr_eq_full_name,
    LEN(p.CURR_NAME)                                        AS curr_len,
    LEN(org.NAME)                                           AS name_len,
    LEN(org.FULL_NAME)                                      AS full_name_len
FROM dbo.PARTY p
LEFT JOIN dbo.ORGANISATION_NAME org
       ON org.FK_ORGANISATION = p.OBJECT_ID
WHERE p.SUBCLASS = 4
ORDER BY p.IDENTIFIER, org.SUBCLASS, org.NAME;
-- Q1 summary: which name column matches CURR_NAME, and how many name rows per BP
SELECT
    org.SUBCLASS,
    COUNT(*)                                                    AS org_rows,
    SUM(CASE WHEN p.CURR_NAME = org.NAME      THEN 1 ELSE 0 END) AS curr_eq_name,
    SUM(CASE WHEN p.CURR_NAME = org.FULL_NAME THEN 1 ELSE 0 END) AS curr_eq_full_name,
    SUM(CASE WHEN p.CURR_NAME = org.SHORT_NAME THEN 1 ELSE 0 END) AS curr_eq_short_name,
    COUNT(DISTINCT p.OBJECT_ID)                                 AS distinct_parties
FROM dbo.PARTY p
JOIN dbo.ORGANISATION_NAME org
  ON org.FK_ORGANISATION = p.OBJECT_ID
WHERE p.SUBCLASS = 4
GROUP BY org.SUBCLASS
ORDER BY org.SUBCLASS;
SELECT
    name_row_cnt,
    COUNT(*) AS parties
FROM (
    SELECT p.OBJECT_ID, COUNT(org.OBJECT_ID) AS name_row_cnt
    FROM dbo.PARTY p
    LEFT JOIN dbo.ORGANISATION_NAME org ON org.FK_ORGANISATION = p.OBJECT_ID
    WHERE p.SUBCLASS = 4
    GROUP BY p.OBJECT_ID
) x
GROUP BY name_row_cnt
ORDER BY name_row_cnt;
