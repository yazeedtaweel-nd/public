SELECT
    MIN(PML_FACTOR) AS min_pml,
    MAX(PML_FACTOR) AS max_pml,
    AVG(PML_FACTOR) AS avg_pml,
    COUNT(*) AS n
FROM dbo.INS_PERIL
WHERE PML_FACTOR IS NOT NULL;
