/* ============================================================
   002_seed_party_package.sql — Party Package registration

   Seeds audit.ETL_PACKAGE + audit.ETL_PACKAGE_TABLE for the
   Party Package (DimParty.dtsx) and its six dimension loads.

   Re-runnable: inserts the package if missing, then MERGE-upserts
   the table rows. Does not touch execution / error history.

   Apply after 01_etl_control.sql (audit schema + control tables).
   ============================================================ */

SET NOCOUNT ON;
GO

IF NOT EXISTS (
    SELECT 1
    FROM   audit.ETL_PACKAGE
    WHERE  PACKAGE_NAME = N'PARTY_PACKAGE'
)
BEGIN
    INSERT INTO audit.ETL_PACKAGE
        (PACKAGE_NAME, PACKAGE_FILE_NAME, EXECUTION_ORDER, IS_ENABLED, DESCRIPTION)
    VALUES
        (N'PARTY_PACKAGE',
         N'DimParty.dtsx',
         10,
         1,
         N'Party package: Country, User, CRESTA zone, Company, Broker, Original Insured.');
END
ELSE
BEGIN
    UPDATE audit.ETL_PACKAGE
    SET    PACKAGE_FILE_NAME = N'DimParty.dtsx',
           EXECUTION_ORDER   = 10,
           IS_ENABLED        = 1,
           DESCRIPTION       = N'Party package: Country, User, CRESTA zone, Company, Broker, Original Insured.'
    WHERE  PACKAGE_NAME = N'PARTY_PACKAGE';
END
GO

DECLARE @PackageId INT =
    (SELECT PACKAGE_ID FROM audit.ETL_PACKAGE WHERE PACKAGE_NAME = N'PARTY_PACKAGE');

IF @PackageId IS NULL
BEGIN
    RAISERROR(N'PARTY_PACKAGE was not found in audit.ETL_PACKAGE after seed.', 16, 1);
END
ELSE
BEGIN
    ;WITH src AS (
        SELECT *
        FROM (VALUES
            (N'COUNTRY',
             N'SICS.dbo.LEGAL_AREA',
             N'dbo.DIM_COUNTRY',
             N'LEGAL_AREA WHERE SUBCLASS = 1 (SicsCountry).'),
            (N'USER',
             N'SICS.dbo.CNU_USER',
             N'dbo.DIM_USER',
             N'CNU_USER joined to RU_LEAF via FK_RU.'),
            (N'CRESTA_ZONE',
             N'SICS.dbo.RISK_ZONE',
             N'dbo.DIM_CRESTA_ZONE',
             N'RISK_ZONE joined to LEGAL_AREA via FK_COUNTRY.'),
            (N'COMPANY',
             N'SICS.dbo.PARTY',
             N'dbo.DIM_COMPANY',
             N'PARTY SUBCLASS = 4 (SicsBusinessPartner) plus organisation name / address.'),
            (N'BROKER',
             N'SICS.dbo.PARTY',
             N'dbo.DIM_BROKER',
             N'PARTY SUBCLASS = 4 filtered to broker business-partner category.'),
            (N'ORIGINAL_INSURED',
             N'SICS.dbo.PARTY',
             N'dbo.DIM_ORIGINAL_INSURED',
             N'PARTY SUBCLASS = 4 AND IS_INSURED = Y.')
        ) AS v (TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, DESCRIPTION)
    )
    MERGE audit.ETL_PACKAGE_TABLE AS t
    USING src
       ON t.PACKAGE_ID = @PackageId
      AND t.TABLE_NAME = src.TABLE_NAME
    WHEN MATCHED THEN
        UPDATE SET
            SOURCE_OBJECT = src.SOURCE_OBJECT,
            TARGET_OBJECT = src.TARGET_OBJECT,
            DESCRIPTION   = src.DESCRIPTION,
            IS_ENABLED    = 1
    WHEN NOT MATCHED THEN
        INSERT (PACKAGE_ID, TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, IS_ENABLED, DESCRIPTION)
        VALUES (@PackageId, src.TABLE_NAME, src.SOURCE_OBJECT, src.TARGET_OBJECT, 1, src.DESCRIPTION);
END
GO
