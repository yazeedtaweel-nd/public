SELECT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK,
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(rd.EXTERNAL_CODE)), N''),
            rd.CODE
        ) AS nvarchar(50)
    ) AS LMTQ_BK,
    cond.FK_MAIN_CURRENCY AS CURR_ORIGIN_BK,
    b.FK_FUNCTIONAL_CCY AS CURR_BASE_BK,
    CAST(
        CASE
            WHEN rd.CODE = N'TSI' OR rd.EXTERNAL_CODE = N'TSI' THEN lim.AMOUNT
        END AS decimal(38, 4)
    ) AS PLI_SI_AMOUNT_ORIGIN,
    CAST(
        CASE
            WHEN (rd.CODE = N'TSI' OR rd.EXTERNAL_CODE = N'TSI')
             AND cond.FK_MAIN_CURRENCY = b.FK_FUNCTIONAL_CCY
                THEN lim.AMOUNT
        END AS decimal(38, 4)
    ) AS PLI_SI_AMOUNT_BASE,
    CAST(lim.AMOUNT AS decimal(38, 4)) AS PLI_AMOUNT_ORIGIN,
    CAST(
        CASE
            WHEN cond.FK_MAIN_CURRENCY = b.FK_FUNCTIONAL_CCY THEN lim.AMOUNT
        END AS decimal(38, 4)
    ) AS PLI_AMOUNT_BASE,
    CONVERT(int, CONVERT(char(8), GETDATE(), 112)) AS CREATED_DATE_SRGT,
    CONVERT(int, CONVERT(char(8), GETDATE(), 112)) AS UPDATED_DATE_SRGT
FROM SICS.LPC_LIMIT AS lim
INNER JOIN SICS.REFERENCE_DATA AS rd
    ON rd.SUBCLASS = 1001
   AND rd.CODE = lim.FRK_OPTIONAL_FIELD
INNER JOIN SICS.LPC_LIM_PREM_COND AS cond
    ON cond.OBJECT_ID = lim.FK_CONDITION
LEFT JOIN SICS.BUS_COND_CONTAINER AS bcc
    ON bcc.OBJECT_ID = cond.FK_COND_CONTAINER
LEFT JOIN SICS.SCOPE_OF_COVER AS soc
    ON soc.OBJECT_ID = bcc.FK_SOC
LEFT JOIN SICS.LIFE_CYCLE_PHASE AS lcp
    ON lcp.OBJECT_ID = soc.FK_LIFECYCLEP
OUTER APPLY (
    SELECT TOP (1) cur.FK_INS_PRD
    FROM SICS.LIFE_CYCLE_PHASE AS cur
    WHERE cur.FK_SCOPE_OF_CVR = soc.OBJECT_ID
      AND cur.FK_INS_PRD IS NOT NULL
    ORDER BY CASE WHEN cur.IS_CURRENT = N'Y' THEN 0 ELSE 1 END, cur.OBJECT_ID
) AS cur_lcp
OUTER APPLY (
    SELECT TOP (1) bsr.FK_INS_PERIOD
    FROM SICS.BUS_STRUCT_REP AS bsr
    WHERE bsr.FK_PC_LIM_PREM = cond.OBJECT_ID
      AND bsr.FK_INS_PERIOD IS NOT NULL
    ORDER BY CASE WHEN bsr.IS_CURRENT_LCP = N'Y' THEN 0 ELSE 1 END, bsr.OBJECT_ID
) AS rep
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = COALESCE(
           cond.FK_INSURED_PERIOD,
           lcp.FK_INS_PRD,
           cur_lcp.FK_INS_PRD,
           rep.FK_INS_PERIOD
       )
LEFT JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
WHERE  COALESCE(
          NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
          NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL;
