SELECT TOP (50)
    b.IDENTIFIER            AS business_id,
    c.FK_CURRENCY           AS cession_orig_ccy,
    curr_o.ISO_ALPHA        AS orig_iso,
    curr_o.DESCRIPTION      AS orig_name,
    b.FK_FUNCTIONAL_CCY     AS business_func_ccy,
    curr_f.ISO_ALPHA        AS func_iso,
    b.FK_FUNCTIONAL_CCY2    AS business_func_ccy2,
    curr_f2.ISO_ALPHA       AS func2_iso,
    c.OUR_EXPOSURE          AS our_exposure
FROM dbo.CESSION c
INNER JOIN dbo.INS_PERIL iper
    ON iper.OBJECT_ID = c.FK_INS_PERIL
LEFT JOIN dbo.CNU_CURRENCY curr_o
    ON curr_o.ISO_ALPHA = c.FK_CURRENCY
LEFT JOIN dbo.SCOPE_OF_COVER soc
    ON soc.OBJECT_ID = c.FK_SOC
LEFT JOIN dbo.LIFE_CYCLE_PHASE lcp
    ON lcp.OBJECT_ID = soc.FK_LIFECYCLEP
LEFT JOIN dbo.INSURED_PERIOD ip
    ON ip.OBJECT_ID = lcp.FK_INS_PRD
LEFT JOIN dbo.BUSINESS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
LEFT JOIN dbo.CNU_CURRENCY curr_f
    ON curr_f.ISO_ALPHA = b.FK_FUNCTIONAL_CCY
LEFT JOIN dbo.CNU_CURRENCY curr_f2
    ON curr_f2.ISO_ALPHA = b.FK_FUNCTIONAL_CCY2
WHERE c.FK_INS_PERIL IS NOT NULL
ORDER BY b.IDENTIFIER;


