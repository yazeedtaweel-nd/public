SELECT
    CASE LTRIM(RTRIM(rd.EXTERNAL_CODE))
        WHEN 'TP' THEN N'11'
        WHEN 'TN' THEN N'12'
        WHEN 'FP' THEN N'21'
        WHEN 'FN' THEN N'22'
    END AS PCLS_CLASS_CODE,
    CASE LTRIM(RTRIM(rd.EXTERNAL_CODE))
        WHEN 'TP' THEN N'TREATY PROPORTIONAL'
        WHEN 'TN' THEN N'TREATY XL'
        WHEN 'FP' THEN N'FACULTATIVE PROPORTIONAL'
        WHEN 'FN' THEN N'FACULTATIVE XL'
    END AS PCLS_CLASS_NAME,
    LEFT(LTRIM(RTRIM(rd.EXTERNAL_CODE)), 1) AS PCLS_REIN_IND,
    RIGHT(LTRIM(RTRIM(rd.EXTERNAL_CODE)), 1) AS PCLS_PROP_IND,
    N'I' AS PCLS_INDICATOR,
     CAST(CASE WHEN rd.IS_ACTIVE       = 'Y' THEN 1 ELSE 0 END AS BIT)  as  CNLT_IS_ACTIVE
FROM SICS.REFERENCE_DATA AS rd
WHERE rd.SUBCLASS = 46
  AND LTRIM(RTRIM(rd.EXTERNAL_CODE)) IN (N'TP', N'TN', N'FP', N'FN')
ORDER BY PCLS_CLASS_CODE;
