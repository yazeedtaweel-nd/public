SELECT TOP (50)
    b.IDENTIFIER                AS business_id,
    iper.PML_FACTOR             AS pml_factor,
    c.OUR_EXPOSURE              AS our_exposure,
    c.OUR_EXPOSURE * iper.PML_FACTOR / 100.0 AS pml_div_100,
    c.OUR_EXPOSURE * iper.PML_FACTOR        AS pml_times_raw,
    d.LIMIT_AMOUNT              AS limit_amount,
    d.LIMIT_AMOUNT * iper.PML_FACTOR / 100.0 AS limit_pml_div_100
FROM dbo.CESSION c
INNER JOIN dbo.INS_PERIL iper
    ON iper.OBJECT_ID = c.FK_INS_PERIL
LEFT JOIN dbo.CESSION_PERIL_DETL d
    ON d.FK_CESSION = c.OBJECT_ID
LEFT JOIN dbo.SCOPE_OF_COVER soc
    ON soc.OBJECT_ID = c.FK_SOC
LEFT JOIN dbo.LIFE_CYCLE_PHASE lcp
    ON lcp.OBJECT_ID = soc.FK_LIFECYCLEP
LEFT JOIN dbo.INSURED_PERIOD ip
    ON ip.OBJECT_ID = lcp.FK_INS_PRD
LEFT JOIN dbo.BUSINESS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
WHERE iper.PML_FACTOR IS NOT NULL
  AND c.OUR_EXPOSURE IS NOT NULL
ORDER BY iper.PML_FACTOR DESC;

