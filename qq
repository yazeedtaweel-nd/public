SELECT
    p.IDENTIFIER            AS BROK_BK,
    p.CURR_NAME             AS PARTY_CURR_NAME,
    n.NAME                  AS ORG_NAME,
    n.FULL_NAME             AS ORG_FULL_NAME,
    n.SHORT_NAME            AS ORG_SHORT_NAME,
    n.SUBCLASS              AS ORG_NAME_SUBCLASS,
    CASE
        WHEN p.CURR_NAME = n.NAME THEN 'CURR_NAME = NAME'
        WHEN p.CURR_NAME = n.FULL_NAME THEN 'CURR_NAME = FULL_NAME'
        WHEN p.CURR_NAME = n.SHORT_NAME THEN 'CURR_NAME = SHORT_NAME'
        ELSE 'NO MATCH'
    END                     AS MATCH_FLAG
FROM PARTY AS p
INNER JOIN BUS_PARTNER_CAT AS bpc
    ON bpc.FK_PARTNER = p.OBJECT_ID
   AND bpc.FSK_CATEGORY = 23
   AND bpc.FRK_CATEGORY IN ('B', 'BOUT')
LEFT JOIN ORGANISATION_NAME AS n
    ON n.FK_ORGANISATION = p.OBJECT_ID
WHERE p.SUBCLASS = 4
ORDER BY p.IDENTIFIER, n.SUBCLASS, n.OBJECT_ID;
