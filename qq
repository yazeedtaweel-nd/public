-- DIM_SUBMISSION source extract (quotation / lifecycle grain)
SELECT
    bsr.IDENTIFIER_CURR          AS SBM_BK,              -- Q... quotation id
    bsr.IDENTIFIER               AS SBM_CONTRACT_NUMBER, -- business id
    bsr.TITLE                    AS SBM_DESC,
    bsr.LAYER_NUMBER             AS SBM_LAYER,
    bsr.AMNDMNT_NMBR             AS SBM_END_NO,
    bsr.FRK_TYPE_OF_BUS          AS SBM_BUSINESS_INDICATOR_SRC,
    bsr.INCEPTION_DATE           AS SBM_INCEPTION_DATE,
    bsr.INSRD_PERIOD_START       AS SBM_VALID_FROM,
    bsr.INSRD_PERIOD_END         AS SBM_EXPIRY_DATE,
    bsr.IDENTIFIER               AS SBM_TAKEN_TO_REF_CANDIDATE,

    lcs.IDENTIFIER               AS LCS_IDENTIFIER,
    lcs.IS_CRNT_STATUS           AS SBM_IS_LATEST_VERSION_SRC,
    lcs.IS_CURRENT               AS SBM_IS_CURRENT_ALT,
    lcs.CHANGE_DATE              AS SBM_ENTRY_DATE,
    lcs.FRK_AGRBASICSTAT         AS BASIC_STATUS_CODE,
    lcs.FRK_AGRLCYCSTAT          AS LC_STATUS_CODE,
    lcp.SEQUENCE_NUMBER          AS SBM_VERSION_NO,

    uw.USER_ID                   AS SBM_ENTERED_BY,
    brok.IDENTIFIER              AS BROKER_BK,
    ced.IDENTIFIER               AS COMPANY_BK,
    ins.IDENTIFIER               AS OIN_BK,

    bsr.FK_BROKER,
    bsr.FK_CEDENT,
    bsr.FK_INSURED,
    bsr.FRK_LC_STAT_CURR,
    bsr.FRK_BASICSTAT_CURR
FROM BUS_STRUCT_REP bsr
LEFT JOIN LIFE_CYCLE_STATUS lcs
       ON lcs.OBJECT_ID = bsr.FK_LC_STATUS_CURR
LEFT JOIN LIFE_CYCLE_PHASE lcp
       ON lcp.OBJECT_ID = lcs.FK_LIFECYCLEPHASE   -- confirm FK name in your SICS
LEFT JOIN CNU_USER uw
       ON uw.OBJECT_ID = bsr.FK_UNDERW_CURR
LEFT JOIN PARTY brok
       ON brok.OBJECT_ID = bsr.FK_BROKER
LEFT JOIN PARTY ced
       ON ced.OBJECT_ID = bsr.FK_CEDENT
LEFT JOIN PARTY ins
       ON ins.OBJECT_ID = bsr.FK_INSURED
WHERE bsr.IDENTIFIER_CURR IS NOT NULL;   -- keep quotation rows
-- Optional: AND lcs.IS_CRNT_STATUS = 'Y'  -- latest version only
