SELECT TOP (1000)
    w.OBJECT_ID                         AS sics_object_id,
    w.IDENTIFIER,
    w.BOOKING_DATE                      AS wrks_date,
    w.ID_SERIE_NO                       AS wrks_no_candidate,
    CONVERT(varchar(8), w.BOOKING_DATE, 112)
        + '|' + CAST(w.ID_SERIE_NO AS varchar(20))
                                        AS wrks_bk_candidate,
    CASE
        WHEN SUM(CASE WHEN b.IS_OUTWARD = 'Y' THEN 1 ELSE 0 END) > 0
         AND SUM(CASE WHEN b.IS_OUTWARD = 'N' THEN 1 ELSE 0 END) = 0
            THEN 'O'
        WHEN SUM(CASE WHEN b.IS_OUTWARD = 'N' THEN 1 ELSE 0 END) > 0
         AND SUM(CASE WHEN b.IS_OUTWARD = 'Y' THEN 1 ELSE 0 END) = 0
            THEN 'I'
        WHEN SUM(CASE WHEN b.OBJECT_ID IS NOT NULL THEN 1 ELSE 0 END) = 0
            THEN NULL
        ELSE 'MIXED'
    END                                 AS wrks_indicator_candidate,  -- expect I/O; MIXED needs a rule
    SUM(b.LEDGER_BAL_ORG_AMT)           AS cash_total_org_amt,        -- candidate A
    SUM(b.AC_FUNC_AMT)                  AS cash_total_func_amt,       -- candidate B
    COUNT(b.OBJECT_ID)                  AS balance_count
FROM dbo.AC_WORKSHEET AS w
LEFT JOIN dbo.AC_LEDGER_BALANCE AS b
       ON b.FK_WORKSHEET = w.OBJECT_ID
      /* AND b.SUBCLASS IN (...)  -- add after Query 3 */
GROUP BY
    w.OBJECT_ID,
    w.IDENTIFIER,
    w.BOOKING_DATE,
    w.ID_SERIE_NO
ORDER BY w.BOOKING_DATE, w.ID_SERIE_NO;



