SELECT
    rz.CODE AS CRZ_BK,
    la.NAME + ' - ' + rz.NAME AS CRZ_NAME,
    ISNULL(la.ISO_ALPHA_2, la.CODE) AS CTRY_COUNTRY_CODE
FROM SICS.RISK_ZONE rz
JOIN SICS.RISK_ZONE rzc
    ON rzc.OBJECT_ID = rz.FK_PARENT
JOIN SICS.LEGAL_AREA la
    ON la.OBJECT_ID = rzc.FK_COUNTRY
   AND la.SUBCLASS = 1
WHERE rz.CODE IS NOT NULL
ORDER BY rz.CODE;
