DECLARE @BusinessOid nvarchar(32) = N'PASTE_BUSINESS_OBJECT_ID_HERE';
SELECT
    b.IDENTIFIER,
    ip.OBJECT_ID,
    ip.BUS_INS_PER_ID,
    ip.I_PERIOD_FORMER_ID,
    ip.CREATE_TIMESTAMP,          -- new POLICY_ENTRY_DATE
    bsr.INSRD_PERIOD_START,
    bsr.INSRD_PERIOD_END
FROM SICS.INSURED_PERIOD AS ip
INNER JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
LEFT JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_INS_PERIOD = ip.OBJECT_ID
   AND bsr.IS_CURRENT_LCP = N'Y'
   AND bsr.IS_CURRENT_AM  = N'Y'
WHERE ip.FK_BUSINESS = @BusinessOid
ORDER BY bsr.INSRD_PERIOD_START;
