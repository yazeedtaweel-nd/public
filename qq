SELECT TOP (50)
    b.IDENTIFIER,
    ip.BUS_INS_PER_ID,
    lim.AMOUNT AS ann_agg_amount,
    peril_cnt.n_peril_cessions
FROM dbo.INSURED_PERIOD ip
INNER JOIN dbo.BUSINESS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
INNER JOIN dbo.LPC_LIM_PREM_COND lpc
    ON lpc.FK_INSURED_PERIOD = ip.OBJECT_ID
   AND lpc.FK_ANN_AGG_LIMIT IS NOT NULL
INNER JOIN dbo.LPC_LIMIT lim
    ON lim.OBJECT_ID = lpc.FK_ANN_AGG_LIMIT
OUTER APPLY (
    SELECT COUNT(*) AS n_peril_cessions
    FROM dbo.LIFE_CYCLE_PHASE lcp
    INNER JOIN dbo.SCOPE_OF_COVER soc
        ON soc.FK_LIFECYCLEP = lcp.OBJECT_ID
    INNER JOIN dbo.CESSION c
        ON c.FK_SOC = soc.OBJECT_ID
       AND c.FK_INS_PERIL IS NOT NULL
    WHERE lcp.FK_INS_PRD = ip.OBJECT_ID
) peril_cnt
WHERE lim.AMOUNT IS NOT NULL
ORDER BY peril_cnt.n_peril_cessions ASC, b.IDENTIFIER;


