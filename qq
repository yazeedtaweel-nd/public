SELECT
      e.CODE                    AS TRCD_CODE_BK
    , b.IS_LIQUID
    , COUNT(*)                  AS rows_cnt
FROM dbo.AC_BOOK_DTL_INFO AS b
JOIN dbo.AC_LEDGER_DETAIL AS d ON d.OBJECT_ID     = b.OBJECT_ID
JOIN dbo.ENTRY_CODE       AS e ON e.OBJECT_ID     = d.FK_ENTRY_CODE
GROUP BY
      e.CODE
    , b.IS_LIQUID
ORDER BY
      e.CODE;


