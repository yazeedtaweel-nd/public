SELECT 'CESSION' AS tbl, COUNT(*) AS n FROM dbo.CESSION
UNION ALL SELECT 'CESSION_PERIL_DETL', COUNT(*) FROM dbo.CESSION_PERIL_DETL
UNION ALL SELECT 'INS_PERIL', COUNT(*) FROM dbo.INS_PERIL
UNION ALL SELECT 'RISK_ZONE', COUNT(*) FROM dbo.RISK_ZONE
UNION ALL SELECT 'LPC_LIM_PREM_COND', COUNT(*) FROM dbo.LPC_LIM_PREM_COND
UNION ALL SELECT 'LPC_LIM_PREM_COND with ANN_AGG', COUNT(*) FROM dbo.LPC_LIM_PREM_COND WHERE FK_ANN_AGG_LIMIT IS NOT NULL
UNION ALL SELECT 'LPC_LIMIT', COUNT(*) FROM dbo.LPC_LIMIT
UNION ALL SELECT 'SCOPE_OF_COVER', COUNT(*) FROM dbo.SCOPE_OF_COVER
UNION ALL SELECT 'INSURED_PERIOD', COUNT(*) FROM dbo.INSURED_PERIOD
UNION ALL SELECT 'BUSINESS', COUNT(*) FROM dbo.BUSINESS
UNION ALL SELECT 'CNU_CURRENCY', COUNT(*) FROM dbo.CNU_CURRENCY
UNION ALL SELECT 'LEGAL_AREA', COUNT(*) FROM dbo.LEGAL_AREA
ORDER BY tbl;
