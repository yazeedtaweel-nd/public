SELECT
    t.SUBCLASS_NUMBER,
    t.CODE,
    t.NAME,
    t.SYSTEM_NAME,
    t.IS_USER_DEFINED,
    t.IS_FOR_PC,
    t.IS_ACTIVE,
    COUNT(r.CODE) AS ROW_CNT
FROM SICS.REF_DATA_TYPE AS t
LEFT JOIN SICS.REFERENCE_DATA AS r
       ON r.SUBCLASS = t.SUBCLASS_NUMBER
WHERE t.SUBCLASS_NUMBER IN (50, 51, 52, 587, 588, 589, 590)
GROUP BY
    t.SUBCLASS_NUMBER,
    t.CODE,
    t.NAME,
    t.SYSTEM_NAME,
    t.IS_USER_DEFINED,
    t.IS_FOR_PC,
    t.IS_ACTIVE
ORDER BY t.SUBCLASS_NUMBER;
