SELECT
    ip.I_PERIOD_FORMER_ID,
    ip.BUS_INS_PER_ID,
    b.IDENTIFIER          AS POLICY_CONTRACT_NUMBER,
    b.SUBCLASS,
    b.FK_FUNCTIONAL_CCY   AS POLICY_CHOSEN_CURRENCY_FK,   -- FC1
    fc1.ISO_ALPHA         AS POLICY_CHOSEN_CURRENCY,      -- e.g. SAR, USD
    fc1.DESCRIPTION       AS POLICY_CHOSEN_CURRENCY_NAME,
    b.FK_FUNCTIONAL_CCY2  AS FUNCTIONAL_CCY2_FK,          -- FC2 (alternative)
    fc2.ISO_ALPHA         AS FUNCTIONAL_CCY2
FROM dbo.BUSINESS AS b
INNER JOIN dbo.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
LEFT JOIN dbo.CNU_CURRENCY AS fc1
    ON fc1.OBJECT_ID = b.FK_FUNCTIONAL_CCY
LEFT JOIN dbo.CNU_CURRENCY AS fc2
    ON fc2.OBJECT_ID = b.FK_FUNCTIONAL_CCY2
WHERE b.IDENTIFIER = :contract_number   -- or ip.I_PERIOD_FORMER_ID / BUS_INS_PER_ID
-- optional: IW only
-- AND b.SUBCLASS = 6
;
