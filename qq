SELECT
      e.CODE                    AS TRCD_CODE_BK
    , e.DESCRIPTION             AS TRCD_CODE_DESCRIPTION
    , e.FRK_ENTRY_SUB_CAT       AS sub_cat_code
    , sc.NAME                   AS sub_cat_name
    , CASE
          WHEN sc.NAME LIKE '%NON CASH%'
            OR sc.NAME LIKE '%NON-CASH%'
            OR sc.NAME LIKE '%NON LIQUID%'
            OR sc.NAME LIKE '%NON-LIQUID%'
            OR e.FRK_ENTRY_SUB_CAT IN ('NCLDEP','NCPDEP','NLTI')
               THEN 0
          ELSE 1
      END                       AS CANDIDATE_IS_CASH
FROM ENTRY_CODE AS e
LEFT JOIN REFERENCE_DATA AS sc
       ON sc.SUBCLASS = 166
      AND sc.CODE     = e.FRK_ENTRY_SUB_CAT
ORDER BY
      CANDIDATE_IS_CASH
    , e.CODE;


