/* ============================================================
   Q1–Q3: OW population, join grain, broker filter
   Run against SICS
   ============================================================ */
WITH broker_rel AS (
    SELECT
        r.OBJECT_ID,
        r.SUBCLASS              AS REL_SUBCLASS,
        r.FRK_RELSHIP_TYPE,
        r.FSK_RELSHIP_TYPE,
        r.CEASE,
        CASE WHEN r.FK_BUSINESS  IS NOT NULL THEN 1 ELSE 0 END AS HAS_FK_BUSINESS,
        CASE WHEN r.FK_INS_PERIOD IS NOT NULL THEN 1 ELSE 0 END AS HAS_FK_INS_PERIOD,
        COALESCE(b_direct.OBJECT_ID, b_via_ip.OBJECT_ID) AS BUSINESS_OID,
        COALESCE(b_direct.SUBCLASS,  b_via_ip.SUBCLASS)  AS BUS_SUBCLASS,
        COALESCE(b_direct.FRK_TYPE_OF_BUS, b_via_ip.FRK_TYPE_OF_BUS) AS TYPE_OF_BUS,
        COALESCE(b_direct.IDENTIFIER, b_via_ip.IDENTIFIER) AS BUSINESS_ID,
        p.IDENTIFIER AS BROKER_ID,
        p.CURR_NAME  AS BROKER_NAME
    FROM dbo.BUSINESS_PRTNR_REL r
    LEFT JOIN dbo.PARTY p
           ON p.OBJECT_ID = r.FK_BUS_PARTNER
    LEFT JOIN dbo.BUSINESS b_direct
           ON b_direct.OBJECT_ID = r.FK_BUSINESS
    LEFT JOIN dbo.INSURED_PERIOD ip
           ON ip.OBJECT_ID = r.FK_INS_PERIOD
    LEFT JOIN dbo.BUSINESS b_via_ip
           ON b_via_ip.OBJECT_ID = ip.FK_BUSINESS
    WHERE r.FSK_RELSHIP_TYPE = 55
      AND r.FRK_RELSHIP_TYPE = 'BR'          -- broker relationship
)
SELECT
    BUS_SUBCLASS,                            -- Q1: is OW = 11?
    TYPE_OF_BUS,                             -- Q1: Policy Ceded code?
    HAS_FK_BUSINESS,                         -- Q2
    HAS_FK_INS_PERIOD,                       -- Q2
    REL_SUBCLASS,                            -- Q3
    CEASE,                                   -- Q3
    COUNT(*)                         AS REL_CNT,
    COUNT(DISTINCT BUSINESS_OID)     AS POLICY_CNT,
    COUNT(DISTINCT BROKER_ID)       AS BROKER_CNT,
    AVG(1.0 * brokers_per_policy)   AS AVG_BROKERS_PER_POLICY
FROM broker_rel br
OUTER APPLY (
    SELECT COUNT(*) AS brokers_per_policy
    FROM broker_rel x
    WHERE x.BUSINESS_OID = br.BUSINESS_OID
) m
GROUP BY
    BUS_SUBCLASS, TYPE_OF_BUS,
    HAS_FK_BUSINESS, HAS_FK_INS_PERIOD,
    REL_SUBCLASS, CEASE
ORDER BY REL_CNT DESC;


