-- GET the list of IW Policy linked to each OW Policy with Percentage SPLIT
WITH T0 AS ( -- STEP 0 : Find the Retro Policy XL
SELECT DISTINCT RPD.RPD_POLICY_REFERENCE 
FROM REINSURANCE_POL_DET AS RPD
		JOIN POLICY_TYPE_CODES AS PTC
		ON PTC_POLICY_TYPE_CODE = RPD_REIN_POLICY_TYPE
WHERE PTC_RI_TYPE_CODE IN ('X','R')
),
T1 AS ( -- STEP 1 : GET THE LATEST VERSION OF THE SPLIT 
SELECT RCS.*
FROM REIN_COB_CODE_PREM_SPLIT RCS
	JOIN (
		SELECT RCS_RPD_POLICY_REF, RCS_SYN_PROCESSING, MAX(RCS_PRD_VERSION_NO) AS RCS_PRD_VERSION_NO
		FROM REIN_COB_CODE_PREM_SPLIT 
		GROUP BY RCS_RPD_POLICY_REF,RCS_SYN_PROCESSING
		) RCS_LV
	ON RCS.RCS_RPD_POLICY_REF = RCS_LV.RCS_RPD_POLICY_REF AND
	   RCS.RCS_SYN_PROCESSING = RCS_LV.RCS_SYN_PROCESSING AND
	   RCS.RCS_PRD_VERSION_NO = RCS_LV.RCS_PRD_VERSION_NO
	JOIN T0 ON T0.RPD_POLICY_REFERENCE=RCS.RCS_RPD_POLICY_REF -- Consider only Non Proportional
)
SELECT T1.RCS_RPD_POLICY_REF, T1.RCS_YEAR, T1.RCS_COB_CODE, T1.RCS_SUG_GROUP_CODE, T1.RCS_SYN_USER_NUMBER, SUM(T1.RCS_PREM_SPLIT_PCNT) AS RCS_PREM_SPLIT_PCNT
FROM T1
GROUP BY 
	T1.RCS_RPD_POLICY_REF, 
	T1.RCS_YEAR, 
	T1.RCS_COB_CODE, 
	T1.RCS_SUG_GROUP_CODE, 
	T1.RCS_SYN_USER_NUMBER
