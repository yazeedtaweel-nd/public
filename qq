-- Match DWH business keys back to SICS
SELECT
    d.CRZ_BK,
    d.CRZ_NAME AS dwh_name,
    rz.NAME AS sics_name,
    la.NAME AS sics_country_name,
    la.ISO_ALPHA_2,
    la.CODE AS la_code,
    d.CTRY_COUNTRY_CODE AS dwh_country_code,
    CASE WHEN d.CRZ_NAME = rz.NAME THEN 'NAME_direct'
         WHEN d.CRZ_NAME = la.NAME + ' - ' + rz.NAME THEN 'NAME_concat'
         ELSE 'NAME_other_rule'
    END AS name_rule,
    CASE WHEN d.CTRY_COUNTRY_CODE = la.ISO_ALPHA_2 THEN 'ISO_ALPHA_2'
         WHEN d.CTRY_COUNTRY_CODE = la.CODE THEN 'LEGAL_AREA_CODE'
         ELSE 'OTHER_or_NULL'
    END AS country_code_rule
FROM [SaudiRe_Dw].[dbo].[DIM_CRESTA_ZONE] d
LEFT JOIN RISK_ZONE rz
    ON rz.CODE = d.CRZ_BK
LEFT JOIN LEGAL_AREA la
    ON la.OBJECT_ID = rz.FK_COUNTRY
   AND la.SUBCLASS = 1
ORDER BY d.CRZ_SRGT;
