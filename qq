SELECT
    c.OBJECT_ID     AS sics_object_id,
    c.ISO_ALPHA_2   AS ctry_country_code,
    c.NAME          AS ctry_country_name,
    r.OBJECT_ID     AS region_object_id,
    r.CODE          AS region_code,
    r.NAME          AS region_name,
    r.FRK_AREA_GRP_CTGRY AS area_group_category,
    r.IS_ACTIVE     AS region_is_active
FROM SICS.LEGAL_AREA AS c
INNER JOIN SICS.AREA_GROUP_COUNTRY AS agc
        ON agc.FK_COUNTRY = c.OBJECT_ID
INNER JOIN SICS.LEGAL_AREA AS r
        ON r.OBJECT_ID = agc.FK_AREA_GROUP
       AND r.SUBCLASS = 4
WHERE c.OBJECT_ID = '375211B9CA164C4DBD4863AE149F1DDA'
ORDER BY r.CODE;


SELECT COUNT(*) AS countries_with_multiple_regions
FROM (
    SELECT agc.FK_COUNTRY
    FROM SICS.AREA_GROUP_COUNTRY AS agc
    INNER JOIN SICS.LEGAL_AREA AS r
            ON r.OBJECT_ID = agc.FK_AREA_GROUP
           AND r.SUBCLASS = 4
    GROUP BY agc.FK_COUNTRY
    HAVING COUNT(*) > 1
) x;
