

IF NOT EXISTS (
    SELECT 1
    FROM   audit.ETL_PACKAGE
    WHERE  PACKAGE_NAME = N'APPORTION_PACKAGE'
)
BEGIN
    INSERT INTO audit.ETL_PACKAGE
        (PACKAGE_NAME, PACKAGE_FILE_NAME, EXECUTION_ORDER, IS_ENABLED, DESCRIPTION)
    VALUES
        (N'APPORTION_PACKAGE',
         N'Apportioning.dtsx',
         40,
         1,
         N'Apportion package: OW premium initial split, OW transaction allocation, IW–OW policy link.');
END
ELSE
BEGIN
    UPDATE audit.ETL_PACKAGE
    SET    PACKAGE_FILE_NAME = N'Apportioning.dtsx',
           EXECUTION_ORDER   = 40,
           IS_ENABLED        = 1,
           DESCRIPTION       = N'Apportion package: OW premium initial split, OW transaction allocation, IW–OW policy link.'
    WHERE  PACKAGE_NAME = N'APPORTION_PACKAGE';
END
GO

DECLARE @PackageId INT =
    (SELECT PACKAGE_ID FROM audit.ETL_PACKAGE WHERE PACKAGE_NAME = N'APPORTION_PACKAGE');

IF @PackageId IS NULL
BEGIN
    RAISERROR(N'APPORTION_PACKAGE was not found in audit.ETL_PACKAGE after seed.', 16, 1);
END
ELSE
BEGIN
    ;WITH src AS (
        SELECT *
        FROM (VALUES
            (N'OW_PREM_INIT_SPLIT',
             N'SICS.dbo.ACC_CLASSIFIC',
             N'dbo.OW_PREM_INIT_SPLIT',
             N'ACC_CLASSIFIC split on outward non-proportional BUSINESS (SUBCLASS 3, 8, 11; type NONPROPTT/NONPROPFA). Replaces REIN_COB_CODE_PREM_SPLIT.'),
            (N'OW_TRANSACTION_ALLOCATION',
             N'SICS.dbo.AC_LEDGER_DETAIL',
             N'dbo.OW_TRANSACTION_ALLOCATION',
             N'AC_LEDGER_DETAIL joined to AC_LEDGER_BALANCE and AC_WORKSHEET; classification via ACC_CLASSIFIC. Replaces REIN_ALLOCATION.'),
            (N'OW_IW_POLICY_LINK',
             N'SICS.dbo.BUS_STRUCT_REP',
             N'dbo.OW_IW_POLICY_LINK',
             N'Proportional protection: inward BUS_STRUCT_REP (SUBCLASS 6) to outward BUSINESS (SUBCLASS 3, 8, 11) via BUS_RETRO_IBR and BUS_RETRO. Replaces POLICY_REINSURANCE_LINK.')
        ) AS v (TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, DESCRIPTION)
    )
    MERGE audit.ETL_PACKAGE_TABLE AS t
    USING src
       ON t.PACKAGE_ID = @PackageId
      AND t.TABLE_NAME = src.TABLE_NAME
    WHEN MATCHED THEN
        UPDATE SET
            SOURCE_OBJECT = src.SOURCE_OBJECT,
            TARGET_OBJECT = src.TARGET_OBJECT,
            DESCRIPTION   = src.DESCRIPTION,
            IS_ENABLED    = 1
    WHEN NOT MATCHED THEN
        INSERT (PACKAGE_ID, TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, IS_ENABLED, DESCRIPTION)
        VALUES (@PackageId, src.TABLE_NAME, src.SOURCE_OBJECT, src.TARGET_OBJECT, 1, src.DESCRIPTION);
END
GO
