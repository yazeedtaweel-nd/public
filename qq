SELECT
    b.SUBCLASS,
    b.FRK_TYPE_OF_BUS,
    COUNT(*) AS REL_CNT
FROM dbo.BUSINESS_PRTNR_REL r
JOIN dbo.INSURED_PERIOD ip
      ON ip.OBJECT_ID = r.FK_INS_PERIOD
JOIN dbo.BUSINESS b
      ON b.OBJECT_ID = ip.FK_BUSINESS
WHERE r.FSK_RELSHIP_TYPE = 55
  AND r.FRK_RELSHIP_TYPE = 'BR'
  AND b.SUBCLASS = 11
GROUP BY b.SUBCLASS, b.FRK_TYPE_OF_BUS;
