SELECT
    '1_ACTIVE_VS_INACTIVE' AS CHECK_NAME,
    CAST(IS_ACTIVE AS VARCHAR(50)) AS KEY_VALUE,
    COUNT(*) AS METRIC,
    CAST(NULL AS VARCHAR(200)) AS NOTE
FROM dbo.CNU_USER
GROUP BY IS_ACTIVE

UNION ALL

SELECT
    '2_POPULATION_COUNTS',
    'ALL_USERS',
    COUNT(*),
    'with_shortname='
      + CAST(SUM(CASE WHEN SHORTNAME IS NOT NULL AND LTRIM(RTRIM(SHORTNAME)) <> '' THEN 1 ELSE 0 END) AS VARCHAR(20))
      + '; with_ru='
      + CAST(SUM(CASE WHEN FK_RU IS NOT NULL THEN 1 ELSE 0 END) AS VARCHAR(20))
      + '; active_Y='
      + CAST(SUM(CASE WHEN IS_ACTIVE = 'Y' THEN 1 ELSE 0 END) AS VARCHAR(20))
FROM dbo.CNU_USER

UNION ALL

SELECT
    '3_USERS_WITH_MULTIPLE_CATEGORIES',
    x.USER_ID,
    COUNT(*),
    'same USER_ID linked to more than one USER_CATEGORY'
FROM (
    SELECT u.USER_ID, c.NAME
    FROM dbo.CNU_USER AS u
    INNER JOIN dbo.USER_USERCATEGORY AS ju
        ON ju.FK_USER = u.OBJECT_ID
    INNER JOIN dbo.USER_CATEGORY AS c
        ON c.OBJECT_ID = ju.FK_USERCATEGORY
) AS x
GROUP BY x.USER_ID
HAVING COUNT(*) > 1

UNION ALL

SELECT
    '4_DISTINCT_CATEGORY_NAMES',
    c.NAME,
    COUNT(*),
    'number of user-category links'
FROM dbo.USER_USERCATEGORY AS ju
INNER JOIN dbo.USER_CATEGORY AS c
    ON c.OBJECT_ID = ju.FK_USERCATEGORY
GROUP BY c.NAME

UNION ALL

SELECT
    '5_USERS_WITH_NO_CATEGORY',
    'NO_CATEGORY',
    COUNT(*),
    'CNU_USER rows with no USER_USERCATEGORY row'
FROM dbo.CNU_USER AS u
WHERE NOT EXISTS (
    SELECT 1
    FROM dbo.USER_USERCATEGORY AS ju
    WHERE ju.FK_USER = u.OBJECT_ID
)

ORDER BY CHECK_NAME, KEY_VALUE;
