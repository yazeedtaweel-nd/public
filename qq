SELECT
    COALESCE(
        NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
        NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
    ) AS POLICY_BK,
    lim.FRK_LIMIT_TYPE AS LMTQ_BK,
    cond.FK_MAIN_CURRENCY AS CURR_ORIGIN_BK,
    b.FK_FUNCTIONAL_CCY AS CURR_BASE_BK,
    CAST(
        CASE
            WHEN lim.FRK_OPTIONAL_FIELD = N'TSI' THEN lim.AMOUNT
        END AS decimal(38, 4)
    ) AS PLI_SI_AMOUNT_ORIGIN,
    CAST(
        CASE
            WHEN lim.FRK_OPTIONAL_FIELD = N'TSI'
             AND cond.FK_MAIN_CURRENCY = b.FK_FUNCTIONAL_CCY
                THEN lim.AMOUNT
            WHEN lim.FRK_OPTIONAL_FIELD = N'TSI'
             AND fx.EXCH_RATE_LIMIT IS NOT NULL
                THEN lim.AMOUNT * fx.EXCH_RATE_LIMIT
        END AS decimal(38, 4)
    ) AS PLI_SI_AMOUNT_BASE,
    CAST(lim.AMOUNT AS decimal(38, 4)) AS PLI_AMOUNT_ORIGIN,
    CAST(
        CASE
            WHEN cond.FK_MAIN_CURRENCY = b.FK_FUNCTIONAL_CCY
                THEN lim.AMOUNT
            WHEN fx.EXCH_RATE_LIMIT IS NOT NULL
                THEN lim.AMOUNT * fx.EXCH_RATE_LIMIT
        END AS decimal(38, 4)
    ) AS PLI_AMOUNT_BASE,
    CONVERT(int, CONVERT(char(8), GETDATE(), 112)) AS CREATED_DATE_SRGT,
    CONVERT(int, CONVERT(char(8), GETDATE(), 112)) AS UPDATED_DATE_SRGT
FROM SICS.LPC_LIMIT AS lim
INNER JOIN SICS.LPC_LIM_PREM_COND AS cond
    ON cond.OBJECT_ID = lim.FK_CONDITION
LEFT JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = cond.FK_INSURED_PERIOD
LEFT JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
OUTER APPLY (
    SELECT TOP (1) clp.EXCH_RATE_LIMIT
    FROM SICS.LPC_CUR_LIMIT_PREM AS clp
    WHERE clp.FK_CONDITION = cond.OBJECT_ID
      AND clp.FK_CURRENCY = b.FK_FUNCTIONAL_CCY
    ORDER BY clp.OBJECT_ID
) AS fx;
