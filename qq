-- 1) Claim worksheet validation indicator codes (expect not I/N linked to basis 95)
SELECT DISTINCT
       i.FRK_CLAIM_ACC_VALIDATOR AS CODE,
       i.FSK_CLAIM_ACC_VALIDATOR AS SUBCLASS,
       rd.NAME
FROM dbo.INSPER_ACC_VAL_IND i
LEFT JOIN dbo.REFERENCE_DATA rd
       ON rd.CODE = i.FRK_CLAIM_ACC_VALIDATOR
      AND rd.SUBCLASS = i.FSK_CLAIM_ACC_VALIDATOR
ORDER BY i.FSK_CLAIM_ACC_VALIDATOR, i.FRK_CLAIM_ACC_VALIDATOR;

-- 2) Confirm subclass 95 still has no extra columns beyond standard ref data
SELECT *
FROM dbo.REFERENCE_DATA
WHERE SUBCLASS = 95;
