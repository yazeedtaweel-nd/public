SELECT TABLE_NAME, COLUMN_NAME
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME IN ('PARTY', 'CNU_USER', 'LIFE_CYCLE_STATUS', 'BUS_STRUCT_REP')
  AND COLUMN_NAME LIKE '%OBJECT%'
ORDER BY TABLE_NAME, COLUMN_NAME;

