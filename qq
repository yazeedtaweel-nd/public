SELECT DISTINCT
    N'PROP' AS LINK_TYPE,
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip_iw.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip_iw.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS IW_POLICY_BK,
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip_ow.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip_ow.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS OW_POLICY_BK
FROM SICS.BUS_STRUCT_REP AS bsr
INNER JOIN SICS.BUSINESS AS b_iw
    ON b_iw.OBJECT_ID = bsr.FK_BUSINESS
   AND b_iw.SUBCLASS = 6
INNER JOIN SICS.INSURED_PERIOD AS ip_iw
    ON ip_iw.OBJECT_ID = bsr.FK_INS_PERIOD
INNER JOIN SICS.BUS_RETRO_IBR AS ibr
    ON ibr.OBJECT_ID = bsr.FK_PROT_ASS
   AND ibr.SUBCLASS = 1
INNER JOIN SICS.BUS_RETRO AS retro
    ON retro.FK_RETRO_IBR = ibr.OBJECT_ID
INNER JOIN SICS.INSURED_PERIOD AS ip_ow
    ON ip_ow.OBJECT_ID = retro.FK_INSURED_PERIOD
INNER JOIN SICS.BUSINESS AS b_ow
    ON b_ow.OBJECT_ID = ip_ow.FK_BUSINESS
   AND b_ow.SUBCLASS IN (3, 8, 11)
WHERE bsr.IS_CURRENT_LCP = N'Y'
  AND bsr.IS_CURRENT_AM = N'Y'
  AND COALESCE(
        NULLIF(LTRIM(RTRIM(ip_iw.I_PERIOD_FORMER_ID)), N''),
        NULLIF(LTRIM(RTRIM(ip_iw.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL
  AND COALESCE(
        NULLIF(LTRIM(RTRIM(ip_ow.I_PERIOD_FORMER_ID)), N''),
        NULLIF(LTRIM(RTRIM(ip_ow.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL;
