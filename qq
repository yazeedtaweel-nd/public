
SELECT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK,
    CAST(N'O' AS nvarchar(50)) AS POLICY_BUSINESS_INDICATOR,
    CAST(bsr.SEQUENCE_NUMBER AS int) AS POLICY_LAST_VERSION_NO,
    CAST(LTRIM(RTRIM(la_risk.ISO_ALPHA_2)) AS nvarchar(2)) AS RISK_COUNTRY_CODE,
    CAST(LTRIM(RTRIM(la_dom.ISO_ALPHA_2)) AS nvarchar(2)) AS DOMICILE_COUNTRY_CODE,
    CAST(LTRIM(RTRIM(brk.IDENTIFIER)) AS nvarchar(20)) AS BROKER_BK,
    CAST(LTRIM(RTRIM(b.FRK_LEVEL_OF_BUS)) AS nvarchar(15)) AS LOB_BK,
    CAST(
        CASE LTRIM(RTRIM(rd_tob.EXTERNAL_CODE))
            WHEN N'TP' THEN N'11'
            WHEN N'TN' THEN N'12'
            WHEN N'FP' THEN N'21'
            WHEN N'FN' THEN N'22'
        END AS nvarchar(2)
    ) AS PCLS_CLASS_CODE,
    CAST(LTRIM(RTRIM(bsr.FRK_LC_STAT_CURR)) AS nvarchar(15)) AS PSTS_BK,
    CAST(LTRIM(RTRIM(b.FRK_TYPE_OF_BUS)) AS nvarchar(15)) AS CTYP_BK,
    epi.POLICY_EPI_CURRENCY,
    epi.POLICY_EPI_AMOUNT_ORIGIN,
    tsi.POLICY_TSI_CURRENCY,
    tsi.POLICY_TSI_AMOUNT_ORIGIN,
    xs.POLICY_EXCESS_CURRENCY,
    xs.POLICY_EXCESS_AMOUNT_ORIGIN,
    pag.PAG_CURRENCY,
    pag.PAG_AMOUNT,
    b.SUBCLASS AS BUSINESS_SUBCLASS,
    bsr.IS_CURRENT_LCP,
    bsr.IS_CURRENT_AM,
    bsr.FK_BUSINESS
FROM SICS.BUS_STRUCT_REP AS bsr
INNER JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = bsr.FK_BUSINESS
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = bsr.FK_INS_PERIOD
LEFT JOIN SICS.PARTY AS brk
    ON brk.OBJECT_ID = bsr.FK_BROKER
LEFT JOIN SICS.REFERENCE_DATA AS rd_tob
    ON rd_tob.CODE = b.FRK_TYPE_OF_BUS
   AND rd_tob.SUBCLASS = 46
OUTER APPLY (
    SELECT TOP (1)
        acc.FK_IR_COUNTRY,
        acc.FK_RES_IR_COUNTRY
    FROM SICS.ACC_CLASSIFIC AS acc
    WHERE acc.FK_BUS = b.OBJECT_ID
    ORDER BY
        CASE WHEN acc.FK_IR_COUNTRY IS NOT NULL THEN 0 ELSE 1 END,
        acc.OBJECT_ID
) AS acc
LEFT JOIN SICS.LEGAL_AREA AS la_risk
    ON la_risk.OBJECT_ID = acc.FK_IR_COUNTRY
LEFT JOIN SICS.LEGAL_AREA AS la_dom
    ON la_dom.OBJECT_ID = acc.FK_RES_IR_COUNTRY
OUTER APPLY (
    SELECT TOP (1)
        CAST(LTRIM(RTRIM(lpc.FK_MAIN_CURRENCY)) AS nvarchar(20)) AS POLICY_EPI_CURRENCY,
        CAST(COALESCE(prem.INSURED_AMOUNT, prem.ANNUAL_AMOUNT) AS money) AS POLICY_EPI_AMOUNT_ORIGIN
    FROM SICS.LIFE_CYCLE_PHASE AS lcp
    INNER JOIN SICS.SCOPE_OF_COVER AS soc
        ON soc.FK_LIFECYCLEP = lcp.OBJECT_ID
    INNER JOIN SICS.BUS_COND_CONTAINER AS bcc
        ON bcc.OBJECT_ID = soc.FK_BUSCOND
    INNER JOIN SICS.LPC_LIM_PREM_COND AS lpc
        ON lpc.FK_COND_CONTAINER = bcc.OBJECT_ID
    INNER JOIN SICS.LPC_PREMIUM AS prem
        ON prem.FK_CONDITION = lpc.OBJECT_ID
    WHERE lcp.FK_INS_PRD = ip.OBJECT_ID
      AND prem.FRK_OPTIONAL_FIELD = N'EPI'
    ORDER BY prem.OBJECT_ID
) AS epi
OUTER APPLY (
    SELECT TOP (1)
        CAST(LTRIM(RTRIM(lpc.FK_MAIN_CURRENCY)) AS nvarchar(20)) AS POLICY_TSI_CURRENCY,
        CAST(lim.AMOUNT AS money) AS POLICY_TSI_AMOUNT_ORIGIN
    FROM SICS.LIFE_CYCLE_PHASE AS lcp
    INNER JOIN SICS.SCOPE_OF_COVER AS soc
        ON soc.FK_LIFECYCLEP = lcp.OBJECT_ID
    INNER JOIN SICS.BUS_COND_CONTAINER AS bcc
        ON bcc.OBJECT_ID = soc.FK_BUSCOND
    INNER JOIN SICS.LPC_LIM_PREM_COND AS lpc
        ON lpc.FK_COND_CONTAINER = bcc.OBJECT_ID
    INNER JOIN SICS.LPC_LIMIT AS lim
        ON lim.FK_CONDITION = lpc.OBJECT_ID
    WHERE lcp.FK_INS_PRD = ip.OBJECT_ID
      AND lim.FRK_OPTIONAL_FIELD = N'TSI'
    ORDER BY lim.OBJECT_ID
) AS tsi
OUTER APPLY (
    SELECT TOP (1)
        CAST(LTRIM(RTRIM(lpc.FK_MAIN_CURRENCY)) AS nvarchar(20)) AS POLICY_EXCESS_CURRENCY,
        CAST(lim.AMOUNT AS money) AS POLICY_EXCESS_AMOUNT_ORIGIN
    FROM SICS.LIFE_CYCLE_PHASE AS lcp
    INNER JOIN SICS.SCOPE_OF_COVER AS soc
        ON soc.FK_LIFECYCLEP = lcp.OBJECT_ID
    INNER JOIN SICS.BUS_COND_CONTAINER AS bcc
        ON bcc.OBJECT_ID = soc.FK_BUSCOND
    INNER JOIN SICS.LPC_LIM_PREM_COND AS lpc
        ON lpc.FK_COND_CONTAINER = bcc.OBJECT_ID
    INNER JOIN SICS.LPC_LIMIT AS lim
        ON lim.FK_CONDITION = lpc.OBJECT_ID
    WHERE lcp.FK_INS_PRD = ip.OBJECT_ID
      AND lim.FRK_OPTIONAL_FIELD = N'EXCESS'
    ORDER BY lim.OBJECT_ID
) AS xs
OUTER APPLY (
    SELECT TOP (1)
        CAST(LTRIM(RTRIM(lpc.FK_MAIN_CURRENCY)) AS nvarchar(20)) AS PAG_CURRENCY,
        CAST(lim.AMOUNT AS money) AS PAG_AMOUNT
    FROM SICS.LIFE_CYCLE_PHASE AS lcp
    INNER JOIN SICS.SCOPE_OF_COVER AS soc
        ON soc.FK_LIFECYCLEP = lcp.OBJECT_ID
    INNER JOIN SICS.BUS_COND_CONTAINER AS bcc
        ON bcc.OBJECT_ID = soc.FK_BUSCOND
    INNER JOIN SICS.LPC_LIM_PREM_COND AS lpc
        ON lpc.FK_COND_CONTAINER = bcc.OBJECT_ID
    INNER JOIN SICS.LPC_LIMIT AS lim
        ON lim.FK_CONDITION = lpc.OBJECT_ID
    WHERE lcp.FK_INS_PRD = ip.OBJECT_ID
      AND lim.FRK_OPTIONAL_FIELD = N'AGGREGATE_L'
    ORDER BY lim.OBJECT_ID
) AS pag
WHERE b.SUBCLASS IN (3, 8, 11)
  AND COALESCE(
        NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
        NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL
  AND bsr.IS_CURRENT_LCP = N'Y'
  AND bsr.IS_CURRENT_AM = N'Y'
