
WITH CLM_GRP AS (
    SELECT
        c.OBJECT_ID                                     AS CLAIM_OID,
        scr.OBJECT_ID                                   AS SOC_CLAIM_OID,
        c.CLAIM_IDENTIFIER                              AS CLA_BK,
        c.FRK_CLM_CLASSFCTN                             AS CLAIM_TYPE,
        ISNULL(hl.CLAIM_IDENTIFIER, c.CLAIM_IDENTIFIER) AS CLAIM_GROUP,
        ISNULL(hl.IS_MARKET_LOSS, 'N')                  AS CAT_IND
    FROM SICS.CLAIMS c
    INNER JOIN SICS.SOC_TO_CLAIM_REL scr
        ON scr.FK_CLAIM = c.OBJECT_ID
    LEFT JOIN SICS.CLAIMS hl
        ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
       AND hl.SUBCLASS = 6
),
CLM_GRP_SMR AS (
    /* empty on this SICS copy until claim worksheets exist */
    SELECT
        g.CLAIM_GROUP,
        SUM(d.EXCH_AMT) AS GROUP_BASE_AMT
    FROM SICS.CLM_GRP g
    INNER JOIN SICS.AC_LEDGER_BALANCE bal
        ON bal.FK_CLAIM = g.SOC_CLAIM_OID
    INNER JOIN SICS.AC_LEDGER_DETAIL d
        ON d.FK_BALANCE = bal.OBJECT_ID
    GROUP BY g.CLAIM_GROUP
),
CLM_TYP AS (
    SELECT
        cg.SOC_CLAIM_OID,
        cg.CLA_BK,
        cg.CLAIM_TYPE,
        cg.CLAIM_GROUP,
        cg.CAT_IND,
        cs.GROUP_BASE_AMT,
        ISNULL(
            CASE
                WHEN cg.CAT_IND = 'Y'             THEN 'CAT'
                WHEN cg.CLAIM_TYPE = 'ACC'        THEN 'ATT'
                WHEN cs.GROUP_BASE_AMT < -375000  THEN 'LRG'
                WHEN cs.GROUP_BASE_AMT >= -375000 THEN 'ATT'
            END, 'ATT') AS IND
    FROM SICS.CLM_GRP cg
    LEFT JOIN SICS.CLM_GRP_SMR cs
        ON cs.CLAIM_GROUP = cg.CLAIM_GROUP
)
SELECT
    /* identity / keys */
    c.OBJECT_ID                                     AS CLAIMS_OBJECT_ID,
    scr.OBJECT_ID                                   AS SOC_CLAIM_OBJECT_ID,

    c.CLAIM_IDENTIFIER                              AS CLA_BK,
    c.LOSS_NAME                                     AS CLA_DESC,
    CASE
        WHEN ip.IS_DIRECT = 'Y' THEN 'DIRECT'
        ELSE brk.IDENTIFIER
    END                                             AS CLA_BROKER,

    CONVERT(NVARCHAR(50), ct.CLAIM_TYPE)            AS CLA_SOURCE,
    CONVERT(NVARCHAR(50), ct.IND)                   AS CLA_TYPE,

    UPPER(st.NAME)                                  AS CLA_STATUS_CODE,
    COALESCE(cs.FRK_STATUS, scr.FRK_STATUS_TYPE)    AS CLA_STATUS,
    u.SHORTNAME                                     AS CLA_HANDLER,
    COALESCE(cref.REFERENCE_ID, scr.CL_REF)         AS CLA_ALT_REF,
    CONVERT(BIT, CASE WHEN mv.DETAIL_ROWS > 0 THEN 1 ELSE 0 END)
                                                    AS CLA_IS_MOVEMENT,

    c.LOSS_START_DT                                 AS CLA_LOSS_DATE,
    COALESCE(sh.OPEN_DATE,   CAST('9999-01-01' AS DATE)) AS CLA_OPEN_DATE,
    COALESCE(sh.REOPEN_DATE, CAST('9999-01-01' AS DATE)) AS CLA_REOPEN_DATE,
    COALESCE(scr.ADVICE_REC_DATE, scr.CLAIM_ADVISED_DT, CAST('9999-01-01' AS DATE))
                                                    AS CLA_REPORTED_DATE,
    COALESCE(sh.CLOSE_DATE,  CAST('9999-01-01' AS DATE)) AS CLA_CLOSE_DATE,
    scr.LAST_UPDATE_DT                              AS CLA_LAST_TRANSACTION,

    /* policy lookup key -> DIM_POLICY.POLICY_BK -> POLICY_SRGT */
    COALESCE(ip.BUS_INS_PER_ID, b.IDENTIFIER)       AS POLICY_BK,
    ip.BUS_INS_PER_ID                               AS POLICY_INS_PER_ID,
    b.IDENTIFIER                                    AS POLICY_CONTRACT_NO,
    soc.IDENTIFIER                                  AS SECTION_IDENTIFIER,

    /* other dim lookup keys */
    ct.CLAIM_GROUP                                  AS CLGRP_BK,
    COALESCE(cs.FRK_STATUS, scr.FRK_STATUS_TYPE)    AS CLST_BK,
    cs.FRK_SUB_STATUS                               AS CLSS_BK,
    ct.CLAIM_TYPE                                   AS CLTP_BK,
    ct.IND                                          AS CLSTP_BK,
    c.FRK_CAUSE_OF_LOSS                             AS LSTP_BK,
    lt.NAME                                         AS LSTP_NAME,

    ct.CAT_IND,
    ct.GROUP_BASE_AMT
FROM SICS.CLAIMS c
INNER JOIN SICS.SOC_TO_CLAIM_REL scr
    ON scr.FK_CLAIM = c.OBJECT_ID
INNER JOIN SICS.CLM_TYP ct
    ON ct.SOC_CLAIM_OID = scr.OBJECT_ID

LEFT JOIN SICS.CLAIM_STATUS cs
    ON cs.FK_CLAIM = scr.OBJECT_ID
   AND cs.IS_CURRENT = 'Y'
LEFT JOIN SICS.REFERENCE_DATA st
    ON st.CODE = COALESCE(cs.FRK_STATUS, scr.FRK_STATUS_TYPE)
   AND st.SUBCLASS = 517
LEFT JOIN SICS.REFERENCE_DATA lt
    ON lt.CODE = c.FRK_CAUSE_OF_LOSS
   AND lt.SUBCLASS = 523
LEFT JOIN SICS.CNU_USER u
    ON u.OBJECT_ID = c.FK_RES_CL_HDL

LEFT JOIN SICS.SCOPE_OF_COVER soc
    ON soc.OBJECT_ID = scr.FK_SOC
LEFT JOIN SICS.LIFE_CYCLE_PHASE lcp1
    ON lcp1.OBJECT_ID = soc.FK_LIFECYCLEP
LEFT JOIN SICS.LIFE_CYCLE_PHASE lcp2
    ON lcp2.FK_SCOPE_OF_CVR = soc.OBJECT_ID
   AND lcp2.IS_CURRENT = 'Y'
LEFT JOIN SICS.INSURED_PERIOD ip
    ON ip.OBJECT_ID = COALESCE(lcp1.FK_INS_PRD, lcp2.FK_INS_PRD)
LEFT JOIN SICS.BUSINESS b
    ON b.OBJECT_ID = ip.FK_BUSINESS

LEFT JOIN (
    SELECT
        cs2.FK_CLAIM,
        MIN(CASE WHEN UPPER(rd2.NAME) LIKE 'OPEN%'   THEN cs2.CHANGE_DATE END) AS OPEN_DATE,
        MAX(CASE WHEN UPPER(rd2.NAME) LIKE 'REOPEN%' THEN cs2.CHANGE_DATE END) AS REOPEN_DATE,
        MAX(CASE WHEN UPPER(rd2.NAME) LIKE 'CLOS%'   THEN cs2.CHANGE_DATE END) AS CLOSE_DATE
    FROM SICS.CLAIM_STATUS cs2
    LEFT JOIN SICS.REFERENCE_DATA rd2
        ON rd2.CODE = cs2.FRK_STATUS
       AND rd2.SUBCLASS = 517
    GROUP BY cs2.FK_CLAIM
) sh ON sh.FK_CLAIM = scr.OBJECT_ID

LEFT JOIN (
    SELECT FK_SOC_REL, MIN(REFERENCE_ID) AS REFERENCE_ID
    FROM SICS.CLAIM_REFS
    GROUP BY FK_SOC_REL
) cref ON cref.FK_SOC_REL = scr.OBJECT_ID

LEFT JOIN (
    SELECT bpr.FK_INS_PERIOD, MIN(p.IDENTIFIER) AS IDENTIFIER
    FROM SICS.BUSINESS_PRTNR_REL bpr
    INNER JOIN SICS.PARTY p
        ON p.OBJECT_ID = bpr.FK_BUS_PARTNER
    WHERE p.SUBCLASS = 4
    GROUP BY bpr.FK_INS_PERIOD
) brk ON brk.FK_INS_PERIOD = ip.OBJECT_ID

LEFT JOIN (
    SELECT bal.FK_CLAIM AS SOC_CLAIM_OID, COUNT(*) AS DETAIL_ROWS
    FROM SICS.AC_LEDGER_BALANCE bal
    INNER JOIN SICS.AC_LEDGER_DETAIL d
        ON d.FK_BALANCE = bal.OBJECT_ID
    GROUP BY bal.FK_CLAIM
) mv ON mv.SOC_CLAIM_OID = scr.OBJECT_ID

ORDER BY c.CLAIM_IDENTIFIER, scr.OBJECT_ID
