/* ============================================================
   009_seed_submission_package.sql — Submission Package

   Seeds audit.ETL_PACKAGE + audit.ETL_PACKAGE_TABLE for the
   Submission Package (DimSubmission.dtsx) and its three loads:
   DIM_DECLINATION_REASON, DIM_SUBMISSION, DIM_FAC_SUBMISSION.

   Re-runnable: inserts the package if missing, then MERGE-upserts
   the table rows. Does not touch execution / error history.

   Apply after 001 control DDL and 002 Party seed.
   Runs after Party (10) and before Policy (15).
   ============================================================ */

SET NOCOUNT ON;
GO

IF NOT EXISTS (
    SELECT 1
    FROM   audit.ETL_PACKAGE
    WHERE  PACKAGE_NAME = N'SUBMISSION_PACKAGE'
)
BEGIN
    INSERT INTO audit.ETL_PACKAGE
        (PACKAGE_NAME, PACKAGE_FILE_NAME, EXECUTION_ORDER, IS_ENABLED, DESCRIPTION)
    VALUES
        (N'SUBMISSION_PACKAGE',
         N'DimSubmission.dtsx',
         12,
         1,
         N'Submission package: Declination Reason, Submission, Facultative Submission.');
END
ELSE
BEGIN
    UPDATE audit.ETL_PACKAGE
    SET    PACKAGE_FILE_NAME = N'DimSubmission.dtsx',
           EXECUTION_ORDER   = 12,
           IS_ENABLED        = 1,
           DESCRIPTION       = N'Submission package: Declination Reason, Submission, Facultative Submission.'
    WHERE  PACKAGE_NAME = N'SUBMISSION_PACKAGE';
END
GO

DECLARE @PackageId INT =
    (SELECT PACKAGE_ID FROM audit.ETL_PACKAGE WHERE PACKAGE_NAME = N'SUBMISSION_PACKAGE');

IF @PackageId IS NULL
BEGIN
    RAISERROR(N'SUBMISSION_PACKAGE was not found in audit.ETL_PACKAGE after seed.', 16, 1);
END
ELSE
BEGIN
    ;WITH src AS (
        SELECT *
        FROM (VALUES
            (N'DECLINATION_REASON',
             N'SICS.dbo.REFERENCE_DATA',
             N'dbo.DIM_DECLINATION_REASON',
             N'REFERENCE_DATA WHERE SUBCLASS = 106 (Declination Reason).'),
            (N'SUBMISSION',
             N'SICS.dbo.BUS_STRUCT_REP',
             N'dbo.DIM_SUBMISSION',
             N'BUS_STRUCT_REP quotation grain; parties, status, and amounts via life-cycle and limit/premium joins.'),
            (N'FAC_SUBMISSION',
             N'SICS.dbo.BUS_STRUCT_REP',
             N'dbo.DIM_FAC_SUBMISSION',
             N'BUS_STRUCT_REP filtered to facultative via FRK_TYPE_OF_BUS.')
        ) AS v (TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, DESCRIPTION)
    )
    MERGE audit.ETL_PACKAGE_TABLE AS t
    USING src
       ON t.PACKAGE_ID = @PackageId
      AND t.TABLE_NAME = src.TABLE_NAME
    WHEN MATCHED THEN
        UPDATE SET
            SOURCE_OBJECT = src.SOURCE_OBJECT,
            TARGET_OBJECT = src.TARGET_OBJECT,
            DESCRIPTION   = src.DESCRIPTION,
            IS_ENABLED    = 1
    WHEN NOT MATCHED THEN
        INSERT (PACKAGE_ID, TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, IS_ENABLED, DESCRIPTION)
        VALUES (@PackageId, src.TABLE_NAME, src.SOURCE_OBJECT, src.TARGET_OBJECT, 1, src.DESCRIPTION);
END
GO
