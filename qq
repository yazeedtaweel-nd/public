/* Candidate domains ranked by how many DW rows they explain */
WITH dw_quote_status AS (
    SELECT *
    FROM (VALUES
        ('D', 'DECLINED'),
        ('F', 'SUBMISSION TAKEN TO QUOTE'),
        ('L', 'LINE OFFERED'),
        ('N', 'LINE OFFERED NTU'),
        ('O', 'SUBMISSION'),
        ('T', 'TAKEN UP'),
        ('3', 'DUPLICATE'),
        ('4', 'RENEWAL'),
        ('5', 'WAITING INFORMATION')
    ) AS v(QSTS_BK, QSTS_NAME)
)
SELECT
    rd.SUBCLASS,
    rdt.NAME AS DOMAIN_NAME,
    SUM(CASE WHEN UPPER(rd.NAME) = dw.QSTS_NAME THEN 1 ELSE 0 END) AS CODE_AND_NAME_MATCHES,
    COUNT(dw.QSTS_BK)                                              AS CODE_MATCHES,
    COUNT(*)                                                       AS DOMAIN_ROWS_TOUCHED
FROM REFERENCE_DATA rd
LEFT JOIN REF_DATA_TYPE rdt
       ON rdt.SUBCLASS_NUMBER = rd.SUBCLASS
JOIN dw_quote_status dw
       ON dw.QSTS_BK = rd.CODE
GROUP BY rd.SUBCLASS, rdt.NAME
ORDER BY CODE_AND_NAME_MATCHES DESC, CODE_MATCHES DESC;
