-- all type codes
SELECT cat.FRK_CATEGORY, rd.NAME, COUNT(DISTINCT p.OBJECT_ID) AS party_cnt
FROM PARTY p
JOIN BUS_PARTNER_CAT cat ON cat.FK_PARTNER = p.OBJECT_ID
LEFT JOIN REFERENCE_DATA rd
       ON rd.CODE = cat.FRK_CATEGORY AND rd.SUBCLASS = cat.FSK_CATEGORY
WHERE p.SUBCLASS = 4
GROUP BY cat.FRK_CATEGORY, rd.NAME
ORDER BY party_cnt DESC;

-- multi-type risk
SELECT type_cnt, COUNT(*) AS parties
FROM (
    SELECT p.OBJECT_ID, COUNT(*) AS type_cnt
    FROM PARTY p
    JOIN BUS_PARTNER_CAT cat ON cat.FK_PARTNER = p.OBJECT_ID
    WHERE p.SUBCLASS = 4
    GROUP BY p.OBJECT_ID
) x
GROUP BY type_cnt
ORDER BY type_cnt;
