WITH tree AS (
    SELECT
        rz.OBJECT_ID, rz.CODE, rz.SUBCLASS,
        CAST(rz.NAME AS NVARCHAR(200)) AS root_name,
        CAST(NULL AS VARCHAR(32)) AS country_id,
        1 AS lvl
    FROM SICS.RISK_ZONE rz
    WHERE rz.FK_PARENT IS NULL
    UNION ALL
    SELECT
        c.OBJECT_ID, c.CODE, c.SUBCLASS,
        t.root_name,
        COALESCE(c.FK_COUNTRY, t.country_id),
        t.lvl + 1
    FROM SICS.RISK_ZONE c
    JOIN tree t ON c.FK_PARENT = t.OBJECT_ID
)
SELECT
    root_name,
    lvl,
    SUBCLASS,
    COUNT(*) AS rows_total,
    SUM(CASE WHEN CODE IS NOT NULL THEN 1 ELSE 0 END) AS rows_with_code,
    SUM(CASE WHEN country_id IS NULL THEN 1 ELSE 0 END) AS rows_without_country
FROM tree
GROUP BY root_name, lvl, SUBCLASS
ORDER BY root_name, lvl
OPTION (MAXRECURSION 0);
