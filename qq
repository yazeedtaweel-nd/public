SELECT

    rd.CODE,

    rd.NAME,

    rd.EXTERNAL_CODE,

    rd.IS_ACTIVE,

    ISNULL(p.USED_AS_PREM_BASIS_CNT, 0)  AS USED_AS_PREM_BASIS_CNT,

    ISNULL(c.USED_AS_CLAIM_BASIS_CNT, 0) AS USED_AS_CLAIM_BASIS_CNT

FROM REFERENCE_DATA rd

LEFT JOIN (

    SELECT

        FRK_ACCT_BASIS AS CODE,

        COUNT(*) AS USED_AS_PREM_BASIS_CNT

    FROM BUS_COMMON_ACC

    WHERE ISNULL(FSK_ACCT_BASIS, 65) = 65

    GROUP BY FRK_ACCT_BASIS

) p ON p.CODE = rd.CODE

LEFT JOIN (

    SELECT

        FRK_ACCT_CLAIM_BAS AS CODE,

        COUNT(*) AS USED_AS_CLAIM_BASIS_CNT

    FROM BUS_COMMON_ACC

    WHERE ISNULL(FSK_ACCT_CLAIM_BAS, 65) = 65

    GROUP BY FRK_ACCT_CLAIM_BAS

) c ON c.CODE = rd.CODE

WHERE rd.SUBCLASS = 65

ORDER BY rd.CODE;
