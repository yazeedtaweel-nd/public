SELECT
    w.OBJECT_ID                         AS sics_object_id,          -- staging only; not WRKS_SRGT
    CONVERT(varchar(8), w.BOOKING_DATE, 112)
        + '|' + CAST(w.ID_SERIE_NO AS varchar(20))
                                        AS WRKS_BK,                 -- candidate; confirm vs DIM
    w.BOOKING_DATE                      AS WRKS_DATE,
    w.ID_SERIE_NO                       AS WRKS_NO,                 -- candidate; DIM samples were all 1
    CASE
        WHEN SUM(CASE WHEN b.IS_OUTWARD = 'Y' THEN 1 ELSE 0 END) > 0
         AND SUM(CASE WHEN ISNULL(b.IS_OUTWARD, 'N') = 'N' THEN 1 ELSE 0 END) = 0
            THEN 'O'
        WHEN SUM(CASE WHEN ISNULL(b.IS_OUTWARD, 'N') = 'N' THEN 1 ELSE 0 END) > 0
         AND SUM(CASE WHEN b.IS_OUTWARD = 'Y' THEN 1 ELSE 0 END) = 0
            THEN 'I'
        WHEN COUNT(b.OBJECT_ID) = 0
            THEN NULL
        ELSE 'MIXED'
    END                                 AS WRKS_INDICATOR,          -- I = inward, O = outward
    SUM(b.LEDGER_BAL_ORG_AMT)           AS WRKS_CASH_TOTAL_AMT,     -- candidate amount
    w.IDENTIFIER                        AS sics_identifier,
    w.ID_PREFIX,
    w.ID_YR_PART,
    w.FRK_TYPE,                         -- AB/CL/TA/PB/RE — not WRKS_INDICATOR
    w.FRK_STATUS,
    w.SUBCLASS,
    COUNT(DISTINCT b.OBJECT_ID)         AS balance_count
FROM dbo.AC_WORKSHEET AS w
LEFT JOIN dbo.AC_LEDGER_DETAIL AS d
       ON d.FK_WORKSHEET = w.OBJECT_ID
LEFT JOIN dbo.AC_LEDGER_BALANCE AS b
       ON b.OBJECT_ID = d.FK_BALANCE
GROUP BY
    w.OBJECT_ID,
    w.BOOKING_DATE,
    w.ID_SERIE_NO,
    w.IDENTIFIER,
    w.ID_PREFIX,
    w.ID_YR_PART,
    w.FRK_TYPE,
    w.FRK_STATUS,
    w.SUBCLASS
ORDER BY
    w.BOOKING_DATE,
    w.ID_SERIE_NO;
