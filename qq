SELECT
    c.CLAIM_IDENTIFIER,
    cr.REFERENCE_ID,
    rd.CODE AS REF_TYPE_CODE,
    rd.NAME AS REF_TYPE_NAME
FROM dbo.CLAIM_REFS AS cr
LEFT JOIN dbo.REFERENCE_DATA AS rd
    ON  rd.CODE     = cr.FRK_CLM_REF_TYPE
    AND rd.SUBCLASS = ISNULL(cr.FSK_CLM_REF_TYPE, 548)
LEFT JOIN dbo.SOC_TO_CLAIM_REL AS scr
    ON  scr.OBJECT_ID = cr.FK_SOC_REL
LEFT JOIN dbo.CLAIMS AS c
    ON  c.OBJECT_ID = scr.FK_CLAIM
WHERE cr.FK_SOC_REL IS NOT NULL
ORDER BY c.CLAIM_IDENTIFIER, rd.CODE, cr.REFERENCE_ID;
