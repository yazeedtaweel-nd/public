/*
  DIM_FAC_SUBMISSION source extract from SICS
  Grain: current BUS_STRUCT_REP rows for facultative business
  Adjust @FacCodes after running query #1
*/
DECLARE @FacCodes TABLE (CODE VARCHAR(15) PRIMARY KEY);
INSERT INTO @FacCodes (CODE)
VALUES
    -- TODO: replace with codes from query #1
    ('PROPFAC'),
    ('NONPROPFAC');

SELECT TOP (500)
    -- Identity
    bsr.IDENTIFIER                                              AS SBMS_BK,
    bsr.TITLE                                                   AS SBMS_TITLE,

    -- User
    u.USER_ID                                                   AS SBMS_ENTERED_BY,
    u.SHORTNAME                                                 AS SBMS_UDT_LOGIN,

    -- Take-up refs
    bsr.IDENTIFIER_PREV                                         AS SBMS_TAKEN_FROM_REF,
    COALESCE(NULLIF(bsr.IDENTIFIER_CURR, ''), bsr.IDENTIFIER)   AS SBMS_TAKEN_TO_REF_CANDIDATE,
    bsr.IDENTIFIER_CURR                                         AS IDENTIFIER_CURR,
    bsr.IDENTIFIER                                              AS IDENTIFIER_BUSINESS,

    -- Dates
    bsr.INCEPTION_DATE                                          AS SBMS_INCEPTION_DATE,
    lcs.CHANGE_DATE                                             AS SBMS_ENTRY_DATE,
    CAST(bsr.INSRD_PERIOD_START AS DATE)                        AS SBMS_START_DATE,
    CAST(bsr.INSRD_PERIOD_END   AS DATE)                        AS SBMS_EXPIRY_DATE,

    -- Status
    bsr.FRK_LC_STAT_CURR                                        AS LC_STATUS_CODE,
    rd_lc.NAME                                                  AS SUBMS_STATUS_LC,
    bsr.FRK_BASICSTAT_CURR                                      AS BASIC_STATUS_CODE,
    rd_bs.NAME                                                  AS SUBMS_STATUS_BASIC,
    bsr.FRK_LC_SUBST_CURR                                       AS LC_SUBSTATUS_CODE,
    rd_lcs.NAME                                                 AS SUBMS_STATUS_SUB,

    -- Parties (natural keys for dim lookup)
    bsr.FK_BROKER                                               AS FK_BROKER,
    brk.IDENTIFIER                                              AS BROKER_BK,
    bsr.BROKER_REF,
    bsr.BROKER_NAME,
    bsr.FK_CEDENT                                               AS FK_CEDENT,
    ced.IDENTIFIER                                              AS CEDENT_BK,
    bsr.CEDENT_REF,
    bsr.CEDENT_NAME,
    bsr.FK_INSURED                                              AS FK_INSURED,
    ins.IDENTIFIER                                              AS INSURED_BK,
    bsr.INSURED_REF,
    bsr.INSURED_NAME,

    -- Countries (denorm on reporting table)
    bsr.INSURED_COUNTRY                                         AS CTRY_RISK_CANDIDATE,
    bsr.CEDENT_COUNTRY                                          AS CTRY_DOMICILE_CANDIDATE,
    bsr.BROKER_COUNTRY,

    -- LOB / TOB
    bsr.LOB_REF_NM,
    bsr.FRK_TYPE_OF_BUS,
    tob.NAME                                                    AS TYPE_OF_BUS_NAME,
    bsr.TOB_REF_NM,

    -- EPI / TSI
    lpc.FK_MAIN_CURRENCY                                        AS EPI_TSI_CURRENCY_FK,
    cur.ISO_ALPHA                                               AS SBMS_EPI_CURRENCY,
    prem.CURRENT_AMOUNT                                         AS EPI_CURRENT_AMOUNT,
    prem.ANNUAL_AMOUNT                                          AS EPI_ANNUAL_AMOUNT,
    prem.INSURED_AMOUNT                                         AS EPI_INSURED_AMOUNT,
    prem.BASE_AMOUNT                                            AS SBMS_EPI_AMOUNT_BASE,
    lim.AMOUNT                                                  AS SBMS_TSI_AMOUNT_CANDIDATE,
    lim.IS_UNLIMITED                                            AS TSI_IS_UNLIMITED,

    -- Useful keys for debugging grain
    bsr.OBJECT_ID                                               AS BUS_STRUCT_REP_OID,
    bsr.FK_BUSINESS,
    bsr.FK_INS_PERIOD,
    bsr.FK_LC_PHASE,
    bsr.FK_LC_STATUS_CURR,
    bsr.FK_PC_LIM_PREM,
    bsr.FK_PC_PREM,
    bsr.IS_CRNT_STATUS,
    bsr.IS_CRNT_BASIC_STAT,
    bsr.IS_CURRENT_LCP,
    bsr.IS_IP_LATEST

FROM BUS_STRUCT_REP AS bsr
LEFT JOIN CNU_USER AS u
    ON u.OBJECT_ID = bsr.FK_UNDERW_CURR
LEFT JOIN LIFE_CYCLE_STATUS AS lcs
    ON lcs.OBJECT_ID = bsr.FK_LC_STATUS_CURR
LEFT JOIN REFERENCE_DATA AS rd_lc
    ON rd_lc.CODE = bsr.FRK_LC_STAT_CURR
   AND rd_lc.SUBCLASS = 90          -- Agreement Life Cycle Status
LEFT JOIN REFERENCE_DATA AS rd_bs
    ON rd_bs.CODE = bsr.FRK_BASICSTAT_CURR
   AND rd_bs.SUBCLASS = 89          -- Agreement Basic Status
LEFT JOIN REFERENCE_DATA AS rd_lcs
    ON rd_lcs.CODE = bsr.FRK_LC_SUBST_CURR
   AND rd_lcs.SUBCLASS = 91         -- Agreement Life Cycle Sub Status
LEFT JOIN REFERENCE_DATA AS tob
    ON tob.CODE = bsr.FRK_TYPE_OF_BUS
   AND tob.SUBCLASS = 46            -- Type Of Business
LEFT JOIN PARTY AS brk
    ON brk.OBJECT_ID = bsr.FK_BROKER
LEFT JOIN PARTY AS ced
    ON ced.OBJECT_ID = bsr.FK_CEDENT
LEFT JOIN PARTY AS ins
    ON ins.OBJECT_ID = bsr.FK_INSURED
LEFT JOIN LPC_LIM_PREM_COND AS lpc
    ON lpc.OBJECT_ID = COALESCE(bsr.FK_PC_LIM_PREM, bsr.FK_PC_PREM)
LEFT JOIN CNU_CURRENCY AS cur
    ON cur.ISO_ALPHA = lpc.FK_MAIN_CURRENCY   -- FK is String(3)
LEFT JOIN LPC_PREMIUM AS prem
    ON prem.OBJECT_ID = lpc.FK_TOT_PREM
LEFT JOIN LPC_LIMIT AS lim
    ON lim.OBJECT_ID = lpc.FK_MAIN_LIMIT
WHERE bsr.FRK_TYPE_OF_BUS IN (SELECT CODE FROM @FacCodes)
  AND bsr.IS_CRNT_STATUS = 'Y'      -- current life-cycle status row
  AND bsr.IS_CURRENT_LCP = 'Y'      -- current life-cycle phase
  -- AND bsr.IS_IP_LATEST = 'Y'     -- optional: latest insured period only
ORDER BY
    bsr.IDENTIFIER,
    lcs.CHANGE_DATE DESC;

