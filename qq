-- Run on SICS
SELECT
    CODE,
    NAME,
    IS_ACTIVE
FROM REFERENCE_DATA
WHERE SUBCLASS = 51
ORDER BY CODE;

-- Spot-check vs DWH major classes
SELECT CODE, NAME
FROM REFERENCE_DATA
WHERE SUBCLASS = 51
  AND (
        CODE IN ('03','04','09','12','14','17','20','22','23')
     OR NAME LIKE '%FOOD%'
     OR NAME LIKE '%CEMENT%'
     OR NAME LIKE '%TEXTILE%'
     OR NAME LIKE '%HAZARDOUS%'
     OR NAME LIKE '%PLASTIC%'
     OR NAME LIKE '%METAL%'
     OR NAME LIKE '%WHOLESALE%'
     OR NAME LIKE '%WOOD%'
      )
ORDER BY CODE;
