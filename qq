SELECT TOP (30)
    b.IDENTIFIER              AS business_id,
    ip.BUS_INS_PER_ID         AS insured_period_id,
    ip.UNDERWR_YEAR           AS uw_year,
    lpc.FK_MAIN_CURRENCY      AS pag_original_ccy,
    b.FK_FUNCTIONAL_CCY       AS pag_base_ccy_candidate,
    lim.AMOUNT                AS pag_amount_original,
    lim.LIMIT_PERCENT         AS limit_percent,
    lim.IS_UNLIMITED          AS is_unlimited,
    lim.FRK_LIMIT_TYPE        AS limit_type_code,
    lim.IS_ORIGINAL           AS is_original,
    lpc.IS_CURRENT_OF_IP      AS is_current_of_ip
FROM LPC_LIM_PREM_COND lpc
INNER JOIN LPC_LIMIT lim
    ON lim.OBJECT_ID = lpc.FK_ANN_AGG_LIMIT
INNER JOIN INSURED_PERIOD ip
    ON ip.OBJECT_ID = lpc.FK_INSURED_PERIOD
INNER JOIN BUSINESS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
WHERE lpc.FK_ANN_AGG_LIMIT IS NOT NULL
ORDER BY b.IDENTIFIER, ip.UNDERWR_YEAR;

