SELECT
    c.ISO_ALPHA_2                       AS CTRY_COUNTRY_CODE,
    c.NAME                              AS CTRY_COUNTRY_NAME,
    r.NAME                              AS CTRY_PARTNER_REGION_NAME,
    r.CODE                              AS CTRY_SRE_REGION_CODE,
    r.NAME                              AS CTRY_SRE_REGION_NAME
FROM SICS.LEGAL_AREA AS c
OUTER APPLY (
    SELECT TOP (1)
        rg.CODE,
        rg.NAME
    FROM SICS.AREA_GROUP_COUNTRY AS agc
    INNER JOIN SICS.LEGAL_AREA AS rg
            ON rg.OBJECT_ID = agc.FK_AREA_GROUP
           AND rg.SUBCLASS = 4
           AND rg.FRK_AREA_GRP_CTGRY = 'REGION'
    WHERE agc.FK_COUNTRY = c.OBJECT_ID
    ORDER BY rg.CODE
) AS r
WHERE c.SUBCLASS = 1
  AND c.IS_ACTIVE = 'Y'
ORDER BY c.ISO_ALPHA_2;
