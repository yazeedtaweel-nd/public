-- DIM_FAC_SUBMISSION source extract (facultative / business grain)
SELECT
    bsr.IDENTIFIER               AS SBMS_BK,             -- S... business id
    bsr.TITLE                    AS SBMS_TITLE,
    bsr.IDENTIFIER_PREV          AS SBMS_TAKEN_FROM_REF, -- prior Q...
    bsr.IDENTIFIER_CURR          AS SBMS_TAKEN_TO_REF_ALT,
    bsr.IDENTIFIER               AS SBMS_TAKEN_TO_REF_WHEN_BOUND,
    bsr.INCEPTION_DATE           AS SBMS_INCEPTION_DATE,
    bsr.INSRD_PERIOD_START       AS SBMS_START_DATE,
    bsr.INSRD_PERIOD_END         AS SBMS_EXPIRY_DATE,
    bsr.FRK_TYPE_OF_BUS,
    bsr.FRK_LC_STAT_CURR,
    bsr.FRK_BASICSTAT_CURR,
    bsr.LOB_REF_NM,
    bsr.INSURED_COUNTRY,

    uw.USER_ID                   AS SBMS_ENTERED_BY,
    uw.SHORTNAME                 AS SBMS_UDT_LOGIN,
    lcs.CHANGE_DATE              AS SBMS_ENTRY_DATE,

    rd_lc.NAME                   AS SUBMS_STATUS,        -- confirm table 90 vs 89/91
    brok.IDENTIFIER              AS BROKER_BK,
    ced.IDENTIFIER               AS COMPANY_BK,
    ins.IDENTIFIER               AS OIN_BK,

    curr.ISO_ALPHA               AS SBMS_EPI_CURRENCY,
    prem.BASE_AMOUNT             AS SBMS_EPI_AMOUNT_BASE,
    prem.CURRENT_AMOUNT          AS SBMS_EPI_AMOUNT_ORIGIN_CAND,
    lim.AMOUNT                   AS SBMS_TSI_AMOUNT_CAND
FROM BUS_STRUCT_REP bsr
LEFT JOIN CNU_USER uw
       ON uw.OBJECT_ID = bsr.FK_UNDERW_CURR
LEFT JOIN LIFE_CYCLE_STATUS lcs
       ON lcs.OBJECT_ID = bsr.FK_LC_STATUS_CURR
LEFT JOIN REFERENCE_DATA rd_lc
       ON rd_lc.CODE = bsr.FRK_LC_STAT_CURR
      AND rd_lc.TABLE_ID = 90                 -- Agreement LC status; confirm
LEFT JOIN PARTY brok
       ON brok.OBJECT_ID = bsr.FK_BROKER
LEFT JOIN PARTY ced
       ON ced.OBJECT_ID = bsr.FK_CEDENT
LEFT JOIN PARTY ins
       ON ins.OBJECT_ID = bsr.FK_INSURED
LEFT JOIN LPC_LIM_PREM_COND lpc
       ON lpc.OBJECT_ID = COALESCE(bsr.FK_PC_LIM_PREM, bsr.FK_PC_PREM)
LEFT JOIN LPC_PREMIUM prem
       ON prem.OBJECT_ID = lpc.FK_TOT_PREM    -- confirm premium FK
LEFT JOIN LPC_LIMIT lim
       ON lim.OBJECT_ID = lpc.FK_MAIN_LIMIT
LEFT JOIN CNU_CURRENCY curr
       ON curr.OBJECT_ID = lpc.FK_MAIN_CURRENCY
WHERE bsr.FRK_TYPE_OF_BUS IN ('PROPFAC', 'NONPROPFAC');  -- confirm real codes


