select REFERENCE_ID, c.CLAIM_IDENTIFIER  from SICS.CLAIMS as c
left JOIN SICS.SOC_TO_CLAIM_REL scr
    ON scr.FK_CLAIM = c.OBJECT_ID
LEFT JOIN (
    SELECT FK_SOC_REL, MIN(REFERENCE_ID) AS REFERENCE_ID
    FROM SICS.CLAIM_REFS
    GROUP BY FK_SOC_REL
) cref ON cref.FK_SOC_REL = scr.OBJECT_ID
where cref.REFERENCE_ID = 'C1113XAE0957'
