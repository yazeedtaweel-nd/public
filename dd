SELECT
    dtl.OBJECT_ID            AS DETAIL_ID,
    dtl.FK_BALANCE           AS BALANCE_ID,
    dtl.DTL_AMT,
    dtl.DTL_UNR_AMT,
    bal.LEDGER_BAL_ORG_AMT,
    bal.SETTLED_AMT,
    COUNT(*) OVER (PARTITION BY dtl.FK_BALANCE) AS DETAILS_PER_BALANCE
FROM sics.AC_LEDGER_DETAIL AS dtl
INNER JOIN sics.AC_LEDGER_BALANCE AS bal
        ON bal.OBJECT_ID = dtl.FK_BALANCE
WHERE dtl.DTL_AMT <> ISNULL(dtl.DTL_UNR_AMT, -999999999)   -- picks rows that ARE partially released
ORDER BY DETAILS_PER_BALANCE DESC, dtl.FK_BALANCE;
