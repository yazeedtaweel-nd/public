/* FACT_IW_TRANSACTION / FACT_OW_TRANSACTION
   Grain: 1 row per AC_LEDGER_DETAIL
   IW: @IsOutward = 'N'    OW: @IsOutward = 'Y'

   BROK_BK = PARTY_IDENTIFIER.IDENTIFIER (FORMERID), else PARTY.IDENTIFIER
   Broker party: SUBCLASS = 4 and BUS_PARTNER_CAT category B / BOUT (table 23)
   COMP_BK: same derivation as DIM_COMPANY.COMP_BK
            COALESCE(NULLIF(TRIM(FORMERID), ''), PARTY.IDENTIFIER)
            for AC_LEDGER_BALANCE.FK_BASE_COMPANY, SUBCLASS = 4, category CE / SEC
*/
DECLARE @IsOutward CHAR(1) = 'N';

SELECT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    )                                                    AS POLICY_BK,
    COALESCE(
        COALESCE(cref_ow.REFERENCE_ID, clm_ow.CLAIM_IDENTIFIER),
        COALESCE(cref_bal.REFERENCE_ID, clm_bal.CLAIM_IDENTIFIER)
    )                                                    AS CLA_CLAIM_BK,
    brk.BROK_BK                                          AS BROK_BK,
    comp.COMP_BK                                         AS COMP_BK,

    CONVERT(int, CONVERT(char(8), ws.BOOKING_DATE, 112)) AS TRANS_AUDIT_DATE_SRGT,
    ws.ID_SERIE_NO                                       AS TRANS_AUDIT_NUM,
    CONVERT(int,
        CONVERT(char(4), bal.BOOKING_YEAR)
        + RIGHT('0' + REPLACE(bal.FRK_BOOKING_PERIOD, 'M', ''), 2)
        + '01'
    )                                                    AS TRANS_PROCESSING_PERIOD_SRGT,
    ec.CODE                                              AS TRST_BK,
    CONVERT(int, CONVERT(char(8), dtl.AC_START_DATE, 112)) AS TRANS_ACCOUNTING_FROM_DATE_SRGT,
    CONVERT(int, CONVERT(char(8), dtl.AC_END_DATE, 112))   AS TRANS_ACCOUNTING_TO_DATE_SRGT,

    CAST(dtl.EXCH_AMT     AS money)                      AS TRANS_BASE_GROSS_AMT,
    CAST(dtl.FUNC_AMT2    AS money)                      AS TRANS_BASE2_GROSS_AMT,
    CAST(bal.SETTLED_AMT  AS money)                      AS TRANS_SETT_GROSS_AMT,
    CAST(dtl.DTL_AMT      AS money)                      AS TRANS_ORIG_GROSS_AMT,

    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    )                                                    AS IW_POLICY_BK,
    CASE WHEN bal.IS_OUTWARD = 'Y' THEN
        CAST(
            COALESCE(
                NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
                LTRIM(RTRIM(ip.BUS_INS_PER_ID))
            ) AS nvarchar(50)
        )
    END                                                  AS OW_POLICY_BK,

    bal.FK_CURR                                          AS CURR_ORIG_BK,
    bal.FK_AC_FUNC_CCY                                   AS CURR_BASE_BK,
    COALESCE(bal.FK_LLOYDS_SETL_CUR, bal.FK_CURR)        AS CURR_SETT_BK,
    usr.USER_ID                                          AS USR_BK,
    CASE
        WHEN ws.EXTERNAL_ID LIKE 'TW|%'
            THEN STUFF(ws.EXTERNAL_ID, 1, 3, '')
        ELSE CONVERT(varchar(8), ws.BOOKING_DATE, 112)
             + '|' + CONVERT(varchar(20), ws.ID_SERIE_NO)
    END                                                  AS WRKS_BK

FROM sics.AC_LEDGER_DETAIL AS dtl
INNER JOIN sics.AC_LEDGER_BALANCE AS bal
        ON bal.OBJECT_ID = dtl.FK_BALANCE
       AND bal.IS_OUTWARD = @IsOutward
LEFT JOIN sics.AC_WORKSHEET AS ws
        ON ws.OBJECT_ID = dtl.FK_WORKSHEET
LEFT JOIN sics.ENTRY_CODE AS ec
        ON ec.OBJECT_ID = dtl.FK_ENTRY_CODE
LEFT JOIN sics.CNU_USER AS usr
        ON usr.OBJECT_ID = ws.FK_REGISTERED_BY
LEFT JOIN sics.INSURED_PERIOD AS ip
        ON ip.OBJECT_ID = dtl.FK_INS_PER

LEFT JOIN sics.SOC_TO_CLAIM_REL AS soc
        ON soc.OBJECT_ID = bal.FK_CLAIM
LEFT JOIN sics.CLAIMS AS clm_bal
        ON clm_bal.OBJECT_ID = soc.FK_CLAIM
OUTER APPLY (
    SELECT TOP (1) r.REFERENCE_ID
    FROM sics.CLAIM_REFS AS r
    WHERE r.FK_SOC_REL = soc.OBJECT_ID
    ORDER BY r.REFERENCE_ID
) AS cref_bal
LEFT JOIN sics.CLAIMS AS clm_ow
        ON clm_ow.OBJECT_ID = dtl.FK_CLAIM_TO_SOC
OUTER APPLY (
    SELECT TOP (1) r.REFERENCE_ID
    FROM sics.SOC_TO_CLAIM_REL AS scr
    INNER JOIN sics.CLAIM_REFS AS r
            ON r.FK_SOC_REL = scr.OBJECT_ID
    WHERE scr.FK_CLAIM = clm_ow.OBJECT_ID
    ORDER BY r.REFERENCE_ID
) AS cref_ow

OUTER APPLY (
    SELECT TOP (1)
           COALESCE(NULLIF(LTRIM(RTRIM(pid.IDENTIFIER)), ''), p.IDENTIFIER) AS COMP_BK
    FROM sics.PARTY AS p
    OUTER APPLY (
        SELECT TOP (1) pi.IDENTIFIER
        FROM sics.PARTY_IDENTIFIER AS pi
        WHERE pi.FK_PARTY = p.OBJECT_ID
          AND pi.FRK_PARTY_ID_TYPE = 'FORMERID'
        ORDER BY pi.OBJECT_ID
    ) AS pid
    WHERE p.OBJECT_ID = bal.FK_BASE_COMPANY
      AND p.SUBCLASS = 4
      AND EXISTS (
          SELECT 1
          FROM sics.BUS_PARTNER_CAT AS cat
          WHERE cat.FK_PARTNER = p.OBJECT_ID
            AND cat.FRK_CATEGORY IN ('CE', 'SEC')
      )
) AS comp

OUTER APPLY (
    SELECT TOP (1)
           COALESCE(pid.IDENTIFIER, bp.IDENTIFIER) AS BROK_BK
    FROM sics.BUSINESS_PRTNR_REL AS bpr
    INNER JOIN sics.PARTY AS bp
            ON bp.OBJECT_ID = bpr.FK_BUS_PARTNER
           AND bp.SUBCLASS = 4
    INNER JOIN sics.BUS_PARTNER_CAT AS bpc
            ON bpc.FK_PARTNER = bp.OBJECT_ID
           AND bpc.FSK_CATEGORY = 23
           AND bpc.FRK_CATEGORY IN ('B', 'BOUT')
    LEFT JOIN sics.PARTY_IDENTIFIER AS pid
            ON pid.FK_PARTY = bp.OBJECT_ID
           AND pid.FRK_PARTY_ID_TYPE = 'FORMERID'
    WHERE bpr.FRK_RELSHIP_TYPE = 'BR'
      AND bpr.FSK_RELSHIP_TYPE = 55
      AND bpr.FK_INS_PERIOD = dtl.FK_INS_PER
    ORDER BY bp.OBJECT_ID, pid.OBJECT_ID
) AS brk;
