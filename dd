-- =============================================
-- Currency (referenced by LEGAL_AREA.FK_MAIN_CURR)
-- =============================================
CREATE TABLE dbo.CNU_CURRENCY (
    OBJECT_ID   INT             NOT NULL PRIMARY KEY,
    CODE        VARCHAR(10)     NOT NULL,          -- ISO currency code
    NAME        VARCHAR(100)    NULL
);

-- =============================================
-- LEGAL_AREA  (polymorphic: Country + Area Group)
-- =============================================
CREATE TABLE dbo.LEGAL_AREA (
    OBJECT_ID           INT             NOT NULL PRIMARY KEY,
    SUBCLASS            INT             NOT NULL,   -- 1 = Country, 4 = AreaGroup
    CODE                VARCHAR(50)     NULL,
    UNIQUE_CODE         VARCHAR(50)     NULL,
    ISO_ALPHA_2         CHAR(2)         NULL,
    ISO_ALPHA_3         CHAR(3)         NULL,
    ISO_NUMERIC         VARCHAR(10)     NULL,
    ALTERNATE_ID        VARCHAR(50)     NULL,
    SHORT_NAME          VARCHAR(50)     NULL,
    NAME                VARCHAR(200)    NULL,
    IS_ACTIVE           CHAR(1)         NULL DEFAULT 'Y',
    PHONE_PREFIX        VARCHAR(20)     NULL,
    FK_MAIN_CURR        INT             NULL,       -- → CNU_CURRENCY
    FRK_AREA_GRP_CTGRY  INT             NULL,       -- REFERENCE_DATA type 20 (Area Group only)
    CONSTRAINT FK_LA_CURRENCY FOREIGN KEY (FK_MAIN_CURR) REFERENCES dbo.CNU_CURRENCY(OBJECT_ID)
);

-- =============================================
-- AREA_GROUP_COUNTRY  (junction)
-- =============================================
CREATE TABLE dbo.AREA_GROUP_COUNTRY (
    OBJECT_ID       INT             NOT NULL PRIMARY KEY,  -- optional
    FK_COUNTRY      INT             NOT NULL,              -- → LEGAL_AREA (SUBCLASS=1)
    FK_AREA_GROUP   INT             NOT NULL,              -- → LEGAL_AREA (SUBCLASS=4)
    CONSTRAINT FK_AGC_COUNTRY    FOREIGN KEY (FK_COUNTRY)    REFERENCES dbo.LEGAL_AREA(OBJECT_ID),
    CONSTRAINT FK_AGC_AREA_GROUP FOREIGN KEY (FK_AREA_GROUP) REFERENCES dbo.LEGAL_AREA(OBJECT_ID)
);




