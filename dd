-- =============================================
-- 1. Reporting Unit (location)
-- =============================================
CREATE TABLE dbo.RU_LEAF (
    OBJECT_ID   INT             NOT NULL PRIMARY KEY,
    CODE        VARCHAR(50)     NOT NULL,
    NAME        VARCHAR(100)    NULL
);

-- =============================================
-- 2. User Category (security group)
-- =============================================
CREATE TABLE dbo.USER_CATEGORY (
    OBJECT_ID   INT             NOT NULL PRIMARY KEY,
    NAME        VARCHAR(100)    NOT NULL
);

-- =============================================
-- 3. Users
-- =============================================
CREATE TABLE dbo.CNU_USER (
    OBJECT_ID   INT             NOT NULL PRIMARY KEY,
    USER_ID     VARCHAR(50)     NOT NULL,          -- login
    FIRSTNAME   VARCHAR(100)    NULL,
    LASTNAME    VARCHAR(100)    NULL,
    SHORTNAME   VARCHAR(20)     NULL,          -- initials
    IS_ACTIVE   CHAR(1)         NULL DEFAULT 'Y', -- 'Y' / 'N'
    FK_RU       INT             NULL,          -- → RU_LEAF.OBJECT_ID
    CONSTRAINT FK_CNU_USER_RU FOREIGN KEY (FK_RU) REFERENCES dbo.RU_LEAF(OBJECT_ID)
);

-- =============================================
-- 4. Junction: User ↔ Category
-- =============================================
CREATE TABLE dbo.USER_USERCATEGORY (
    OBJECT_ID       INT             NOT NULL PRIMARY KEY,  -- optional surrogate
    FK_USER         INT             NOT NULL,              -- → CNU_USER.OBJECT_ID
    FK_USERCATEGORY INT             NOT NULL,              -- → USER_CATEGORY.OBJECT_ID
    CONSTRAINT FK_UUC_USER FOREIGN KEY (FK_USER) REFERENCES dbo.CNU_USER(OBJECT_ID),
    CONSTRAINT FK_UUC_CAT  FOREIGN KEY (FK_USERCATEGORY) REFERENCES dbo.USER_CATEGORY(OBJECT_ID)
);

