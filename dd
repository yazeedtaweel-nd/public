SELECT
    z.CODE AS CRZ_BK,
    CASE
        WHEN p.PERIL_CODE IS NOT NULL
            THEN UPPER(CONCAT(la.NAME, ' - (', z.NAME, ')'))
        ELSE la.NAME + ' - ' + z.NAME
    END AS CRZ_NAME,
    COALESCE(la.CODE, la.ISO_ALPHA_2) AS CTRY_COUNTRY_CODE,
    la.NAME AS COUNTRY_NAME,
    z.NAME AS ZONE_NAME,
    p.PERIL_CODE,
    p.PERIL_NAME
FROM SICS.RISK_ZONE AS ctry
JOIN SICS.RISK_ZONE AS z
    ON z.FK_PARENT = ctry.OBJECT_ID
   AND z.SUBCLASS = 1
JOIN SICS.LEGAL_AREA AS la
    ON la.OBJECT_ID = ctry.FK_COUNTRY
   AND la.SUBCLASS = 1
OUTER APPLY (
    SELECT TOP (1)
        rd.CODE AS PERIL_CODE,
        rd.NAME AS PERIL_NAME
    FROM SICS.RZ_CTR_TO_REF AS rzp
    JOIN SICS.REFERENCE_DATA AS rd
        ON rd.CODE = rzp.FRK_PERIL_TYPE
       AND rd.SUBCLASS = rzp.FSK_PERIL_TYPE
       AND rd.SUBCLASS = 44
    WHERE rzp.FK_RZ_COUNTRY = ctry.OBJECT_ID
    ORDER BY rd.CODE
) AS p
WHERE ctry.SUBCLASS = 2
ORDER BY z.CODE;
