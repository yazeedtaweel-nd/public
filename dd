SELECT DISTINCT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip_occ.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip_occ.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK,
    CAST(LTRIM(RTRIM(p.IDENTIFIER)) AS nvarchar(50)) AS BROKER_BK
FROM SICS.INSURED_PERIOD AS ip_place
INNER JOIN SICS.INSURED_PERIOD AS ip_occ
    ON ip_occ.OBJECT_ID = ip_place.FK_OCC
INNER JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_INS_PERIOD = ip_occ.OBJECT_ID
   AND bsr.IS_CURRENT_LCP = N'Y'
   AND bsr.IS_CURRENT_AM = N'Y'
INNER JOIN SICS.BUSINESS AS b_occ
    ON b_occ.OBJECT_ID = bsr.FK_BUSINESS
INNER JOIN SICS.BUSINESS_PRTNR_REL AS r
    ON r.FK_INS_PERIOD = ip_place.OBJECT_ID
    OR r.FK_BUSINESS = ip_place.FK_BUSINESS
INNER JOIN SICS.PARTY AS p
    ON p.OBJECT_ID = r.FK_BUS_PARTNER
WHERE ip_place.SUBCLASS = 12
  AND b_occ.SUBCLASS IN (3, 8, 11)
  AND r.FSK_RELSHIP_TYPE = 55
  AND r.FRK_RELSHIP_TYPE = N'BR'
  AND r.SUBCLASS = 10
  AND COALESCE(
        NULLIF(LTRIM(RTRIM(ip_occ.I_PERIOD_FORMER_ID)), N''),
        NULLIF(LTRIM(RTRIM(ip_occ.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL;
