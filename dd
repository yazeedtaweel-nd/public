SELECT
    z.CODE AS CRZ_BK,
    la.NAME + ' - ' + z.NAME AS CRZ_NAME,
    COALESCE(la.CODE, la.ISO_ALPHA_2) AS CTRY_COUNTRY_CODE,
    la.NAME AS COUNTRY_NAME,
    z.NAME AS ZONE_NAME,
    CAST(NULL AS VARCHAR(15)) AS PERIL_CODE,
    CAST(NULL AS VARCHAR(60)) AS PERIL_NAME,
    'ZONE' AS ROW_SOURCE
FROM SICS.RISK_ZONE AS ctry
JOIN SICS.RISK_ZONE AS z
    ON z.FK_PARENT = ctry.OBJECT_ID
   AND z.SUBCLASS = 1
JOIN SICS.LEGAL_AREA AS la
    ON la.OBJECT_ID = ctry.FK_COUNTRY
   AND la.SUBCLASS = 1
WHERE ctry.SUBCLASS = 2

UNION ALL

SELECT DISTINCT
    z.CODE AS CRZ_BK,
    UPPER(CONCAT(la.NAME, ' - (', z.NAME, ')')) AS CRZ_NAME,
    COALESCE(la.CODE, la.ISO_ALPHA_2) AS CTRY_COUNTRY_CODE,
    la.NAME AS COUNTRY_NAME,
    z.NAME AS ZONE_NAME,
    CAST(NULL AS VARCHAR(15)) AS PERIL_CODE,
    CAST(NULL AS VARCHAR(60)) AS PERIL_NAME,
    'COUNTRY_PERIL' AS ROW_SOURCE
FROM SICS.RISK_ZONE AS rz
JOIN SICS.RISK_ZONE AS z
    ON z.FK_PARENT = rz.OBJECT_ID
   AND z.SUBCLASS = 1
JOIN SICS.LEGAL_AREA AS la
    ON la.OBJECT_ID = rz.FK_COUNTRY
   AND la.SUBCLASS = 1
JOIN SICS.RZ_CTR_TO_REF AS rzp
    ON rzp.FK_RZ_COUNTRY = rz.OBJECT_ID
JOIN SICS.REFERENCE_DATA AS rd
    ON rd.CODE = rzp.FRK_PERIL_TYPE
   AND rd.SUBCLASS = rzp.FSK_PERIL_TYPE
   AND rd.SUBCLASS = 44
WHERE rz.SUBCLASS = 2

ORDER BY CRZ_BK, ROW_SOURCE;
