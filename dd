DECLARE @ExecutionId BIGINT = 123;  -- replace with the ETL run id

SELECT
    te.TABLE_NAME,
    pe.STATUS,
    te.ROWS_READ,
    te.ROWS_INSERTED,
    te.ROWS_UPDATED,
    te.ROWS_REJECTED,
    te.LOGGED_DATE
FROM audit.ETL_PACKAGE_TABLE_EXECUTION AS te
INNER JOIN audit.ETL_PACKAGE_EXECUTION AS pe
    ON pe.EXECUTION_ID = te.EXECUTION_ID
WHERE te.EXECUTION_ID = @ExecutionId
ORDER BY te.TABLE_NAME;
