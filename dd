SELECT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK,
    CAST(CASE WHEN b.SUBCLASS = 6 THEN N'I' ELSE N'O' END AS nvarchar(50)) AS POLICY_BUSINESS_INDICATOR,
    b.IDENTIFIER AS POLICY_CONTRACT_NUMBER,
    CAST(COALESCE(NULLIF(LTRIM(RTRIM(ip.IP_TITLE)), N''), b.TITLE) AS nvarchar(255)) AS POLICY_NAME,
    occ.OCC_SRGT,
    rd_occ.CODE AS OCC_BK,
    rd_occ.NAME AS OCC_NAME,
    soc.FK_IO,
    COALESCE(
        io_person.FRK_OCCUPATION,
        io_building.FRK_OCCUPATION,
        io_engineer.FRK_ENG_OCC,
        io_electronic.FRK_OCCUPATION
    ) AS OCC_FRK
FROM SICS.BUS_STRUCT_REP AS bsr
INNER JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = bsr.FK_BUSINESS
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = bsr.FK_INS_PERIOD
LEFT JOIN SICS.LIFE_CYCLE_PHASE AS lcp
    ON lcp.FK_INS_PRD = ip.OBJECT_ID
   AND lcp.SEQUENCE_NUMBER = bsr.SEQUENCE_NUMBER
LEFT JOIN SICS.SCOPE_OF_COVER AS soc
    ON soc.FK_LIFECYCLEP = lcp.OBJECT_ID
LEFT JOIN SICS.IO_PERSON AS io_person
    ON io_person.OBJECT_ID = soc.FK_IO
LEFT JOIN SICS.IO_BUILDING AS io_building
    ON io_building.OBJECT_ID = soc.FK_IO
LEFT JOIN SICS.IO_ENGINEER AS io_engineer
    ON io_engineer.OBJECT_ID = soc.FK_IO
LEFT JOIN SICS.IO_ELECTRONIC AS io_electronic
    ON io_electronic.OBJECT_ID = soc.FK_IO
LEFT JOIN SICS.REFERENCE_DATA AS rd_occ
    ON rd_occ.OBJECT_ID = COALESCE(
           io_person.FRK_OCCUPATION,
           io_building.FRK_OCCUPATION,
           io_engineer.FRK_ENG_OCC,
           io_electronic.FRK_OCCUPATION
       )
   AND rd_occ.SUBCLASS = 534
LEFT JOIN SaudiRe_DW.dbo.DIM_OCCUPATION AS occ
    ON occ.OCC_BK = rd_occ.CODE
WHERE b.SUBCLASS IN (6, 3, 8, 11)
  AND COALESCE(
        NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
        NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL
  AND bsr.IS_CURRENT_LCP = N'Y'
  AND bsr.IS_CURRENT_AM = N'Y'
ORDER BY POLICY_BK, POLICY_BUSINESS_INDICATOR;
