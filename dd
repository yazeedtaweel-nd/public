DECLARE @POLICY_IDENTIFIER nvarchar(50) = N'PUT_IW_IDENTIFIER_HERE';

SELECT
    b.IDENTIFIER,
    b.SUBCLASS,
    CASE
        WHEN b.SUBCLASS = 6 THEN N'IW'
        WHEN b.SUBCLASS IN (3, 8, 11) THEN N'OW'
    END AS DIRECTION,
    CASE
        WHEN b.SUBCLASS = 6
            THEN COALESCE(sh.CEDED_OF_100, sh.CEDED)
        WHEN b.SUBCLASS IN (3, 8, 11)
            THEN COALESCE(sh.CEDED_OF_100, sh.CEDED, sh_occ.CEDED_OF_100, sh_occ.CEDED)
    END AS POLICY_CEDED_PERCENT
FROM SICS.BUSINESS AS b
OUTER APPLY (
    SELECT TOP (1)
        bsr.FK_COND_CONT,
        bsr.FK_IP_OCC,
        bsr.AMNDMNT_NMBR
    FROM SICS.BUS_STRUCT_REP AS bsr
    WHERE bsr.FK_BUSINESS = b.OBJECT_ID
    ORDER BY bsr.AMNDMNT_NMBR DESC, bsr.SEQUENCE_NUMBER DESC
) AS bsr
OUTER APPLY (
    SELECT TOP (1)
        s.CEDED,
        s.CEDED_OF_100
    FROM SICS.BC_SHARE AS s
    WHERE s.FK_COND_CONTAINER = bsr.FK_COND_CONT
      AND s.FK_EVENT_REV IS NULL
    ORDER BY s.OBJECT_ID DESC
) AS sh
OUTER APPLY (
    SELECT TOP (1) occ_bsr.FK_COND_CONT
    FROM SICS.BUS_STRUCT_REP AS occ_bsr
    WHERE occ_bsr.FK_INS_PERIOD = bsr.FK_IP_OCC
    ORDER BY occ_bsr.AMNDMNT_NMBR DESC, occ_bsr.SEQUENCE_NUMBER DESC
) AS occ
OUTER APPLY (
    SELECT TOP (1)
        s.CEDED,
        s.CEDED_OF_100
    FROM SICS.BC_SHARE AS s
    WHERE s.FK_COND_CONTAINER = occ.FK_COND_CONT
      AND s.FK_EVENT_REV IS NULL
    ORDER BY s.OBJECT_ID DESC
) AS sh_occ
WHERE b.SUBCLASS IN (3, 6, 8, 11)
  AND b.IDENTIFIER = @POLICY_IDENTIFIER;
