WITH Combined AS
(
    -- ZONE records
    SELECT
        z.CODE AS CRZ_BK,
        la.NAME + ' - ' + z.NAME AS CRZ_NAME,
        COALESCE(la.CODE, la.ISO_ALPHA_2) AS CTRY_COUNTRY_CODE,
        la.NAME AS COUNTRY_NAME,
        z.NAME AS ZONE_NAME,
        CAST(NULL AS VARCHAR(15)) AS PERIL_CODE,
        CAST(NULL AS VARCHAR(60)) AS PERIL_NAME,
        'ZONE' AS ROW_SOURCE,
        z.OBJECT_ID AS ZONE_ID
    FROM SICS.RISK_ZONE AS ctry
    JOIN SICS.RISK_ZONE AS z
        ON z.FK_PARENT = ctry.OBJECT_ID
       AND z.SUBCLASS = 1
    JOIN SICS.LEGAL_AREA AS la
        ON la.OBJECT_ID = ctry.FK_COUNTRY
       AND la.SUBCLASS = 1
    WHERE ctry.SUBCLASS = 2

    UNION ALL

    -- COUNTRY_PERIL records
    SELECT
        z.CODE AS CRZ_BK,
        UPPER(CONCAT(la.NAME, ' - (', z.NAME, ')')) AS CRZ_NAME,
        COALESCE(la.CODE, la.ISO_ALPHA_2) AS CTRY_COUNTRY_CODE,
        la.NAME AS COUNTRY_NAME,
        z.NAME AS ZONE_NAME,
        CAST(NULL AS VARCHAR(15)) AS PERIL_CODE,
        CAST(NULL AS VARCHAR(60)) AS PERIL_NAME,
        'COUNTRY_PERIL' AS ROW_SOURCE,
        z.OBJECT_ID AS ZONE_ID
    FROM SICS.RISK_ZONE AS rz
    JOIN SICS.RISK_ZONE AS z
        ON z.FK_PARENT = rz.OBJECT_ID
       AND z.SUBCLASS = 1
    JOIN SICS.LEGAL_AREA AS la
        ON la.OBJECT_ID = rz.FK_COUNTRY
       AND la.SUBCLASS = 1
    WHERE rz.SUBCLASS = 2
      AND EXISTS
      (
          SELECT 1
          FROM SICS.RZ_CTR_TO_REF AS rzp
          JOIN SICS.REFERENCE_DATA AS rd
              ON rd.CODE = rzp.FRK_PERIL_TYPE
             AND rd.SUBCLASS = rzp.FSK_PERIL_TYPE
             AND rd.SUBCLASS = 44
          WHERE rzp.FK_RZ_COUNTRY = rz.OBJECT_ID
      )
),
Deduplicated AS
(
    SELECT
        *,
        ROW_NUMBER() OVER
        (
            PARTITION BY ZONE_ID
            ORDER BY
                CASE
                    WHEN ROW_SOURCE = 'ZONE' THEN 1
                    ELSE 2
                END
        ) AS rn
    FROM Combined
)
SELECT
    CRZ_BK,
    CRZ_NAME,
    CTRY_COUNTRY_CODE,
    COUNTRY_NAME,
    ZONE_NAME,
    PERIL_CODE,
    PERIL_NAME,
    ROW_SOURCE
FROM Deduplicated
WHERE rn = 1
ORDER BY
    CRZ_BK,
    ROW_SOURCE;
