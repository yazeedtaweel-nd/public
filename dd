DECLARE @POLICY_IDENTIFIER nvarchar(50) = N'IPF16817';

SELECT
    b.OBJECT_ID AS BUSINESS_OBJECT_ID,
    b.IDENTIFIER,
    b.SUBCLASS,
    bsr.OBJECT_ID AS BSR_OBJECT_ID,
    bsr.FK_PC_SHARE,
    bsr.FK_IP_OCC,
    bsr.FK_INS_PERIOD,
    bsr.SEQUENCE_NUMBER
FROM SICS.BUSINESS AS b
INNER JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_BUSINESS = b.OBJECT_ID
WHERE b.IDENTIFIER = @POLICY_IDENTIFIER
  AND b.SUBCLASS IN (3, 6, 8, 11)
  AND bsr.IS_CURRENT_LCP = N'Y'
  AND bsr.IS_CURRENT_AM = N'Y'
ORDER BY bsr.SEQUENCE_NUMBER;
