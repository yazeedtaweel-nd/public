SELECT 
    u.OBJECT_ID AS SRC_OBJECT_ID,
    u.USER_ID AS USR_LOGIN,
    LTRIM(RTRIM(u.FIRSTNAME)) + ' ' + LTRIM(RTRIM(u.LASTNAME)) AS USR_USER_NAME,
    u.SHORTNAME AS USR_INITIALS,
    CAST(NULL AS VARCHAR(20)) AS USR_SYN_NUMBER,
    cat.USR_USER_GROUP,
    ru.CODE AS USR_LOCATION_CODE,
    CAST('N' AS CHAR(1)) AS USR_UNDERWRITER_IND,
    CASE WHEN UPPER(ISNULL(u.IS_ACTIVE, 'Y')) = 'N' THEN 'Y' ELSE 'N' END AS USR_DELETED_IND
FROM dbo.CNU_USER u
LEFT JOIN dbo.RU_LEAF ru 
    ON ru.OBJECT_ID = u.FK_RU
OUTER APPLY (
    SELECT TOP (1) c.NAME AS USR_USER_GROUP
    FROM dbo.USER_USERCATEGORY ju
    INNER JOIN dbo.USER_CATEGORY c 
        ON c.OBJECT_ID = ju.FK_USERCATEGORY
    WHERE ju.FK_USER = u.OBJECT_ID
    ORDER BY c.NAME
) cat;

