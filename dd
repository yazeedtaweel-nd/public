/* FACT_SETTLEMENT — SICS parent extract

   Grain:
     Exactly one row per Settlement Balance/Provision:
     settlement_balance.OBJECT_ID

   All 29 target columns are represented.

   Child-level dimensions are intentionally NULL because a settlement
   may contain multiple worksheets, policies, claims and transactions.

   SETTLEMENT_BK is the source key required to link:
     FACT_SETTLEMENT → FACT_TRA_SETTLEMENT
*/

WITH EligibleMember AS
(
    SELECT
        bal.OBJECT_ID,
        bal.FK_SETTLEMENT_BAL,
        bal.FK_AC_FUNC_CCY,
        bal.FK_CURR,
        bal.SETTLED_AMT,
        bal.FRK_GL_ACCOUNT
    FROM SICS.AC_LEDGER_BALANCE AS bal
    WHERE bal.FK_SETTLEMENT_BAL IS NOT NULL
      AND bal.IS_PART_SET_BAL = 'Y'
),
MemberAggregate AS
(
    SELECT
        member.FK_SETTLEMENT_BAL AS SETTLEMENT_BK,

        /* Return a value only when all members share one currency */
        CASE
            WHEN COUNT(DISTINCT member.FK_AC_FUNC_CCY) = 1
            THEN MIN(member.FK_AC_FUNC_CCY)
        END AS CURR_BASE_BK,

        CASE
            WHEN COUNT(DISTINCT member.FK_CURR) = 1
            THEN MIN(member.FK_CURR)
        END AS CURR_ORIG_BK,

        /* Each member is counted once */
        SUM(
            CAST(
                COALESCE(member.SETTLED_AMT, 0)
                AS decimal(38, 8)
            )
        ) AS STL_SETT_PTD_AMT,

        /* Return account code only when there is one common code */
        CASE
            WHEN COUNT(DISTINCT member.FRK_GL_ACCOUNT) = 1
            THEN MIN(member.FRK_GL_ACCOUNT)
        END AS STL_ACCOUNT_CODE

    FROM EligibleMember AS member
    GROUP BY member.FK_SETTLEMENT_BAL
),
DetailAggregate AS
(
    SELECT
        member.FK_SETTLEMENT_BAL AS SETTLEMENT_BK,

        /* Gross amounts */
        SUM(
            CAST(
                COALESCE(dtl.EXCH_AMT, 0)
                AS decimal(38, 8)
            )
        ) AS STL_BASE_GROSS_AMT,

        SUM(
            CAST(
                COALESCE(dtl.FUNC_AMT2, 0)
                AS decimal(38, 8)
            )
        ) AS STL_BASE2_GROSS_AMT,

        SUM(
            CAST(
                COALESCE(dtl.DTL_AMT, 0)
                AS decimal(38, 8)
            )
        ) AS STL_ORIG_GROSS_AMT,

        /* Base paid-to-date */
        SUM(
            CAST(
                CASE
                    WHEN NULLIF(dtl.DTL_AMT, 0) IS NULL
                        THEN 0
                    ELSE
                        dtl.EXCH_AMT
                        * (
                            (
                                dtl.DTL_AMT
                                - COALESCE(dtl.DTL_UNR_AMT, 0)
                            )
                            / NULLIF(dtl.DTL_AMT, 0)
                        )
                END
                AS decimal(38, 8)
            )
        ) AS STL_BASE_PTD_AMT,

        /* Base currency 2 paid-to-date */
        SUM(
            CAST(
                CASE
                    WHEN NULLIF(dtl.DTL_AMT, 0) IS NULL
                        THEN 0
                    ELSE
                        dtl.FUNC_AMT2
                        * (
                            (
                                dtl.DTL_AMT
                                - COALESCE(dtl.DTL_UNR_AMT, 0)
                            )
                            / NULLIF(dtl.DTL_AMT, 0)
                        )
                END
                AS decimal(38, 8)
            )
        ) AS STL_BASE2_PTD_AMT,

        /* Original currency paid-to-date */
        SUM(
            CAST(
                COALESCE(dtl.DTL_AMT, 0)
                - COALESCE(dtl.DTL_UNR_AMT, 0)
                AS decimal(38, 8)
            )
        ) AS STL_ORIG_PTD_AMT

    FROM EligibleMember AS member
    INNER JOIN SICS.AC_LEDGER_DETAIL AS dtl
        ON dtl.FK_BALANCE = member.OBJECT_ID
    GROUP BY member.FK_SETTLEMENT_BAL
)
SELECT
    /* Source business key linking parent and children */
    settlement_balance.OBJECT_ID AS SETTLEMENT_BK,

    /* 1. STL_AUDIT_DATE_SRGT */
    TRY_CONVERT(
        int,
        CONVERT(
            char(8),
            settlement_balance.DATE_OF_BOOKING,
            112
        )
    ) AS STL_AUDIT_DATE_SRGT,

    /* 2. STL_AUDIT_DATE */
    CAST(
        settlement_balance.DATE_OF_BOOKING
        AS date
    ) AS STL_AUDIT_DATE,

    /* 3. STL_AUDIT_NUM */
    settlement_balance.ID_SERIE_NO
        AS STL_AUDIT_NUM,

    /* 4. STL_EFFECTIVE_DATE */
    CAST(
        COALESCE(
            settlement_balance.VALUE_DATE,
            settlement_balance.DUE_DATE
        )
        AS date
    ) AS STL_EFFECTIVE_DATE,

    /* 5. STL_RECONCILED_DATE */
    CAST(
        settlement_balance.ACTUAL_SETLMT_DATE
        AS date
    ) AS STL_RECONCILED_DATE,

    /* 6. STL_PROCESSING_PERIOD_SRGT */
    TRY_CONVERT(
        int,
        CONVERT(
            char(4),
            settlement_balance.BOOKING_YEAR
        )
        + RIGHT(
            '0' + REPLACE(
                UPPER(
                    LTRIM(
                        RTRIM(
                            settlement_balance.FRK_BOOKING_PERIOD
                        )
                    )
                ),
                'M',
                ''
            ),
            2
        )
        + '01'
    ) AS STL_PROCESSING_PERIOD_SRGT,

    /*
       7–14: Child-level dimensions.

       A parent settlement can contain several worksheets,
       transaction codes, policies, claims and brokers.
       Therefore, these cannot safely be populated at parent grain.
    */
    CAST(NULL AS int) AS WRKS_SRGT,
    CAST(NULL AS int) AS TRST_SRGT,
    CAST(NULL AS int) AS TRCD_SRGT,
    CAST(NULL AS int) AS STL_ENTRY_TYPE_SRGT,
    CAST(NULL AS int) AS STL_STATUS_SRGT,
    CAST(NULL AS int) AS POLICY_SRGT,
    CAST(NULL AS int) AS CLA_CLAIM_SRGT,
    CAST(NULL AS int) AS BROK_SRGT,

    /* 15. CURR_BASE_SRGT lookup business key */
    members.CURR_BASE_BK,

    /* 16. CURR_SETT_SRGT lookup business key */
    settlement_balance.FK_CURR
        AS CURR_SETT_BK,

    /* 17. CURR_ORIG_SRGT lookup business key */
    members.CURR_ORIG_BK,

    /* 18. STL_BASE_GROSS_AMT */
    CAST(
        details.STL_BASE_GROSS_AMT
        AS money
    ) AS STL_BASE_GROSS_AMT,

    /* 19. STL_BASE2_GROSS_AMT */
    CAST(
        details.STL_BASE2_GROSS_AMT
        AS money
    ) AS STL_BASE2_GROSS_AMT,

    /* 20. STL_SETT_GROSS_AMT */
    CAST(
        settlement_balance.LEDGER_BAL_ORG_AMT
        AS money
    ) AS STL_SETT_GROSS_AMT,

    /* 21. STL_ORIG_GROSS_AMT */
    CAST(
        details.STL_ORIG_GROSS_AMT
        AS money
    ) AS STL_ORIG_GROSS_AMT,

    /* 22. STL_BASE_PTD_AMT */
    CAST(
        details.STL_BASE_PTD_AMT
        AS money
    ) AS STL_BASE_PTD_AMT,

    /* 23. STL_BASE2_PTD_AMT */
    CAST(
        details.STL_BASE2_PTD_AMT
        AS money
    ) AS STL_BASE2_PTD_AMT,

    /* 24. STL_SETT_PTD_AMT */
    CAST(
        members.STL_SETT_PTD_AMT
        AS money
    ) AS STL_SETT_PTD_AMT,

    /* 25. STL_ORIG_PTD_AMT */
    CAST(
        details.STL_ORIG_PTD_AMT
        AS money
    ) AS STL_ORIG_PTD_AMT,

    /* 26–27: ETL-generated */
    CAST(NULL AS int) AS CREATED_DATE_SRGT,
    CAST(NULL AS int) AS UPDATED_DATE_SRGT,

    /* 28. STL_ACCOUNT_CODE */
    members.STL_ACCOUNT_CODE,

    /*
       29. CLGRP_SRGT

       A settlement can contain multiple claim groups.
       Claim group remains at FACT_TRA_SETTLEMENT grain.
    */
    CAST(NULL AS int) AS CLGRP_SRGT

FROM SICS.AC_LEDGER_BALANCE AS settlement_balance

INNER JOIN MemberAggregate AS members
    ON members.SETTLEMENT_BK =
       settlement_balance.OBJECT_ID

LEFT JOIN DetailAggregate AS details
    ON details.SETTLEMENT_BK =
       settlement_balance.OBJECT_ID

WHERE settlement_balance.SUBCLASS = 1;
