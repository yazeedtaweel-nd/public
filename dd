/* =============================================================================
   DIM_COUNTRY – SICS extract (proposal)
   Source grain: LEGAL_AREA WHERE SUBCLASS = 1  (SicsCountry)

   Confirmed columns for discussion:
     - Country identity, codes, name, active flag
   Optional (NOT approved as Partner/SRE region):
     - Area / Country Group via AREA_GROUP_COUNTRY
   Not available on LEGAL_AREA:
     - CREATED/UPDATED dates  → DWH/ETL only
     - CTRY_SRGT              → DWH/ETL only
     - SRE region             → no SICS source identified
   ============================================================================= */

SELECT
    /* Technical key in SICS (UUID) – optional staging key, not CTRY_SRGT */
    c.OBJECT_ID                          AS sics_object_id,

    /* Filter discriminator */
    c.SUBCLASS                           AS subclass,          -- expect 1

    /* Business key candidates – team must pick which becomes CTRY_COUNTRY_CODE */
    c.CODE                               AS country_code,      -- SICS legal-area code
    c.UNIQUE_CODE                        AS unique_code,       -- same description as CODE
    c.ISO_ALPHA_2                        AS iso_alpha_2,       -- official ISO-2 (mandatory in DD)
    c.ISO_ALPHA_3                        AS iso_alpha_3,       -- official ISO-3 (mandatory in DD)
    c.ISO_NUMERIC                        AS iso_numeric,
    c.ALTERNATE_ID                       AS alternate_id,      -- non-ISO identifier
    c.SHORT_NAME                         AS short_name,        -- may hold external-system code

    /* Name → CTRY_COUNTRY_NAME candidate */
    c.NAME                               AS country_name,

    /* Useful qualifiers (not in DIM_COUNTRY column list, but useful for DQ) */
    c.IS_ACTIVE                          AS is_active,
    c.PHONE_PREFIX                       AS phone_prefix,
    c.FK_MAIN_CURR                       AS main_currency_id,  -- FK to CNU_CURRENCY.OBJECT_ID

    /* -------------------------------------------------------------------------
       Area / Country Group – CANDIDATE only for Partner Region discussion
       One country can have many groups → may return multiple rows per country
       ------------------------------------------------------------------------- */
    ag.OBJECT_ID                         AS area_group_object_id,
    ag.CODE                              AS area_group_code,
    ag.NAME                              AS area_group_name,   -- candidate for region name?
    ag.FRK_AREA_GRP_CTGRY                AS area_group_category, -- REFERENCE_DATA type 20
    ag.IS_ACTIVE                         AS area_group_is_active

FROM LEGAL_AREA AS c
LEFT JOIN AREA_GROUP_COUNTRY AS agc
       ON agc.FK_COUNTRY = c.OBJECT_ID
LEFT JOIN LEGAL_AREA AS ag
       ON ag.OBJECT_ID = agc.FK_AREA_GROUP
      /* Country Area Group rows (SicsAreaGroupCountry) */
      AND ag.SUBCLASS = 4

WHERE c.SUBCLASS = 1                    -- SicsCountry only
  /* Optional: active countries only – confirm with team
  AND c.IS_ACTIVE = 'Y'
  */
ORDER BY
    c.ISO_ALPHA_2,
    c.CODE,
    ag.CODE;
