SELECT
    rd.SUBCLASS,
    CASE
        WHEN rd.EXTERNAL_CODE is not NULL then rd.EXTERNAL_CODE
        WHEN rd.CODE = 'O' THEN 'OP'
        WHEN rd.CODE = 'C' THEN 'CL'
        ELSE rd.CODE
    END AS CODE,
    rd.NAME,
    CASE WHEN rd.CODE = 'C' THEN 2
    ELSE 1
END AS TYPE,
  CAST(CASE WHEN rd.IS_ACTIVE       = 'Y' THEN 1 ELSE 0 END AS BIT) AS SICS_IS_ACTIVE
FROM SICS.REFERENCE_DATA AS rd
WHERE rd.SUBCLASS = 517
ORDER BY rd.CODE;
