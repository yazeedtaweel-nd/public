SELECT
    rd.CODE              AS LSTP_BK,
    rd.NAME              AS LSTP_NAME,
    CAST(CASE WHEN rd.IS_ACTIVE       = 'Y' THEN 1 ELSE 0 END AS BIT) AS LSTP_IS_ACTIVE,
    CAST(CASE WHEN rd.IS_DEFAULT      = 'Y' THEN 1 ELSE 0 END AS BIT) AS LSTP_IS_DEFAULT,
    CAST(CASE WHEN rd.IS_STATIC       = 'Y' THEN 1 ELSE 0 END AS BIT) AS LSTP_IS_STATIC,
    CAST(CASE WHEN rd.IS_USER_DEFINED = 'Y' THEN 1 ELSE 0 END AS BIT) AS LSTP_IS_USER_DEFINED
FROM dbo.REFERENCE_DATA AS rd
WHERE rd.SUBCLASS = 523
ORDER BY rd.CODE;
