SELECT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK,
    CAST(CASE WHEN b.SUBCLASS = 6 THEN N'I' ELSE N'O' END AS nvarchar(50)) AS POLICY_BUSINESS_INDICATOR,
    b.IDENTIFIER AS POLICY_CONTRACT_NUMBER,
    CAST(COALESCE(NULLIF(LTRIM(RTRIM(ip.IP_TITLE)), N''), b.TITLE) AS nvarchar(255)) AS POLICY_NAME,
    oin.IDENTIFIER AS OIN_BK,
    COALESCE(oin_name.NAME, oin.CURR_NAME) AS OIN_NAME
FROM SICS.BUS_STRUCT_REP AS bsr
INNER JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = bsr.FK_BUSINESS
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = bsr.FK_INS_PERIOD
LEFT JOIN SICS.PARTY AS oin
    ON oin.OBJECT_ID = bsr.FK_INSURED
LEFT JOIN (
    SELECT
        FK_ORGANISATION,
        NAME,
        ROW_NUMBER() OVER (PARTITION BY FK_ORGANISATION ORDER BY OBJECT_ID) AS RN
    FROM SICS.ORGANISATION_NAME
) AS oin_name
    ON oin_name.FK_ORGANISATION = oin.OBJECT_ID
   AND oin_name.RN = 1
WHERE b.SUBCLASS IN (6, 3, 8, 11)
  AND COALESCE(
        NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
        NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL
  AND bsr.IS_CURRENT_LCP = N'Y'
  AND bsr.IS_CURRENT_AM = N'Y'
ORDER BY POLICY_BK, POLICY_BUSINESS_INDICATOR;
