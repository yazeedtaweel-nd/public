-- assigned parent of IC201910001
SELECT
    c.CLAIM_IDENTIFIER          AS CLA_BK,
    hl.OBJECT_ID                AS HL_OID,
    hl.CLAIM_IDENTIFIER         AS HL_BK,
    hl.SUBCLASS                 AS HL_SUBCLASS,
    hl.FK_HEADLINE_LOSS         AS HL_PARENT,
    hl.FK_HL_LOSS_GRP           AS HL_GRP,
    hl.LOSS_NAME                AS HL_LOSS_NAME,
    r.REFERENCE_ID              AS REF_ON_ASSIGNED
FROM SICS.CLAIMS AS c
LEFT JOIN SICS.CLAIMS AS hl
    ON hl.OBJECT_ID = c.FK_HEADLINE_LOSS
LEFT JOIN SICS.CL_HLOSS_REF AS r
    ON r.FK_PARENT = hl.OBJECT_ID
WHERE c.CLAIM_IDENTIFIER = 'IC201910001';

-- group dim keys
SELECT
    c.CLAIM_IDENTIFIER AS HEADLINE_BK,
    c.SUBCLASS,
    c.LOSS_NAME,
    c.FK_HL_LOSS_GRP,
    r.REFERENCE_ID     AS CLGRP_BK
FROM SICS.CLAIMS AS c
LEFT JOIN SICS.CL_HLOSS_REF AS r
    ON r.FK_PARENT = c.OBJECT_ID
WHERE c.SUBCLASS = 6
ORDER BY r.REFERENCE_ID;
