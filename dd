INSERT INTO etl.ETL_ERROR_LOG
(
    EXECUTION_ID,
    JOB_TABLE_ID,
    SEVERITY,
    TASK_NAME,
    ERROR_MESSAGE,
    SOURCE_KEY,
    ROW_DATA
)
VALUES
(
    ?,          -- ExecutionId
    NULL,       -- JobTableId (OK for parallel; identify via TASK_NAME)
    'ERROR',
    ?,          -- SourceName
    ?,          -- ErrorDescription
    NULL,
    NULL
);



SELECT CASE WHEN EXISTS (
           SELECT 1 FROM etl.ETL_ERROR_LOG
           WHERE EXECUTION_ID = ? AND SEVERITY = 'ERROR'
       ) THEN CAST(1 AS BIT) ELSE CAST(0 AS BIT) END AS PACKAGE_FAILED;



SELECT *
FROM   etl.ETL_ERROR_LOG
WHERE  EXECUTION_ID = <your id>
ORDER BY ERROR_ID;
