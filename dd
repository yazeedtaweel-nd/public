-- Part 1: CRESTA zones (one row per coded zone)
SELECT
    z.CODE AS CRZ_BK,
    la.NAME + ' - ' + z.NAME AS CRZ_NAME,
    COALESCE(la.CODE, la.ISO_ALPHA_2) AS CTRY_COUNTRY_CODE,
    la.NAME AS COUNTRY_NAME,
    CAST(NULL AS NVARCHAR(200)) AS PERIL_LIST,
    'ZONE' AS ROW_SOURCE
FROM SICS.dbo.RISK_ZONE AS ctry
JOIN SICS.dbo.RISK_ZONE AS z
    ON z.FK_PARENT = ctry.OBJECT_ID
   AND z.SUBCLASS = 1
JOIN SICS.dbo.LEGAL_AREA AS la
    ON la.OBJECT_ID = ctry.FK_COUNTRY
   AND la.SUBCLASS = 1
WHERE ctry.SUBCLASS = 2

UNION ALL

-- Part 2: one row per country node, perils aggregated
SELECT
    NULL AS CRZ_BK,
    UPPER(CONCAT(la.NAME, ' - (', STRING_AGG(rd.NAME, ', '), ')')) AS CRZ_NAME,
    COALESCE(la.CODE, la.ISO_ALPHA_2) AS CTRY_COUNTRY_CODE,
    la.NAME AS COUNTRY_NAME,
    STRING_AGG(rd.NAME, ', ') AS PERIL_LIST,
    'COUNTRY_PERIL' AS ROW_SOURCE
FROM SICS.dbo.RISK_ZONE AS rz
JOIN SICS.dbo.LEGAL_AREA AS la
    ON la.OBJECT_ID = rz.FK_COUNTRY
   AND la.SUBCLASS = 1
LEFT JOIN SICS.dbo.RZ_CTR_TO_REF AS rzp
    ON rzp.FK_RZ_COUNTRY = rz.OBJECT_ID
LEFT JOIN SICS.dbo.REFERENCE_DATA AS rd
    ON rd.CODE = rzp.FRK_PERIL_TYPE
   AND rd.SUBCLASS = rzp.FSK_PERIL_TYPE
   AND rd.SUBCLASS = 44
WHERE rz.SUBCLASS = 2
GROUP BY rz.OBJECT_ID, la.NAME, la.CODE, la.ISO_ALPHA_2
ORDER BY ROW_SOURCE, CRZ_BK;
