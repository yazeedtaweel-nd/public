DECLARE @POLICY_IDENTIFIER nvarchar(50) = N'PUT_IDENTIFIER_HERE';

SELECT
    b.IDENTIFIER,
    b.SUBCLASS,
    ip.I_PERIOD_FORMER_ID,
    ip.BUS_INS_PER_ID,
    ip.CREATE_TIMESTAMP          AS IP_CREATE_TIMESTAMP,
    ip.CHANGED_DATE              AS IP_CHANGED_DATE,
    bsr.OBJECT_ID                AS BSR_OBJECT_ID,
    bsr.AMNDMNT_NMBR             AS BSR_AMNDMNT_NMBR,
    bsr.SEQUENCE_NUMBER          AS BSR_SEQUENCE_NUMBER,
    bsr.IS_CURRENT_LCP,
    bsr.IS_CURRENT_AM,
    bsr.EFF_START_TMSTMP,
    bsr.EFF_END_TMSTMP,
    bsr.FK_PC_SHARE,
    bsr.FK_COND_CONT,
    bsr.FK_INS_PERIOD,
    bsr.FK_AMENDMENT,
    am.AMNDMNT_NMBR              AS AMENDMENT_AMNDMNT_NMBR,
    am.AMND_COMP_DATE,
    lcp.SEQUENCE_NUMBER          AS LCP_SEQUENCE_NUMBER,
    sh.OBJECT_ID                 AS SHARE_OBJECT_ID,
    CASE WHEN sh.OBJECT_ID = bsr.FK_PC_SHARE THEN N'Y' ELSE N'N' END AS IS_FK_PC_SHARE,
    sh.CEDED,
    sh.CEDED_OF_100,
    sh.SIGNED_SHARE,
    sh.WRITTEN_SHARE,
    sh.IS_CURRENT_OF_IP          AS SHARE_IS_CURRENT_OF_IP,
    sh.IS_CURRENT_OF_LCP         AS SHARE_IS_CURRENT_OF_LCP,
    sh.FK_EVENT_CRE,
    sh.FK_EVENT_REV,
    CASE WHEN sh.FK_EVENT_REV IS NULL THEN N'Y' ELSE N'N' END AS SHARE_NOT_REVOKED
FROM SICS.BUSINESS AS b
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
LEFT JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_BUSINESS = b.OBJECT_ID
   AND bsr.FK_INS_PERIOD = ip.OBJECT_ID
LEFT JOIN SICS.AMENDMENT AS am
    ON am.OBJECT_ID = bsr.FK_AMENDMENT
LEFT JOIN SICS.LIFE_CYCLE_PHASE AS lcp
    ON lcp.OBJECT_ID = bsr.FK_LC_PHASE
LEFT JOIN SICS.BC_SHARE AS sh
    ON sh.FK_COND_CONTAINER = bsr.FK_COND_CONT
    OR sh.OBJECT_ID = bsr.FK_PC_SHARE
    OR sh.FK_INSURED_PERIOD = ip.OBJECT_ID
WHERE b.IDENTIFIER = @POLICY_IDENTIFIER
   OR ip.I_PERIOD_FORMER_ID = @POLICY_IDENTIFIER
   OR ip.BUS_INS_PER_ID = @POLICY_IDENTIFIER
ORDER BY
    bsr.AMNDMNT_NMBR,
    bsr.SEQUENCE_NUMBER,
    am.AMNDMNT_NMBR,
    lcp.SEQUENCE_NUMBER,
    ip.CHANGED_DATE,
    sh.OBJECT_ID;
