-- Does AC_STL_PAIRING ever disagree with DTL_AMT for rows that actually have a pairing record?
SELECT TOP (50)
    dtl.OBJECT_ID            AS DETAIL_ID,
    dtl.DTL_AMT,
    pair.SETTLED_AMT1,
    pair.SETTLED_AMT2,
    pair.SETTLEMENT_AMT,
    pair.FUNC_AMT,
    pair.FUNC_AMT2,
    CASE WHEN pair.FK_DETAIL1 = dtl.OBJECT_ID THEN pair.SETTLED_AMT1
         WHEN pair.FK_DETAIL2 = dtl.OBJECT_ID THEN pair.SETTLED_AMT2
    END                       AS MATCHED_SIDE_SETTLED_AMT
FROM sics.AC_LEDGER_DETAIL AS dtl
INNER JOIN sics.AC_STL_PAIRING AS pair
        ON pair.FK_DETAIL1 = dtl.OBJECT_ID
        OR pair.FK_DETAIL2 = dtl.OBJECT_ID
WHERE dtl.DTL_AMT <> CASE WHEN pair.FK_DETAIL1 = dtl.OBJECT_ID THEN pair.SETTLED_AMT1
                           WHEN pair.FK_DETAIL2 = dtl.OBJECT_ID THEN pair.SETTLED_AMT2
                      END;
