WITH ws_bk AS (
    SELECT
        w.OBJECT_ID,
        w.BOOKING_DATE,
        CASE
            WHEN w.EXTERNAL_ID LIKE 'TW|%'
                THEN STUFF(w.EXTERNAL_ID, 1, 3, '')
            ELSE CONVERT(varchar(8), w.BOOKING_DATE, 112)
                 + '|' + CAST(
                     ROW_NUMBER() OVER (
                         PARTITION BY w.BOOKING_DATE
                         ORDER BY w.ID_SERIE_NO, w.OBJECT_ID
                     ) AS varchar(20)
                 )
        END AS WRKS_BK
    FROM SICS.AC_WORKSHEET AS w
),
inst AS (
    SELECT
        i.OBJECT_ID,
        i.INST_NR,
        i.DUE_DATE,
        i.PAYMENT_DATE,
        i.PREMIUM_AMT,
        i.BOOKED_PRE_AMT,
        i.AC_START_DATE,
        i.AC_END_DATE,
        i.FK_REMITTANCE,
        i.FK_INST_CUR                         AS INST_CUR_ID,
        icur.NR_INSTAL,
        icur.FK_INST_CUR                      AS CCY,
        icont.FK_COND_CONTAINER,
        b.OBJECT_ID                           AS BUSINESS_ID,
        CAST(
            COALESCE(
                NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
                NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
            ) AS nvarchar(50)
        )                                     AS POLICY_BK
    FROM SICS.BC_INSTAL AS i
    INNER JOIN SICS.BC_INST_CUR AS icur
            ON icur.OBJECT_ID = i.FK_INST_CUR
    LEFT JOIN SICS.BC_INST_CONT AS icont
           ON icont.OBJECT_ID = icur.FK_CONDITION
    LEFT JOIN SICS.BUS_COND_CONTAINER AS bcc
           ON bcc.OBJECT_ID = icont.FK_COND_CONTAINER
    LEFT JOIN SICS.SCOPE_OF_COVER AS soc
           ON soc.OBJECT_ID = bcc.FK_SOC
    LEFT JOIN SICS.LIFE_CYCLE_PHASE AS lcp
           ON lcp.OBJECT_ID = soc.FK_LIFECYCLEP
    LEFT JOIN SICS.INSURED_PERIOD AS ip
           ON ip.OBJECT_ID = COALESCE(icont.FK_INSURED_PERIOD, lcp.FK_INS_PRD)
    LEFT JOIN SICS.BUSINESS AS b
           ON b.OBJECT_ID = ip.FK_BUSINESS
),
cnt AS (
    SELECT FK_INST_CUR, COUNT(*) AS N
    FROM SICS.BC_INSTAL
    GROUP BY FK_INST_CUR
),
dtl_inst AS (
    SELECT INST_ID, FK_WORKSHEET, FK_BALANCE, WKST_SEQ_NBR, EXCH_AMT
    FROM (
        SELECT
            d.FK_SRCE_INSTALMENT AS INST_ID,
            d.FK_WORKSHEET, d.FK_BALANCE, d.WKST_SEQ_NBR, d.EXCH_AMT,
            ROW_NUMBER() OVER (
                PARTITION BY d.FK_SRCE_INSTALMENT
                ORDER BY d.WKST_SEQ_NBR
            ) AS rn
        FROM SICS.AC_LEDGER_DETAIL AS d
        WHERE d.FK_SRCE_INSTALMENT IS NOT NULL
          AND d.FK_WORKSHEET IS NOT NULL
    ) AS x
    WHERE rn = 1
),
dtl_bal AS (
    SELECT FK_BALANCE, FK_WORKSHEET, WKST_SEQ_NBR, EXCH_AMT
    FROM (
        SELECT
            d.FK_BALANCE, d.FK_WORKSHEET, d.WKST_SEQ_NBR, d.EXCH_AMT,
            ROW_NUMBER() OVER (
                PARTITION BY d.FK_BALANCE
                ORDER BY d.WKST_SEQ_NBR
            ) AS rn
        FROM SICS.AC_LEDGER_DETAIL AS d
        WHERE d.FK_BALANCE IS NOT NULL
          AND d.FK_WORKSHEET IS NOT NULL
    ) AS x
    WHERE rn = 1
),
link AS (
    SELECT INST_ID, FK_WORKSHEET, FK_BALANCE, WKST_SEQ_NBR, EXCH_AMT,
           1 AS PRIORITY, 'DETAIL_SRCE_INSTALMENT' AS LINK_METHOD
    FROM dtl_inst

    UNION ALL

    SELECT i.OBJECT_ID, d.FK_WORKSHEET, d.FK_BALANCE, d.WKST_SEQ_NBR, d.EXCH_AMT,
           2, 'REMITTANCE_BALANCE'
    FROM inst AS i
    INNER JOIN dtl_bal AS d
            ON d.FK_BALANCE = i.FK_REMITTANCE
    WHERE i.FK_REMITTANCE IS NOT NULL

    UNION ALL

    SELECT
        i.OBJECT_ID,
        COALESCE(d.FK_WORKSHEET, bl.FK_WORKSHEET),
        bl.OBJECT_ID,
        d.WKST_SEQ_NBR,
        d.EXCH_AMT,
        CASE WHEN d.FK_WORKSHEET IS NOT NULL THEN 3 ELSE 4 END,
        CASE WHEN d.FK_WORKSHEET IS NOT NULL
             THEN 'BALANCE_BUSINESS_INSTALMENT'
             ELSE 'BALANCE_WORKSHEET'
        END
    FROM inst AS i
    INNER JOIN SICS.AC_LEDGER_BALANCE AS bl
            ON bl.FK_BUSINESS       = i.BUSINESS_ID
           AND bl.INSTALMENT_NUMBER = i.INST_NR
           AND bl.FK_CURR           = i.CCY
           AND ISNULL(bl.IS_OUTWARD, 'N') = 'N'
    LEFT JOIN dtl_bal AS d
           ON d.FK_BALANCE = bl.OBJECT_ID
    WHERE i.BUSINESS_ID IS NOT NULL
      AND COALESCE(d.FK_WORKSHEET, bl.FK_WORKSHEET) IS NOT NULL
),
best AS (
    SELECT INST_ID, FK_WORKSHEET, FK_BALANCE, WKST_SEQ_NBR, EXCH_AMT, LINK_METHOD
    FROM (
        SELECT
            INST_ID, FK_WORKSHEET, FK_BALANCE, WKST_SEQ_NBR, EXCH_AMT, LINK_METHOD,
            ROW_NUMBER() OVER (
                PARTITION BY INST_ID
                ORDER BY PRIORITY, WKST_SEQ_NBR
            ) AS rn
        FROM link
    ) AS x
    WHERE rn = 1
),
dep AS (
    SELECT FK_COND_CONTAINER, CCY, PREMIUM_AMOUNT
    FROM (
        SELECT
            pc.FK_COND_CONTAINER,
            clp.FK_CURRENCY AS CCY,
            dp.PREMIUM_AMOUNT,
            ROW_NUMBER() OVER (
                PARTITION BY pc.FK_COND_CONTAINER, clp.FK_CURRENCY
                ORDER BY CASE WHEN pc.IS_CURRENT_OF_IP = 'Y' THEN 0 ELSE 1 END,
                         pc.OBJECT_ID
            ) AS rn
        FROM SICS.LPC_PREM_COND AS pc
        INNER JOIN SICS.LPC_DEP_PREMIUM AS dp
                ON dp.FK_CONDITION = pc.OBJECT_ID
        LEFT JOIN SICS.LPC_CUR_LIMIT_PREM AS clp
               ON clp.OBJECT_ID = dp.FK_CURRENCY
    ) AS x
    WHERE rn = 1
),
bro AS (
    SELECT FK_COND_CONTAINER, PCT
    FROM (
        SELECT
            dc.FK_COND_CONTAINER,
            de.PCT,
            ROW_NUMBER() OVER (
                PARTITION BY dc.FK_COND_CONTAINER
                ORDER BY de.OBJECT_ID
            ) AS rn
        FROM SICS.DEDUCTION_COND AS dc
        INNER JOIN SICS.DEDUCTION_ELEMENT AS de
                ON de.FK_DED_COND = dc.OBJECT_ID
        WHERE de.FRK_TYPE = N'BRO'
          AND de.PCT IS NOT NULL
    ) AS x
    WHERE rn = 1
),
tax AS (
    SELECT dc.FK_COND_CONTAINER, SUM(de.AMT_AMT) AS TAX_AMT
    FROM SICS.DEDUCTION_COND AS dc
    INNER JOIN SICS.DEDUCTION_ELEMENT AS de
            ON de.FK_DED_COND = dc.OBJECT_ID
    WHERE de.FRK_TYPE IN (N'IPT', N'IPT1', N'IPT2', N'IPT3')
    GROUP BY dc.FK_COND_CONTAINER
)
SELECT
    ws.WRKS_BK                                        AS WRKS_BK,
    i.POLICY_BK                                       AS POLICY_BK,
    ws.BOOKING_DATE                                   AS INS_AUDIT_DATE,
    lnk.WKST_SEQ_NBR                                  AS INS_AUDIT_NUM,
    i.INST_NR                                         AS INS_INSTALMENT_NUM,
    i.DUE_DATE                                        AS INS_INSTALMENT_DUE_DATE,
    ISNULL(i.PAYMENT_DATE, '9999-01-01')              AS INS_ACTUAL_PAYMENT_DATE,
    i.PREMIUM_AMT                                     AS INS_INSTALMENT_ORIG_AMT,
    i.BOOKED_PRE_AMT                                  AS INS_INSTALMENT_SETT_AMT,
    i.AC_START_DATE                                   AS INS_START_DATE,
    i.AC_END_DATE                                     AS INS_END_DATE,
    lnk.EXCH_AMT                                      AS INS_INSTALMENT_BASE_AMT,
    COALESCE(NULLIF(i.NR_INSTAL, 0), NULLIF(c.N, 0))  AS INSTALEMENT_COUNT,
    i.CCY                                             AS INS_INSTALMENT_ORIG_CCY,
    ISNULL(bal.FK_CURR, i.CCY)                        AS INS_INSTALMENT_SETT_CCY,
    COALESCE(dep.PREMIUM_AMOUNT, dep0.PREMIUM_AMOUNT) AS SRE_MDP,
    COALESCE(dep.PREMIUM_AMOUNT, dep0.PREMIUM_AMOUNT)
        / NULLIF(COALESCE(NULLIF(i.NR_INSTAL, 0), c.N), 0)
                                                      AS SRE_MDP_INSTALMENT,
    (COALESCE(dep.PREMIUM_AMOUNT, dep0.PREMIUM_AMOUNT)
        / NULLIF(COALESCE(NULLIF(i.NR_INSTAL, 0), c.N), 0))
        * (ISNULL(bro.PCT, 10) / 100.0)               AS BROKERAGE,
    ISNULL(tax.TAX_AMT, 0)                            AS TAX_ON_PREMIUM,
    lnk.LINK_METHOD                                   AS WRKS_LINK_METHOD
FROM inst AS i
LEFT JOIN cnt AS c
       ON c.FK_INST_CUR = i.INST_CUR_ID
LEFT JOIN best AS lnk
       ON lnk.INST_ID = i.OBJECT_ID
LEFT JOIN ws_bk AS ws
       ON ws.OBJECT_ID = lnk.FK_WORKSHEET
LEFT JOIN SICS.AC_LEDGER_BALANCE AS bal
       ON bal.OBJECT_ID = lnk.FK_BALANCE
LEFT JOIN dep
       ON dep.FK_COND_CONTAINER = i.FK_COND_CONTAINER
      AND dep.CCY = i.CCY
LEFT JOIN dep AS dep0
       ON dep0.FK_COND_CONTAINER = i.FK_COND_CONTAINER
      AND dep0.CCY IS NULL
LEFT JOIN bro
       ON bro.FK_COND_CONTAINER = i.FK_COND_CONTAINER
LEFT JOIN tax
       ON tax.FK_COND_CONTAINER = i.FK_COND_CONTAINER
ORDER BY POLICY_BK, INS_INSTALMENT_NUM;
