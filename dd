/* ============================================================
   Add IS_ACTIVE BIT to selected DWH dimensions
   Default 1 = active for existing rows
   ============================================================ */

IF COL_LENGTH('dbo.DIM_OCCUPATION', 'OCC_IS_ACTIVE') IS NULL
BEGIN
    ALTER TABLE dbo.DIM_OCCUPATION
    ADD OCC_IS_ACTIVE BIT NOT NULL
        CONSTRAINT DF_DIM_OCCUPATION_OCC_IS_ACTIVE DEFAULT (1);
END
GO

