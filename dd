SELECT DISTINCT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip_pol.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip_pol.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK,
    CAST(LTRIM(RTRIM(p.IDENTIFIER)) AS nvarchar(50)) AS BROKER_BK
FROM SICS.BUSINESS_PRTNR_REL AS r
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = r.FK_INS_PERIOD
INNER JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = ip.FK_BUSINESS
INNER JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_BUSINESS = b.OBJECT_ID
   AND bsr.IS_CURRENT_LCP = N'Y'
   AND bsr.IS_CURRENT_AM = N'Y'
INNER JOIN SICS.INSURED_PERIOD AS ip_pol
    ON ip_pol.OBJECT_ID = bsr.FK_INS_PERIOD
INNER JOIN SICS.PARTY AS p
    ON p.OBJECT_ID = r.FK_BUS_PARTNER
WHERE r.FSK_RELSHIP_TYPE = 55
  AND r.FRK_RELSHIP_TYPE = N'BR'
  AND r.SUBCLASS = 10
  AND b.SUBCLASS IN (3, 8, 11)
  AND COALESCE(
        NULLIF(LTRIM(RTRIM(ip_pol.I_PERIOD_FORMER_ID)), N''),
        NULLIF(LTRIM(RTRIM(ip_pol.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL;
