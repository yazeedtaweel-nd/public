

IF NOT EXISTS (
    SELECT 1
    FROM   audit.ETL_PACKAGE
    WHERE  PACKAGE_NAME = N'SUB_PROVISION_PACKAGE'
)
BEGIN
    INSERT INTO audit.ETL_PACKAGE
        (PACKAGE_NAME, PACKAGE_FILE_NAME, EXECUTION_ORDER, IS_ENABLED, DESCRIPTION)
    VALUES
        (N'SUB_PROVISION_PACKAGE',
         N'SubProvision.dtsx',
         35,
         1,
         N'Sub provision package: transaction settlement detail under each provision (FACT_TRA_SETTLEMENT).');
END
ELSE
BEGIN
    UPDATE audit.ETL_PACKAGE
    SET    PACKAGE_FILE_NAME = N'DimSubProvision.dtsx',
           EXECUTION_ORDER   = 60,
           IS_ENABLED        = 1,
           DESCRIPTION       = N'Sub provision package: transaction settlement detail under each provision (FACT_TRA_SETTLEMENT).'
    WHERE  PACKAGE_NAME = N'SUB_PROVISION_PACKAGE';
END
GO

DECLARE @PackageId INT =
    (SELECT PACKAGE_ID FROM audit.ETL_PACKAGE WHERE PACKAGE_NAME = N'SUB_PROVISION_PACKAGE');

IF @PackageId IS NULL
BEGIN
    RAISERROR(N'SUB_PROVISION_PACKAGE was not found in audit.ETL_PACKAGE after seed.', 16, 1);
END
ELSE
BEGIN
    ;WITH src AS (
        SELECT *
        FROM (VALUES
            (N'TRA_SETTLEMENT',
             N'SICS.dbo.AC_LEDGER_DETAIL',
             N'dbo.FACT_TRA_SETTLEMENT',
             N'AC_LEDGER_DETAIL joined to member AC_LEDGER_BALANCE via FK_BALANCE and to the settlement header via FK_SETTLEMENT_BAL. One detail row per provision.')
        ) AS v (TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, DESCRIPTION)
    )
    MERGE audit.ETL_PACKAGE_TABLE AS t
    USING src
       ON t.PACKAGE_ID = @PackageId
      AND t.TABLE_NAME = src.TABLE_NAME
    WHEN MATCHED THEN
        UPDATE SET
            SOURCE_OBJECT = src.SOURCE_OBJECT,
            TARGET_OBJECT = src.TARGET_OBJECT,
            DESCRIPTION   = src.DESCRIPTION,
            IS_ENABLED    = 1
    WHEN NOT MATCHED THEN
        INSERT (PACKAGE_ID, TABLE_NAME, SOURCE_OBJECT, TARGET_OBJECT, IS_ENABLED, DESCRIPTION)
        VALUES (@PackageId, src.TABLE_NAME, src.SOURCE_OBJECT, src.TARGET_OBJECT, 1, src.DESCRIPTION);
END
GO
