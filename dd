DECLARE @POLICY_IDENTIFIER nvarchar(50) = N'PUT_IW_IDENTIFIER_HERE';

SELECT
    b.IDENTIFIER,
    b.SUBCLASS,
    CASE
        WHEN b.SUBCLASS = 6 THEN N'IW'
        WHEN b.SUBCLASS IN (3, 8, 11) THEN N'OW'
    END AS DIRECTION,
    CASE
        WHEN b.SUBCLASS = 6
            THEN COALESCE(sh.CEDED_OF_100, sh.CEDED)
        WHEN b.SUBCLASS IN (3, 8, 11)
            THEN COALESCE(sh.CEDED_OF_100, sh.CEDED, sh_occ.CEDED_OF_100, sh_occ.CEDED)
    END AS POLICY_CEDED_PERCENT
FROM SICS.BUSINESS AS b
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.FK_BUSINESS = b.OBJECT_ID
INNER JOIN SICS.BUS_STRUCT_REP AS bsr
    ON bsr.FK_BUSINESS = b.OBJECT_ID
   AND bsr.FK_INS_PERIOD = ip.OBJECT_ID
   AND bsr.IS_CURRENT_LCP = N'Y'
   AND bsr.IS_CURRENT_AM = N'Y'
LEFT JOIN SICS.BC_SHARE AS sh
    ON sh.OBJECT_ID = bsr.FK_PC_SHARE
LEFT JOIN SICS.INSURED_PERIOD AS occ_ip
    ON occ_ip.OBJECT_ID = COALESCE(ip.FK_OCC, bsr.FK_IP_OCC)
LEFT JOIN SICS.BUS_STRUCT_REP AS occ_bsr
    ON occ_bsr.FK_INS_PERIOD = occ_ip.OBJECT_ID
   AND occ_bsr.IS_CURRENT_LCP = N'Y'
   AND occ_bsr.IS_CURRENT_AM = N'Y'
LEFT JOIN SICS.BC_SHARE AS sh_occ
    ON sh_occ.OBJECT_ID = occ_bsr.FK_PC_SHARE
WHERE b.SUBCLASS IN (3, 6, 8, 11)
  AND (
        b.IDENTIFIER = @POLICY_IDENTIFIER
     OR ip.I_PERIOD_FORMER_ID = @POLICY_IDENTIFIER
     OR ip.BUS_INS_PER_ID = @POLICY_IDENTIFIER
      );
