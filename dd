SELECT
    bsr.FK_BUSINESS,
    bsr.FK_PC_SHARE,
    bsr.FK_IP_OCC,
    bsr.SEQUENCE_NUMBER,
    bsr.OBJECT_ID
FROM SICS.BUS_STRUCT_REP AS bsr
WHERE bsr.FK_BUSINESS = (
    SELECT OBJECT_ID
    FROM SICS.BUSINESS
    WHERE IDENTIFIER = N'IPF16817'
)
AND bsr.IS_CURRENT_LCP = N'Y'
AND bsr.IS_CURRENT_AM = N'Y'
ORDER BY bsr.SEQUENCE_NUMBER, bsr.OBJECT_ID;
