DECLARE @IsOutward CHAR(1) = 'N';

WITH ws_seq AS (
    SELECT
        w.OBJECT_ID,
        CAST(w.BOOKING_DATE AS date) AS BOOKING_DATE,
        w.EXTERNAL_ID,
        w.ID_SERIE_NO,
        w.FK_REGISTERED_BY,
        ROW_NUMBER() OVER (
            PARTITION BY CAST(w.BOOKING_DATE AS date)
            ORDER BY w.ID_SERIE_NO, w.OBJECT_ID
        ) AS serie_no
    FROM sics.AC_WORKSHEET AS w
),
ws AS (
    SELECT
        OBJECT_ID,
        BOOKING_DATE,
        EXTERNAL_ID,
        ID_SERIE_NO,
        FK_REGISTERED_BY,
        CASE
            WHEN EXTERNAL_ID LIKE 'TW|%'
                THEN STUFF(EXTERNAL_ID, 1, 3, '')
            ELSE CONVERT(varchar(8), BOOKING_DATE, 112)
                 + '|' + CAST(serie_no AS varchar(20))
        END AS WRKS_BK,
        CASE
            WHEN EXTERNAL_ID LIKE 'TW|%'
                THEN COALESCE(
                    TRY_CAST(
                        RIGHT(EXTERNAL_ID, CHARINDEX('|', REVERSE(EXTERNAL_ID)) - 1)
                        AS int
                    ),
                    serie_no
                )
            ELSE serie_no
        END AS WRKS_NO
    FROM ws_seq
),
former_id AS (
    SELECT
        FK_PARTY,
        IDENTIFIER,
        ROW_NUMBER() OVER (PARTITION BY FK_PARTY ORDER BY OBJECT_ID) AS rn
    FROM sics.PARTY_IDENTIFIER
    WHERE FRK_PARTY_ID_TYPE = 'FORMERID'
),
comp AS (
    SELECT
        p.OBJECT_ID,
        COALESCE(NULLIF(LTRIM(RTRIM(fid.IDENTIFIER)), ''), p.IDENTIFIER) AS COMP_BK
    FROM sics.PARTY AS p
    LEFT JOIN former_id AS fid
           ON fid.FK_PARTY = p.OBJECT_ID
          AND fid.rn = 1
    WHERE p.SUBCLASS = 4
      AND EXISTS (
          SELECT 1
          FROM sics.BUS_PARTNER_CAT AS cat
          WHERE cat.FK_PARTNER = p.OBJECT_ID
            AND cat.FRK_CATEGORY IN ('CE', 'SEC')
      )
),
brk AS (
    SELECT
        bpr.FK_INS_PERIOD,
        COALESCE(fid.IDENTIFIER, bp.IDENTIFIER) AS BROK_BK,
        ROW_NUMBER() OVER (
            PARTITION BY bpr.FK_INS_PERIOD
            ORDER BY bp.OBJECT_ID
        ) AS rn
    FROM sics.BUSINESS_PRTNR_REL AS bpr
    INNER JOIN sics.PARTY AS bp
            ON bp.OBJECT_ID = bpr.FK_BUS_PARTNER
           AND bp.SUBCLASS = 4
    LEFT JOIN former_id AS fid
           ON fid.FK_PARTY = bp.OBJECT_ID
          AND fid.rn = 1
    WHERE bpr.FRK_RELSHIP_TYPE = 'BR'
      AND bpr.FSK_RELSHIP_TYPE = 55
      AND EXISTS (
          SELECT 1
          FROM sics.BUS_PARTNER_CAT AS bpc
          WHERE bpc.FK_PARTNER = bp.OBJECT_ID
            AND bpc.FSK_CATEGORY = 23
            AND bpc.FRK_CATEGORY IN ('B', 'BOUT')
      )
),
ref_by_soc AS (
    SELECT FK_SOC_REL, MIN(REFERENCE_ID) AS REFERENCE_ID
    FROM sics.CLAIM_REFS
    GROUP BY FK_SOC_REL
),
ref_by_claim AS (
    SELECT scr.FK_CLAIM, MIN(r.REFERENCE_ID) AS REFERENCE_ID
    FROM sics.SOC_TO_CLAIM_REL AS scr
    INNER JOIN sics.CLAIM_REFS AS r
            ON r.FK_SOC_REL = scr.OBJECT_ID
    GROUP BY scr.FK_CLAIM
)
SELECT
    pol.POLICY_BK                                          AS POLICY_BK,
    COALESCE(
        ref_ow.REFERENCE_ID,  clm_ow.CLAIM_IDENTIFIER,
        ref_bal.REFERENCE_ID, clm_bal.CLAIM_IDENTIFIER
    )                                                      AS CLA_CLAIM_BK,
    brk.BROK_BK                                            AS BROK_BK,
    comp.COMP_BK                                           AS COMP_BK,

    CONVERT(int, CONVERT(char(8), ws.BOOKING_DATE, 112))   AS TRANS_AUDIT_DATE_SRGT,

    -- TRANS_AUDIT_NUM candidates: keep one, rename it TRANS_AUDIT_NUM, drop the rest
    ws.WRKS_NO                                             AS TRANS_AUDIT_NUM_WRKS_NO,
    ws.ID_SERIE_NO                                         AS TRANS_AUDIT_NUM_WS_ID_SERIE_NO,
    bal.ADJUSTMENT_NUMBER                                  AS TRANS_AUDIT_NUM_ADJUSTMENT_NUMBER,
    dtl.WKST_SEQ_NBR                                       AS TRANS_AUDIT_NUM_WKST_SEQ_NBR,
    ws.EXTERNAL_ID                                         AS WS_EXTERNAL_ID,

    CONVERT(int,
        CONVERT(char(4), bal.BOOKING_YEAR)
        + RIGHT('0' + REPLACE(bal.FRK_BOOKING_PERIOD, 'M', ''), 2)
        + '01'
    )                                                      AS TRANS_PROCESSING_PERIOD_SRGT,
    ec.CODE                                                AS TRST_BK,
    CONVERT(int, CONVERT(char(8), dtl.AC_START_DATE, 112)) AS TRANS_ACCOUNTING_FROM_DATE_SRGT,
    CONVERT(int, CONVERT(char(8), dtl.AC_END_DATE, 112))   AS TRANS_ACCOUNTING_TO_DATE_SRGT,

    CAST(dtl.EXCH_AMT    AS money)                         AS TRANS_BASE_GROSS_AMT,
    CAST(dtl.FUNC_AMT2   AS money)                         AS TRANS_BASE2_GROSS_AMT,
    CAST(bal.SETTLED_AMT AS money)                         AS TRANS_SETT_GROSS_AMT,
    CAST(dtl.DTL_AMT     AS money)                         AS TRANS_ORIG_GROSS_AMT,

    pol.POLICY_BK                                          AS IW_POLICY_BK,
    CASE WHEN bal.IS_OUTWARD = 'Y' THEN pol.POLICY_BK END  AS OW_POLICY_BK,

    bal.FK_CURR                                            AS CURR_ORIG_BK,
    bal.FK_AC_FUNC_CCY                                     AS CURR_BASE_BK,
    COALESCE(bal.FK_LLOYDS_SETL_CUR, bal.FK_CURR)          AS CURR_SETT_BK,
    usr.USER_ID                                            AS USR_BK,
    ws.WRKS_BK                                             AS WRKS_BK

FROM sics.AC_LEDGER_DETAIL AS dtl
INNER JOIN sics.AC_LEDGER_BALANCE AS bal
        ON bal.OBJECT_ID = dtl.FK_BALANCE
       AND bal.IS_OUTWARD = @IsOutward
LEFT JOIN ws
       ON ws.OBJECT_ID = dtl.FK_WORKSHEET
LEFT JOIN sics.ENTRY_CODE AS ec
       ON ec.OBJECT_ID = dtl.FK_ENTRY_CODE
LEFT JOIN sics.CNU_USER AS usr
       ON usr.OBJECT_ID = ws.FK_REGISTERED_BY
LEFT JOIN sics.INSURED_PERIOD AS ip
       ON ip.OBJECT_ID = dtl.FK_INS_PER
CROSS APPLY (
    SELECT CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK
) AS pol

LEFT JOIN sics.SOC_TO_CLAIM_REL AS soc
       ON soc.OBJECT_ID = bal.FK_CLAIM
LEFT JOIN sics.CLAIMS AS clm_bal
       ON clm_bal.OBJECT_ID = soc.FK_CLAIM
LEFT JOIN ref_by_soc AS ref_bal
       ON ref_bal.FK_SOC_REL = soc.OBJECT_ID
LEFT JOIN sics.CLAIMS AS clm_ow
       ON clm_ow.OBJECT_ID = dtl.FK_CLAIM_TO_SOC
LEFT JOIN ref_by_claim AS ref_ow
       ON ref_ow.FK_CLAIM = clm_ow.OBJECT_ID

LEFT JOIN comp
       ON comp.OBJECT_ID = bal.FK_BASE_COMPANY
LEFT JOIN brk
       ON brk.FK_INS_PERIOD = dtl.FK_INS_PER
      AND brk.rn = 1;
