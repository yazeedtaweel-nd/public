SELECT
    dtl.OBJECT_ID              AS DETAIL_OID,
    bal.OBJECT_ID              AS BALANCE_OID,
    bal.IS_OUTWARD,
    dtl.FK_ENTRY_CODE,
    dtl.FK_INS_PER,
    dtl.FK_INS_PER_ASSUMED,

    bal.FK_CLAIM               AS BAL_SOC_CLAIM_OID,
    scr.FK_CLAIM               AS BAL_CLAIM_OID,
    c_bal.CLAIM_IDENTIFIER     AS BAL_CLAIM_IDENTIFIER,

    dtl.FK_CLAIM_TO_SOC        AS DTL_LINKED_CLAIM_OID,
    c_dtl.CLAIM_IDENTIFIER     AS DTL_CLAIM_IDENTIFIER,

    dtl.FK_HEADLINE_LOSS       AS HEADLINE_LOSS_OID,
    hl.CLAIM_IDENTIFIER        AS HEADLINE_IDENTIFIER,

    dtl.FK_WORKSHEET,
    bal.FK_WORKSHEET
FROM SICS.AC_LEDGER_DETAIL dtl
JOIN SICS.AC_LEDGER_BALANCE bal
  ON bal.OBJECT_ID = dtl.FK_BALANCE
LEFT JOIN SICS.SOC_TO_CLAIM_REL scr
  ON scr.OBJECT_ID = bal.FK_CLAIM
LEFT JOIN SICS.CLAIMS c_bal
  ON c_bal.OBJECT_ID = scr.FK_CLAIM
LEFT JOIN SICS.CLAIMS c_dtl
  ON c_dtl.OBJECT_ID = dtl.FK_CLAIM_TO_SOC
LEFT JOIN SICS.CLAIMS hl
  ON hl.OBJECT_ID = dtl.FK_HEADLINE_LOSS
WHERE dtl.OBJECT_ID = '<affected detail OBJECT_ID>';
