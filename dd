/* ============================================================
   007_sics_dwh_value_map.sql — SICS-to-DWH value map

   Reusable lookup of confirmed SICS values to DWH values.
   Extracts read audit.VW_SICS_DWH_VALUE_MAP and keep their
   existing expression when no active row matches.

   Seed is the agreed crosswalk only:
     BUSINESS.SUBCLASS            → DIM_POLICY.POLICY_BUSINESS_INDICATOR
     REFERENCE_DATA.EXTERNAL_CODE → DIM_POLICY_CLASS (subclass 46)
     CLAIM_STATUS.FRK_STATUS      → DIM_CLAIM.CLA_STATUS

   Apply after 001 (audit schema). Re-runnable.
   ============================================================ */

SET NOCOUNT ON;
SET XACT_ABORT ON;
GO

IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'audit')
    THROW 50000, N'audit schema is missing. Apply the control DDL before this script.', 1;
GO

IF OBJECT_ID(N'audit.SICS_DWH_VALUE_MAP', N'U') IS NULL
BEGIN
    CREATE TABLE audit.SICS_DWH_VALUE_MAP
    (
        MAP_ID        INT            IDENTITY(1, 1) NOT NULL,
        SICS_TABLE    NVARCHAR(128)  NOT NULL,
        SICS_FIELD    NVARCHAR(128)  NOT NULL,
        SICS_CONTEXT  NVARCHAR(128)  NOT NULL
            CONSTRAINT DF_SICS_DWH_VALUE_MAP_CONTEXT DEFAULT (N''),
        SICS_VALUE    NVARCHAR(200)  NOT NULL,
        DWH_TABLE     NVARCHAR(128)  NOT NULL,
        DWH_FIELD     NVARCHAR(128)  NOT NULL,
        DWH_VALUE     NVARCHAR(200)  NOT NULL,
        IS_ACTIVE     BIT            NOT NULL
            CONSTRAINT DF_SICS_DWH_VALUE_MAP_IS_ACTIVE DEFAULT (1),
        NOTES         NVARCHAR(500)  NULL,

        CONSTRAINT PK_SICS_DWH_VALUE_MAP PRIMARY KEY CLUSTERED (MAP_ID),
        CONSTRAINT UQ_SICS_DWH_VALUE_MAP UNIQUE
            (SICS_TABLE, SICS_FIELD, SICS_CONTEXT, SICS_VALUE, DWH_TABLE, DWH_FIELD)
    );
END
GO

CREATE OR ALTER VIEW audit.VW_SICS_DWH_VALUE_MAP
AS
SELECT
    MAP_ID,
    SICS_TABLE,
    SICS_FIELD,
    SICS_CONTEXT,
    SICS_VALUE,
    DWH_TABLE,
    DWH_FIELD,
    DWH_VALUE,
    NOTES
FROM audit.SICS_DWH_VALUE_MAP
WHERE IS_ACTIVE = 1;
GO

DECLARE @Expected TABLE
(
    SICS_TABLE    NVARCHAR(128) NOT NULL,
    SICS_FIELD    NVARCHAR(128) NOT NULL,
    SICS_CONTEXT  NVARCHAR(128) NOT NULL,
    SICS_VALUE    NVARCHAR(200) NOT NULL,
    DWH_TABLE     NVARCHAR(128) NOT NULL,
    DWH_FIELD     NVARCHAR(128) NOT NULL,
    DWH_VALUE     NVARCHAR(200) NOT NULL,
    NOTES         NVARCHAR(500) NULL,
    PRIMARY KEY (SICS_TABLE, SICS_FIELD, SICS_CONTEXT, SICS_VALUE, DWH_TABLE, DWH_FIELD)
);

INSERT INTO @Expected
    (SICS_TABLE, SICS_FIELD, SICS_CONTEXT, SICS_VALUE, DWH_TABLE, DWH_FIELD, DWH_VALUE, NOTES)
VALUES
    (N'BUSINESS', N'SUBCLASS', N'', N'6',  N'DIM_POLICY', N'POLICY_BUSINESS_INDICATOR', N'I',
     N'Inward. BUSINESS.SUBCLASS = 6.'),
    (N'BUSINESS', N'SUBCLASS', N'', N'3',  N'DIM_POLICY', N'POLICY_BUSINESS_INDICATOR', N'O',
     N'Outward. BUSINESS.SUBCLASS = 3.'),
    (N'BUSINESS', N'SUBCLASS', N'', N'8',  N'DIM_POLICY', N'POLICY_BUSINESS_INDICATOR', N'O',
     N'Outward. BUSINESS.SUBCLASS = 8.'),
    (N'BUSINESS', N'SUBCLASS', N'', N'11', N'DIM_POLICY', N'POLICY_BUSINESS_INDICATOR', N'O',
     N'Outward. BUSINESS.SUBCLASS = 11.'),

    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'TP', N'DIM_POLICY_CLASS', N'PCLS_CLASS_CODE', N'11',
     N'Type of Business. Proportional Treaty.'),
    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'TN', N'DIM_POLICY_CLASS', N'PCLS_CLASS_CODE', N'12',
     N'Type of Business. Non-proportional Treaty.'),
    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'FP', N'DIM_POLICY_CLASS', N'PCLS_CLASS_CODE', N'21',
     N'Type of Business. Proportional Facultative.'),
    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'FN', N'DIM_POLICY_CLASS', N'PCLS_CLASS_CODE', N'22',
     N'Type of Business. Non-proportional Facultative.'),

    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'TP', N'DIM_POLICY_CLASS', N'PCLS_REIN_IND', N'T',
     N'Treaty.'),
    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'TN', N'DIM_POLICY_CLASS', N'PCLS_REIN_IND', N'T',
     N'Treaty.'),
    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'FP', N'DIM_POLICY_CLASS', N'PCLS_REIN_IND', N'F',
     N'Facultative.'),
    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'FN', N'DIM_POLICY_CLASS', N'PCLS_REIN_IND', N'F',
     N'Facultative.'),

    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'TP', N'DIM_POLICY_CLASS', N'PCLS_PROP_IND', N'P',
     N'Proportional.'),
    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'FP', N'DIM_POLICY_CLASS', N'PCLS_PROP_IND', N'P',
     N'Proportional.'),
    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'TN', N'DIM_POLICY_CLASS', N'PCLS_PROP_IND', N'N',
     N'Non-proportional.'),
    (N'REFERENCE_DATA', N'EXTERNAL_CODE', N'SUBCLASS=46', N'FN', N'DIM_POLICY_CLASS', N'PCLS_PROP_IND', N'N',
     N'Non-proportional.'),

    (N'CLAIM_STATUS', N'FRK_STATUS', N'', N'O', N'DIM_CLAIM', N'CLA_STATUS', N'OP',
     N'Current claim status code O translates to DW OP.');

BEGIN TRANSACTION;

MERGE audit.SICS_DWH_VALUE_MAP AS t
USING @Expected AS s
   ON t.SICS_TABLE   = s.SICS_TABLE
  AND t.SICS_FIELD   = s.SICS_FIELD
  AND t.SICS_CONTEXT = s.SICS_CONTEXT
  AND t.SICS_VALUE   = s.SICS_VALUE
  AND t.DWH_TABLE    = s.DWH_TABLE
  AND t.DWH_FIELD    = s.DWH_FIELD
WHEN MATCHED THEN
    UPDATE SET
        DWH_VALUE = s.DWH_VALUE,
        IS_ACTIVE = 1,
        NOTES     = s.NOTES
WHEN NOT MATCHED THEN
    INSERT (SICS_TABLE, SICS_FIELD, SICS_CONTEXT, SICS_VALUE, DWH_TABLE, DWH_FIELD, DWH_VALUE, IS_ACTIVE, NOTES)
    VALUES (s.SICS_TABLE, s.SICS_FIELD, s.SICS_CONTEXT, s.SICS_VALUE, s.DWH_TABLE, s.DWH_FIELD, s.DWH_VALUE, 1, s.NOTES);

IF EXISTS (
    SELECT SICS_TABLE, SICS_FIELD, SICS_CONTEXT, SICS_VALUE, DWH_TABLE, DWH_FIELD, DWH_VALUE
    FROM @Expected
    EXCEPT
    SELECT SICS_TABLE, SICS_FIELD, SICS_CONTEXT, SICS_VALUE, DWH_TABLE, DWH_FIELD, DWH_VALUE
    FROM audit.SICS_DWH_VALUE_MAP
    WHERE IS_ACTIVE = 1
)
OR EXISTS (
    SELECT SICS_TABLE, SICS_FIELD, SICS_CONTEXT, SICS_VALUE, DWH_TABLE, DWH_FIELD, DWH_VALUE
    FROM audit.SICS_DWH_VALUE_MAP
    WHERE IS_ACTIVE = 1
    EXCEPT
    SELECT SICS_TABLE, SICS_FIELD, SICS_CONTEXT, SICS_VALUE, DWH_TABLE, DWH_FIELD, DWH_VALUE
    FROM @Expected
)
BEGIN
    ROLLBACK TRANSACTION;
    THROW 50001, N'audit.SICS_DWH_VALUE_MAP does not match the agreed SICS-to-DWH crosswalk.', 1;
END;

COMMIT TRANSACTION;
GO
