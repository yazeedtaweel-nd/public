SELECT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK,
    CAST(LTRIM(RTRIM(p.IDENTIFIER)) AS nvarchar(20)) AS BROKER_BK
FROM SICS.BUSINESS_PRTNR_REL r
JOIN SICS.INSURED_PERIOD ip
      ON ip.OBJECT_ID = r.FK_INS_PERIOD
JOIN SICS.BUSINESS b
      ON b.OBJECT_ID = ip.FK_BUSINESS
JOIN SICS.PARTY p
      ON p.OBJECT_ID = r.FK_BUS_PARTNER
WHERE r.FSK_RELSHIP_TYPE = 55
  AND r.FRK_RELSHIP_TYPE = 'BR'
  AND r.SUBCLASS = 10
  AND b.SUBCLASS IN (3, 8, 11)
  AND COALESCE(
        NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
        NULLIF(LTRIM(RTRIM(ip.BUS_INS_PER_ID)), N'')
      ) IS NOT NULL;
