SELECT
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(ip.I_PERIOD_FORMER_ID)), N''),
            LTRIM(RTRIM(ip.BUS_INS_PER_ID))
        ) AS nvarchar(50)
    ) AS POLICY_BK,
    CASE
        WHEN b.SUBCLASS = 6 THEN N'I'
        WHEN b.SUBCLASS IN (3, 8, 11) THEN N'O'
    END AS POLICY_BUSINESS_INDICATOR,
    b.IDENTIFIER AS POLICY_CONTRACT_NUMBER,
    ac.FRK_REFIM22 AS TOP_METHOD_BK,      -- Accounting Classification - Method
    rd_m.NAME AS TOP_METHOD_NAME,
    ac.FRK_REFIC22 AS TOP_COVERAGE_BK,    -- Accounting Classification - Coverage
    rd_c.NAME AS TOP_COVERAGE_NAME,
    ppp.FRK_TYPE_OF_PART AS TOP_OW_PROG_BK,
    rd_p.NAME AS TOP_OW_PROG_NAME
FROM SICS.BUS_STRUCT_REP AS bsr
INNER JOIN SICS.BUSINESS AS b
    ON b.OBJECT_ID = bsr.FK_BUSINESS
INNER JOIN SICS.INSURED_PERIOD AS ip
    ON ip.OBJECT_ID = bsr.FK_INS_PERIOD
LEFT JOIN SICS.ACC_CLASSIFIC AS ac
    ON ac.FK_BUS = b.OBJECT_ID
LEFT JOIN SICS.REFERENCE_DATA AS rd_m
    ON rd_m.CODE = ac.FRK_REFIM22 AND rd_m.SUBCLASS = 22
LEFT JOIN SICS.REFERENCE_DATA AS rd_c
    ON rd_c.CODE = ac.FRK_REFIC22 AND rd_c.SUBCLASS = 22
LEFT JOIN SICS.PROTECT_PROG_PART AS ppp
    ON ppp.FK_IP_OCC = ip.OBJECT_ID
LEFT JOIN SICS.REFERENCE_DATA AS rd_p
    ON rd_p.CODE = ppp.FRK_TYPE_OF_PART AND rd_p.SUBCLASS = 22
WHERE b.SUBCLASS IN (6, 3, 8, 11)
  AND bsr.IS_CURRENT_LCP = N'Y'
  AND bsr.IS_CURRENT_AM = N'Y'
ORDER BY POLICY_BUSINESS_INDICATOR, POLICY_BK;
