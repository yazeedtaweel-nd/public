DECLARE @WrksBk varchar(50) = '20090401|16';
-- add to the existing WHERE
AND (
        ws.EXTERNAL_ID = 'TW|' + @WrksBk
     OR (
            (ws.EXTERNAL_ID IS NULL OR ws.EXTERNAL_ID NOT LIKE 'TW|%')
        AND CONVERT(varchar(8), ws.BOOKING_DATE, 112)
            + '|' + CONVERT(varchar(20), ws.ID_SERIE_NO) = @WrksBk
        )
    )
